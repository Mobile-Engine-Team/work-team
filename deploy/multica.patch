index 000000000..132b49c5a
--- /dev/null
+++ b/server/pkg/agent/planning.go
@@ -0,0 +1,149 @@
+package agent
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+// RunReadOnlyPlanning deliberately bypasses normal business-agent setup: no
+// CLI credentials, MCP, tools, extensions, skills, or workspace context. The
+// model receives only the caller-selected snapshot on stdin. It is not a host
+// sandbox and does not accept executable configuration from the project.
+func RunReadOnlyPlanning(ctx context.Context, executable, model, prompt, credentialDir, scratchRoot string) (string, error) {
+	if executable == "" {
+		return "", fmt.Errorf("Pi 执行程序不可用")
+	}
+	dir, err := os.MkdirTemp(scratchRoot, "planning-")
+	if err != nil {
+		return "", err
+	}
+	defer os.RemoveAll(dir)
+	config := filepath.Join(dir, "agent")
+	if err = os.MkdirAll(config, 0700); err != nil {
+		return "", err
+	}
+	for _, name := range []string{"auth.json", "models.json"} {
+		raw, e := os.ReadFile(filepath.Join(credentialDir, name))
+		if os.IsNotExist(e) {
+			continue
+		}
+		if e != nil {
+			return "", e
+		}
+		var v any
+		if e = json.Unmarshal(raw, &v); e != nil {
+			return "", fmt.Errorf("模型配置无效")
+		}
+		if containsExecutableConfig(v) {
+			return "", fmt.Errorf("规划模式不支持通过命令解析模型凭据，请使用静态凭据或 OAuth")
+		}
+		if e = os.WriteFile(filepath.Join(config, name), raw, 0600); e != nil {
+			return "", e
+		}
+	}
+	args := []string{"-p", "--mode", "json", "--no-session", "--no-tools", "--no-extensions", "--no-skills", "--no-prompt-templates", "--no-themes", "--no-context-files"}
+	if model != "" {
+		args = append(args, "--model", model)
+	}
+	cmd := exec.CommandContext(ctx, executable, args...)
+	cmd.Dir = dir
+	cmd.Stdin = strings.NewReader(prompt)
+	cmd.Env = []string{"HOME=" + dir, "PI_CODING_AGENT_DIR=" + config, "PATH=" + os.Getenv("PATH")}
+	for _, key := range []string{"HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY", "NO_PROXY", "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS", "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "GEMINI_API_KEY", "GOOGLE_API_KEY", "OPENROUTER_API_KEY", "MISTRAL_API_KEY", "GROQ_API_KEY", "XAI_API_KEY"} {
+		if value, ok := os.LookupEnv(key); ok {
+			cmd.Env = append(cmd.Env, key+"="+value)
+		}
+	}
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return "", err
+	}
+	if err = cmd.Start(); err != nil {
+		return "", err
+	}
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 64*1024), 2<<20)
+	var output string
+	var protocolErr error
+	for scanner.Scan() {
+		var event struct {
+			Type    string `json:"type"`
+			Message struct {
+				Role         string `json:"role"`
+				StopReason   string `json:"stopReason"`
+				ErrorMessage string `json:"errorMessage"`
+				Content      []struct {
+					Type string `json:"type"`
+					Text string `json:"text"`
+				} `json:"content"`
+			} `json:"message"`
+		}
+		if json.Unmarshal(scanner.Bytes(), &event) != nil {
+			continue
+		}
+		if event.Type == "tool_execution_start" {
+			protocolErr = fmt.Errorf("规划执行端违反无工具协议")
+			cmd.Process.Kill()
+			break
+		}
+		if event.Type == "message_end" && event.Message.Role == "assistant" {
+			var b strings.Builder
+			for _, part := range event.Message.Content {
+				if part.Type == "text" {
+					b.WriteString(part.Text)
+				} else if part.Type == "toolCall" {
+					protocolErr = fmt.Errorf("规划结果包含工具调用")
+				}
+			}
+			if event.Message.StopReason == "error" {
+				protocolErr = fmt.Errorf("模型调用失败：%s", event.Message.ErrorMessage)
+			}
+			output = b.String()
+		}
+	}
+	waitErr := cmd.Wait()
+	if protocolErr != nil {
+		return "", protocolErr
+	}
+	if scanner.Err() != nil {
+		return "", scanner.Err()
+	}
+	if ctx.Err() != nil {
+		return "", ctx.Err()
+	}
+	if waitErr != nil {
+		return "", fmt.Errorf("规划执行失败（%v）：%s", waitErr, strings.TrimSpace(stderr.String()))
+	}
+	if strings.TrimSpace(output) == "" {
+		return "", fmt.Errorf("规划未返回最终文本")
+	}
+	return output, nil
+}
+func containsExecutableConfig(v any) bool {
+	switch x := v.(type) {
+	case string:
+		return strings.HasPrefix(strings.TrimSpace(x), "!")
+	case []any:
+		for _, v := range x {
+			if containsExecutableConfig(v) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, v := range x {
+			if containsExecutableConfig(v) {
+				return true
+			}
+		}
+	}
+	return false
+}
