+	close(codes)
+	counts := map[int]int{}
+	for code := range codes {
+		counts[code]++
+	}
+	if counts[201] != 1 || counts[409] != 1 {
+		t.Fatalf("concurrent creates: %v", counts)
+	}
+	var owner string
+	if err := testPool.QueryRow(context.Background(), "SELECT assignee_id::text FROM issue WHERE id=$1", issue).Scan(&owner); err != nil || owner != old {
