diff --git a/server/cmd/multica/cmd_daemon_connect.go b/server/cmd/multica/cmd_daemon_connect.go
new file mode 100644
index 000000000..e8be4399e
--- /dev/null
+++ b/server/cmd/multica/cmd_daemon_connect.go
@@ -0,0 +1,126 @@
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/multica-ai/multica/server/internal/cli"
+	"github.com/spf13/cobra"
+)
+
+// Credentials arrive on stdin, never in shell arguments or command history.
+type remoteConnectInput struct {
+	ServerURL string `json:"server_url"`
+	Token     string `json:"token"`
+	UserID    string `json:"user_id"`
+}
+
+func init() {
+	daemonCmd.AddCommand(&cobra.Command{Use: "connect", Hidden: true, Args: cobra.NoArgs, RunE: runDaemonConnect})
+}
+
+func validateRemoteConnect(input remoteConnectInput) error {
+	u, err := url.Parse(input.ServerURL)
+	if err != nil || u.Host == "" || (u.Scheme != "https" && u.Scheme != "http") || u.User != nil || u.RawQuery != "" || u.Fragment != "" || (u.Path != "" && u.Path != "/") {
+		return errors.New("invalid collaboration server address")
+	}
+	if _, err := uuid.Parse(input.UserID); err != nil || input.Token == "" {
+		return errors.New("missing member identity")
+	}
+	return nil
+}
+
+func runDaemonConnect(cmd *cobra.Command, _ []string) error {
+	if err := requireHumanLocalCommand("daemon connect"); err != nil {
+		return err
+	}
+	var input remoteConnectInput
+	if err := json.NewDecoder(io.LimitReader(cmd.InOrStdin(), 32768)).Decode(&input); err != nil {
+		return errors.New("invalid connection input")
+	}
+	if err := validateRemoteConnect(input); err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(cmd.Context(), 70*time.Second)
+	defer cancel()
+	var me struct {
+		ID string `json:"id"`
+	}
+	client := cli.NewAPIClient(input.ServerURL, "", input.Token)
+	if err := client.GetJSON(ctx, "/api/me", &me); err != nil || me.ID != input.UserID {
+		return errors.New("collaboration server rejected member identity")
+	}
+	profile := fmt.Sprintf("mw-remote-%x", sha256.Sum256([]byte(input.ServerURL+"\x00"+input.UserID)))[:34]
+	dir, err := cli.ProfileDir(profile)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return err
+	}
+	// This file is deliberately distinct from legacy daemon.id migration input.
+	identityPath := filepath.Join(dir, "mw-remote-identity")
+	identity, err := os.ReadFile(identityPath)
+	if errors.Is(err, os.ErrNotExist) {
+		identity = []byte(uuid.NewString())
+		err = os.WriteFile(identityPath, identity, 0600)
+	}
+	if err != nil {
+		return err
+	}
+	if _, err := uuid.Parse(string(identity)); err != nil {
+		return errors.New("invalid saved remote identity")
+	}
+	cfg, err := cli.LoadCLIConfigForProfile(profile)
+	if err != nil {
+		return err
+	}
+	if cfg.ServerURL != "" && cfg.ServerURL != input.ServerURL {
+		return errors.New("remote profile belongs to another server")
+	}
+	cfg.ServerURL, cfg.Token = input.ServerURL, input.Token
+	if cfg.WorkspacesRoot == "" {
+		cfg.WorkspacesRoot = filepath.Join(dir, "workspaces")
+	}
+	if cfg.MaxConcurrentTasks == 0 {
+		cfg.MaxConcurrentTasks = 1
+	}
+	if err := cli.SaveCLIConfigForProfile(cfg, profile); err != nil {
+		return err
+	}
+	healthCtx, healthCancel := context.WithTimeout(ctx, 2*time.Second)
+	health := checkDaemonHealthOnPort(healthCtx, resolveHealthPort(profile))
+	healthCancel()
+	if daemonAlive(health) && daemonIdentityMismatch(health, profile, resolveHealthPort(profile)) == nil {
+		if health["daemon_id"] != string(identity) {
+			return errors.New("remote endpoint identity mismatch")
+		}
+	} else {
+		exe, err := daemonExecutable()
+		if err != nil {
+			return err
+		}
+		child := exec.CommandContext(ctx, exe, "daemon", "start", "--profile", profile, "--daemon-id", string(identity), "--no-auto-update", "--no-auto-reload")
+		// Startup diagnostics remain on the host; no credential-bearing child output crosses SSH.
+		if err := child.Run(); err != nil {
+			return errors.New("remote endpoint failed to start; check its host log")
+		}
+	}
+	healthCtx, healthCancel = context.WithTimeout(ctx, 2*time.Second)
+	defer healthCancel()
+	health = checkDaemonHealthOnPort(healthCtx, resolveHealthPort(profile))
+	if health["status"] != "running" || health["daemon_id"] != string(identity) {
+		return errors.New("remote endpoint is not ready")
+	}
+	return json.NewEncoder(cmd.OutOrStdout()).Encode(map[string]any{"ok": true, "state": "running", "daemonId": string(identity), "profile": profile})
+}
diff --git a/server/cmd/multica/cmd_daemon_connect_test.go b/server/cmd/multica/cmd_daemon_connect_test.go
