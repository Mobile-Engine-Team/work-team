+func (h *Handler) ProjectTopics(w http.ResponseWriter, r *http.Request) {
+	p, m, ok := h.projectAccess(w, r, r.Method != "GET", false)
+	if !ok {
+		return
+	}
+	if r.Method == "GET" {
+		rows, err := h.DB.Query(r.Context(), `SELECT id::text,title,status,conclusion,issue_ids,created_by::text,created_at,COALESCE(discussion_issue_id::text,''),conclusion_revision,conclusion_draft,draft_revision,COALESCE((SELECT message_cutoff::text FROM project_topic_conclusion c WHERE c.topic_id=project_topic.id AND c.revision=project_topic.conclusion_revision),''),COALESCE((SELECT confirmed_at::text FROM project_topic_conclusion c WHERE c.topic_id=project_topic.id AND c.revision=project_topic.conclusion_revision),'') FROM project_topic WHERE project_id=$1 AND workspace_id=$2 ORDER BY updated_at DESC`, p.ID, p.WorkspaceID)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		defer rows.Close()
+		topics := []projectTopic{}
+		for rows.Next() {
+			var t projectTopic
+			if err = rows.Scan(&t.ID, &t.Title, &t.Status, &t.Conclusion, &t.IssueIDs, &t.CreatedBy, &t.CreatedAt, &t.DiscussionIssueID, &t.ConclusionRevision, &t.ConclusionDraft, &t.DraftRevision, &t.ConclusionCutoff, &t.ConclusionConfirmedAt); err != nil {
+				planWriteError(w, err)
+				return
+			}
+			topics = append(topics, t)
+		}
+		if err = rows.Err(); err != nil {
+			planWriteError(w, err)
+			return
+		}
+		writeJSON(w, 200, map[string]any{"topics": topics})
+		return
+	}
+	var req struct {
+		Title     string   `json:"title"`
+		Content   string   `json:"content"`
+		IssueIDs  []string `json:"issue_ids"`
+		RequestID string   `json:"request_id"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	if strings.TrimSpace(req.Title) == "" || len(req.Title) > 500 || len(req.Content) > 30000 || len(req.IssueIDs) > 100 {
+		writeError(w, 422, "请填写有效话题标题和内容")
+		return
+	}
+	ids := []pgtype.UUID{}
+	for _, id := range req.IssueIDs {
+		uid, ok := parseUUIDOrBadRequest(w, id, "issue_id")
+		if !ok {
+			return
+		}
+		i, e := h.Queries.GetIssueInWorkspace(r.Context(), db.GetIssueInWorkspaceParams{ID: uid, WorkspaceID: p.WorkspaceID})
+		if e != nil || (i.ProjectID.Valid && i.ProjectID != p.ID) {
+			writeError(w, 422, "引用任务不可见或属于其他项目")
+			return
+		}
+		ids = append(ids, uid)
+	}
+	// The client-generated topic UUID makes retrying a timed-out create safe.
+	id, ok := parseUUIDOrBadRequest(w, req.RequestID, "request_id")
+	if !ok {
+		return
+	}
+	tx, err := h.TxStarter.Begin(r.Context())
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	defer tx.Rollback(r.Context())
+	insertedTopic, err := tx.Exec(r.Context(), `INSERT INTO project_topic(id,project_id,workspace_id,title,issue_ids,created_by) VALUES($1,$2,$3,$4,$5,$6) ON CONFLICT(id) DO NOTHING`, id, p.ID, p.WorkspaceID, req.Title, ids, m.UserID)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	var authorized bool
+	if err = tx.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM project_topic WHERE id=$1 AND project_id=$2 AND created_by=$3)`, id, p.ID, m.UserID).Scan(&authorized); err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if !authorized {
+		writeError(w, 409, "话题请求标识已使用")
+		return
+	}
+	var carrier pgtype.UUID
+	if insertedTopic.RowsAffected() > 0 {
+		result, e := h.IssueService.CreateInTransaction(r.Context(), tx, service.IssueCreateParams{WorkspaceID: p.WorkspaceID, Title: req.Title, Description: pgtype.Text{String: "仅讨论本话题及本话题明确提供的材料。回复当前评论；不得启动关联业务任务。", Valid: true}, Status: "todo", Priority: "none", CreatorType: "member", CreatorID: m.UserID, AssigneeType: pgtype.Text{String: "member", Valid: true}, AssigneeID: m.UserID, AllowDuplicate: true})
+		if e != nil {
+			planWriteError(w, e)
+			return
+		}
+		carrier = result.Issue.ID
+		_, e = tx.Exec(r.Context(), `UPDATE issue SET metadata=jsonb_build_object('project_topic_id',$2::text,'topic_project_id',$3::text) WHERE id=$1`, carrier, id, p.ID)
+		if e == nil {
+			_, e = tx.Exec(r.Context(), `UPDATE project_topic SET discussion_issue_id=$2 WHERE id=$1`, id, carrier)
+		}
+		if e != nil {
+			planWriteError(w, e)
+			return
+		}
+	} else {
+		if e := tx.QueryRow(r.Context(), `SELECT discussion_issue_id FROM project_topic WHERE id=$1`, id).Scan(&carrier); e != nil {
+			planWriteError(w, e)
+			return
+		}
+	}
+	if strings.TrimSpace(req.Content) != "" {
+		inserted, e := tx.Exec(r.Context(), `INSERT INTO comment(id,issue_id,workspace_id,content,author_type,author_id,type) VALUES($1,$2,$3,$4,'member',$5,'comment') ON CONFLICT(id) DO NOTHING`, id, carrier, p.WorkspaceID, req.Content, m.UserID)
+		err = e
+		if err == nil && inserted.RowsAffected() > 0 {
+			err = h.projectTopicMentions(r.Context(), tx, p, id, m.UserID, req.Content)
+		}
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+	}
+	if err = tx.Commit(r.Context()); err != nil {
+		planWriteError(w, err)
+		return
+	}
+	h.projectChanged(r, p)
+	writeJSON(w, 200, map[string]string{"id": req.RequestID})
+}
+func (h *Handler) ProjectTopicMessages(w http.ResponseWriter, r *http.Request) {
+	p, m, ok := h.projectAccess(w, r, r.Method != "GET", false)
+	if !ok {
+		return
+	}
+	id, ok := parseUUIDOrBadRequest(w, chi.URLParam(r, "topicId"), "topic_id")
+	if !ok {
+		return
+	}
+	var author, carrier pgtype.UUID
+	if err := h.DB.QueryRow(r.Context(), `SELECT created_by,discussion_issue_id FROM project_topic WHERE id=$1 AND project_id=$2 AND workspace_id=$3`, id, p.ID, p.WorkspaceID).Scan(&author, &carrier); err != nil {
+		writeError(w, 404, "话题不存在")
+		return
+	}
+	if r.Method == "GET" {
+		rows, err := h.DB.Query(r.Context(), `SELECT id::text,content,author_id::text,created_at FROM comment WHERE issue_id=$1 AND workspace_id=$2 AND deleted_at IS NULL ORDER BY created_at,id`, carrier, p.WorkspaceID)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		defer rows.Close()
+		messages := []projectMessage{}
+		for rows.Next() {
+			var msg projectMessage
+			if err = rows.Scan(&msg.ID, &msg.Content, &msg.CreatedBy, &msg.CreatedAt); err != nil {
+				planWriteError(w, err)
+				return
+			}
+			messages = append(messages, msg)
+		}
+		if err = rows.Err(); err != nil {
+			planWriteError(w, err)
+			return
+		}
+		writeJSON(w, 200, map[string]any{"messages": messages})
+		return
+	}
+	var req struct {
+		Content               string  `json:"content"`
+		RequestID             string  `json:"request_id"`
+		Status                string  `json:"status"`
+		Conclusion            *string `json:"conclusion"`
+		ExpectedRevision      *int    `json:"expected_revision"`
+		Draft                 *string `json:"draft"`
+		ExpectedDraftRevision *int    `json:"expected_draft_revision"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	if r.Method == "PATCH" {
+		h.updateTopicConclusion(w, r, p, m.UserID, m.Role, id, author, req.Status, req.Conclusion, req.ExpectedRevision, req.Draft, req.ExpectedDraftRevision)
+		return
+	} else {
+		raw, _ := json.Marshal(map[string]any{"content": req.Content, "request_id": req.RequestID})
+		rr := r.Clone(r.Context())
+		rr.Body = io.NopCloser(bytes.NewReader(raw))
+		chi.RouteContext(rr.Context()).URLParams.Add("id", uuidToString(carrier))
+		h.CreateComment(w, rr)
+		return
+	}
+	h.projectChanged(r, p)
+	writeJSON(w, 200, map[string]bool{"ok": true})
+}
