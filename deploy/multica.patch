new file mode 100644
index 000000000..03e8962cb
--- /dev/null
+++ b/server/internal/workbench/dynamic_wording.go
@@ -0,0 +1,42 @@
+package workbench
+
+import (
+	"fmt"
+	"strings"
+)
+
+// This narrow guard catches categorical acceptance outcomes that the supplied
+// evidence never states. It is deliberately not a general prose truth checker.
+func checkAcceptanceWording(cl Claim, read map[string]Evidence) error {
+	outcomes := []string{"尚未验收", "未经验收", "已经验收", "已通过验收", "验收未发生", "验收尚未发生"}
+	for _, sentence := range strings.FieldsFunc(cl.Text, func(r rune) bool { return r == '。' || r == '；' || r == '\n' }) {
+		for _, outcome := range outcomes {
+			position := strings.Index(sentence, outcome)
+			if position < 0 {
+				continue
+			}
+			prefix := sentence[:position]
+			qualified := false
+			for _, qualifier := range []string{"不能", "无法", "不等于", "不代表", "不意味着", "不足以", "未见", "不应", "不是", "不构成", "而非"} {
+				if strings.Contains(prefix, qualifier) {
+					qualified = true
+					break
+				}
+			}
+			if qualified {
+				continue
+			}
+			supported := false
+			for _, id := range cl.EvidenceIDs {
+				if strings.Contains(read[id].Text, outcome) {
+					supported = true
+					break
+				}
+			}
+			if !supported {
+				return fmt.Errorf("claim %s has unsupported categorical acceptance outcome %q; distinguish no record from real-world occurrence, replace with what the evidence can confirm", cl.ID, outcome)
+			}
+		}
+	}
+	return nil
+}
