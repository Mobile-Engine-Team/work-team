@@ -0,0 +1,29 @@
+package workbench
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// Opt-in local development evidence only. No prompts, credentials or transport
+// headers are recorded. The first rejected event per attempt is size bounded.
+func recordRejectedEvent(run string, attempt int, line string, reason error) {
+	dir := os.Getenv("MULTICA_WORKBENCH_DIAGNOSTICS_DIR")
+	if dir == "" || len(line) > 65536 {
+		return
+	}
+	if filepath.Base(run) != run {
+		return
+	}
+	if os.MkdirAll(dir, 0700) != nil {
+		return
+	}
+	f, err := os.OpenFile(filepath.Join(dir, fmt.Sprintf("%s-%d.json", run, attempt)), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	_ = json.NewEncoder(f).Encode(map[string]any{"attempt": attempt, "event": line, "error": reason.Error()})
+}
diff --git a/server/internal/workbench/dynamic_generate.go b/server/internal/workbench/dynamic_generate.go
new file mode 100644
index 000000000..ff75a6c6e
--- /dev/null
+++ b/server/internal/workbench/dynamic_generate.go
@@ -0,0 +1,257 @@
+package workbench
+
+import (
+	"context"
+	_ "embed"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"time"
+)
+
+//go:embed dynamic_prompt.txt
+var dynamicPrompt string
+
+func GenerateDynamic(ctx context.Context, pi *Pi, c Corpus, id, model, user, prompt, history string, progress func(string), check func() error, publish func(Result) error, previous ...*Result) (Result, error) {
+	start := time.Now()
+	d := NewDynamic()
+	result := Result{View: View{SchemaVersion: 2, Blocks: []Block{}, Queries: []Query{}, Limitations: []string{}, Semantic: true}, Dynamic: d, Evidence: []Evidence{}, Fingerprint: c.Fingerprint, GeneratedAt: c.At, Model: "", RequestedModel: model, Provider: "workbench", Runtime: "pi@0.84.2"}
+	read := map[string]Evidence{}
+	priorDatasetCount := 0
+	var buffer, attemptText, protocolError string
+	total := 0
+	tools := 0
+	seq := 0
+	attempt := 0
+	update := func() error {
+		if err := check(); err != nil {
+			return err
+		}
+		result.Evidence = SortedEvidence(read)
+		if d.Plan != nil {
+			result.View.Title = d.Plan.Title
+			result.View.Intent = d.Plan.Intent
+			result.View.TimeSensitive = d.Plan.TimeSensitive
+		}
+		result.View.Limitations = d.Limitations
+		result.Fingerprint = c.ViewFingerprint(result.View)
+		seq++
+		d.Seq = seq
+		result.ElapsedMS = time.Since(start).Milliseconds()
+		return publish(result)
+	}
+	consume := func(line string) error {
+		if protocolError != "" {
+			// Independent sections remain atomic and can still be checked after a
+			// rejected section. Never finalize or replace a plan in this state.
+			var header struct {
+				Type string `json:"type"`
+			}
+			if d.Plan == nil || json.Unmarshal([]byte(line), &header) != nil || header.Type != "section" {
+				return nil
+			}
+		}
+		if err := d.applyGeneratedA2UI(line, read); err != nil {
+			recordRejectedEvent(id, attempt, line, err)
+			if len(protocolError) < 8000 {
+				if protocolError != "" {
+					protocolError += "\n"
+				}
+				var event struct {
+					Section struct {
+						ID string `json:"id"`
+					} `json:"section"`
+				}
+				_ = json.Unmarshal([]byte(line), &event)
+				if event.Section.ID != "" {
+					protocolError += "section=" + event.Section.ID + ": "
+				}
+				protocolError += err.Error()
+			}
+			return nil
+		}
+		progress("正在呈现回答")
+		return update()
+	}
+	inputJSON, _ := json.Marshal(map[string]any{"question": prompt, "history": history, "catalog": c.Catalog()})
+	input := string(inputJSON)
+	err := pi.Run(ctx, id, model, dynamicPrompt+"\n组件属性契约（只允许这些组件；$ref是A2UI标准动态值/ChildList）：\n"+string(answerCatalogJSON), input, func(e PiEvent) (any, error) {
+		if err := check(); err != nil {
+			return nil, err
+		}
+		switch e.Type {
+		case "actual_model":
+			result.Model = e.Model
+		case "request":
+			result.Calls = e.Calls
+			progress("正在思考和组织回答")
+		case "attempt":
+			attempt = e.AttemptID
+			d.AttemptID = attempt
+			buffer = ""
+			attemptText = ""
+			protocolError = ""
+		case "tool_request":
+			tools++
+			if tools > 16 {
+				return nil, fmt.Errorf("检索预算已用完")
+			}
+			if d.Plan != nil {
+				return nil, fmt.Errorf("开始回答后不能混入工具查询")
+			}
+			result.RetrievalMS = time.Since(start).Milliseconds()
+			progress("正在读取 " + e.Query.Source)
+			page, err := c.Search(e.Query)
+			if err != nil {
+				return map[string]any{"error": "invalid_query"}, nil
+			}
+			raw, _ := json.Marshal(page)
+			if len(raw) > 120000 {
+				return nil, fmt.Errorf("依据超过预算，请缩小范围")
+			}
+			for _, v := range page.Records {
+				read[v.ID] = v
+			}
+			datasetNumber := tools + priorDatasetCount
+			for {
+				if _, exists := d.Datasets[fmt.Sprintf("d%d", datasetNumber)]; !exists {
+					break
+				}
+				datasetNumber++
+			}
+			ds := MakeDataset(fmt.Sprintf("d%d", datasetNumber), e.Query, page)
+			for key, existing := range d.Datasets {
+				oldQ, newQ := existing.Query, e.Query
+				oldQ.Offset = 0
+				newQ.Offset = 0
+				oldQ.Limit = 0
+				newQ.Limit = 0
+				if oldQ == newQ && existing.NextOffset != nil && *existing.NextOffset == e.Query.Offset {
+					ds.ID = key
+					ds.Rows = append(existing.Rows, ds.Rows...)
+					ds.Query = existing.Query
+					ds.Complete = existing.Query.Offset == 0 && page.Complete
+					break
+				}
+			}
+			if len(ds.Rows) > 1000 {
+				return nil, fmt.Errorf("候选数据超过单次回答预算，请缩小范围")
+			}
+			d.Datasets[ds.ID] = ds
+			result.View.Queries = append(result.View.Queries, e.Query)
+			return map[string]any{"datasetId": ds.ID, "dataset": ds, "page": page}, nil
+		case "text_delta":
+			if result.FirstTokenMS == 0 {
+				result.FirstTokenMS = time.Since(start).Milliseconds()
+			}
+			total += len(e.Text)
+			if total > 262144 {
+				return nil, fmt.Errorf("回答超过总输出预算")
+			}
+			attemptText += e.Text
+			buffer += e.Text
+			if len(buffer) > 65536 {
+				protocolError = "单行超过64KiB"
+				buffer = ""
+			}
+			for {
+				index := strings.IndexByte(buffer, '\n')
+				if index < 0 {
+					break
+				}
+				line := strings.TrimSpace(buffer[:index])
+				buffer = buffer[index+1:]
+				if line == "" {
+					continue
+				}
+				if err := consume(line); err != nil {
+					return nil, err
+				}
+			}
+		case "message_end":
+			result.InputTokens += e.Usage.Input
+			result.OutputTokens += e.Usage.Output
+
+			if e.StopReason == "toolUse" {
+				buffer = ""
+				protocolError = ""
+				return nil, nil
+			}
+			if e.Text != attemptText {
+				return nil, fmt.Errorf("流式内容对账失败")
+			}
+			if strings.TrimSpace(buffer) != "" {
+				if err := consume(strings.TrimSpace(buffer)); err != nil {
+					return nil, err
+				}
+			}
+			buffer = ""
+			if !d.Complete || protocolError != "" {
+				recordRejectedEvent(id+"-complete", attempt, attemptText, fmt.Errorf("incomplete=%t; %s", !d.Complete, protocolError))
+			}
+		case "validate":
+			if d.Complete && protocolError == "" {
+				return map[string]any{}, nil
+			}
+			progress("正在修复回答格式")
+			missing := []string{}
+			keptSections := []string{}
+			if d.Plan == nil {
+				missing = append(missing, "plan, every self-contained section, final")
+			} else {
+				for _, region := range d.Plan.Sections {
+					if _, ok := d.Sections[region.ID]; !ok {
+						missing = append(missing, "section for "+region.ID)
+					} else {
+						keptSections = append(keptSections, region.ID)
+					}
+				}
+				missing = append(missing, "final listing all plan section ids")
+			}
+			if protocolError == "" {
+				protocolError = "missing_required_events: " + strings.Join(missing, ", ")
+			}
+			result.ValidationErrors = append(result.ValidationErrors, protocolError)
+			state, _ := json.Marshal(map[string]any{"retainedPlan": d.Plan, "retainedSectionIds": keptSections, "requiredEventsInOrder": missing})
+			return map[string]any{"allowTools": d.Plan == nil && len(d.Datasets) == 0 && len(c.Records) > 0, "repair": "这是唯一一次修复。已获得dataset时禁止重复查询，直接使用已读记录修复协议、补齐plan/缺失section/final；只有尚未取得任何dataset时才可补查。缺乏依据的分析应删除或明确检索边界。只输出requiredEventsInOrder中的缺失事件；仅非空retainedPlan与retainedSectionIds列出的区域已经发布，不重复或修改；retainedPlan为null表示前轮所有区域都未接收，必须重新输出完整plan、全部section和final。每个section自足包含dataRefs/facts/surface，分析组件内嵌文字和依据；不要content事件、contentRefs、claim ID或reuseHash。未通过区域没有发布；后续通过校验的独立区域已保留。请一次修正下列全部错误，只补缺失区域，最后final。错误:" + protocolError + "；针对错误的修复方法:" + dynamicRepairAdvice(protocolError) + "；当前状态:" + string(state)}, nil
+		case "repair":
+			result.Repairs++
+			d.Complete = false
+		}
+		return nil, nil
+	})
+	result.ElapsedMS = time.Since(start).Milliseconds()
+	result.Evidence = SortedEvidence(read)
+	if err != nil {
+		return result, err
+	}
+	if !d.Complete || protocolError != "" {
+		if protocolError == "" {
+			protocolError = "missing_required_events: expected all planned sections and final"
+		}
+		if len(result.ValidationErrors) == 0 || result.ValidationErrors[len(result.ValidationErrors)-1] != protocolError {
+			result.ValidationErrors = append(result.ValidationErrors, protocolError)
+		}
+		return result, fmt.Errorf("回答仍有部分内容未完成或未通过核对，请重试或缩小问题范围")
+	}
+	return result, update()
+}
+
+// Keep repair guidance tied to the actual validation failure. The same strict
+// validators still run on the repaired section; guidance never supplies facts.
+func dynamicRepairAdvice(problem string) string {
+	hints := []string{}
+	if strings.Contains(problem, "claim needs evidence") {
+		hints = append(hints, `在报错组件补充实际已读取的 evidenceIds 或本区域 facts 的 factIds。若查询返回空记录，不能凭空补依据：改为 EmptyState，kind:"gap", gapType:"no_record", evidenceIds:[]，text 只说明“本次检索范围内未见相关记录”，不要断言工作区完全没有资料。普通知识用 Prose；业务判断不可改为 Prose 绕过核对。`)
+	}
+	if strings.Contains(problem, "business_value_requires_binding") {
+		hints = append(hints, `报错属性不能填手写数字、数组或字符串。Stat.value 使用 {"@path":"/facts/<本区域count或sum的fact id>/value"}；不要写计算结果，也不要用点号路径。需要的 fact 必须在同一 section.facts 中声明，datasetId 必须来自已取得的数据，且加入 dataRefs。`)
+	}
+	if strings.Contains(problem, "distribution_requires_data") || strings.Contains(problem, "distribution_fact_required") {
+		hints = append(hints, `distribution 的结果是分组列表，不能绑定 Stat.value。按负责人汇总等分组统计使用 Distribution.data:{"@path":"/facts/<distribution fact id>/value"}，field 为实际分组字段；单个数字使用 op:"count" 或 op:"sum" 的 fact 绑定 Stat.value。不要把 distribution 改成手写数字。`)
+	}
+	if len(hints) == 0 {
+		hints = append(hints, "按错误中的 section、组件及属性位置对照组件契约修改；只使用已经返回的 dataset、记录 ID 和本区域 fact。无法支持的判断删除，不编造依据。")
+	}
+	return strings.Join(hints, "\n")
+}
