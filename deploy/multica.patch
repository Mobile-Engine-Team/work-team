+	testutil.Call(t, testHandler.ArchiveAgent, withURLParam(newRequest("POST", "/api/agents/"+old+"/archive", nil), "id", old)).Want(200)
+	t.Cleanup(func() {
+		testPool.Exec(context.Background(), "DELETE FROM agent WHERE workspace_id=$1 AND name=$2", testWorkspaceID, name)
+	})
+	codes := make(chan int, 2)
+	var wg sync.WaitGroup
+	for n := 0; n < 2; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			w := httptest.NewRecorder()
+			testHandler.CreateAgent(w, newRequest("POST", "/api/agents", map[string]any{"name": name, "runtime_id": testRuntimeID}))
+			codes <- w.Code
