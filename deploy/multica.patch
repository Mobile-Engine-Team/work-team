diff --git a/server/internal/daemon/project_planning.go b/server/internal/daemon/project_planning.go
new file mode 100644
index 000000000..2c8ad6bff
--- /dev/null
+++ b/server/internal/daemon/project_planning.go
@@ -0,0 +1,132 @@
+package daemon
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/multica-ai/multica/server/pkg/agent"
+)
+
+type planningClaim struct {
+	Purpose  string `json:"purpose"`
+	Provider string `json:"provider"`
+	ID       string `json:"id"`
+	RunID    string `json:"run_id"`
+	Token    string `json:"token"`
+	Prompt   string `json:"prompt"`
+	Model    string `json:"model"`
+}
+
+func (d *Daemon) projectPlanningLoop(ctx context.Context) {
+	ticker := time.NewTicker(3 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+		for _, id := range d.allRuntimeIDs() {
+			rt := d.findRuntime(id)
+			if rt == nil || (rt.Provider != "mc" && rt.Provider != "pi" && rt.Provider != "codex" && rt.Provider != "claude" && rt.Provider != "opencode") || rt.ProfileID != "" {
+				continue
+			}
+			var response struct {
+				Request *planningClaim `json:"request"`
+			}
+			callCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
+			err := d.client.postJSON(callCtx, "/api/daemon/runtimes/"+id+"/planning/claim", map[string]string{}, &response)
+			cancel()
+			if err != nil || response.Request == nil {
+				continue
+			}
+			d.runProjectPlanning(ctx, *response.Request)
+		}
+	}
+}
+func (d *Daemon) runProjectPlanning(ctx context.Context, request planningClaim) {
+	timeout := 4 * time.Minute
+	if request.Purpose == "model_probe" {
+		timeout = 55 * time.Second
+	}
+	runCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	done := make(chan struct{})
+	defer close(done)
+	// Cancellation is scoped to this planning run; ordinary work is unaffected.
+	go func() {
+		ticker := time.NewTicker(2 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-done:
+				return
+			case <-runCtx.Done():
+				return
+			case <-ticker.C:
+				var state struct {
+					Status string `json:"status"`
+				}
+				c, stop := context.WithTimeout(runCtx, 8*time.Second)
+				err := d.client.getJSONWithToken(c, "/api/project-planning-results/"+request.ID, request.Token, &state)
+				stop()
+				if err == nil && state.Status != "running" {
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	provider := request.Provider
+	if provider == "" {
+		provider = "pi"
+	}
+	entry := d.agents()[provider]
+	entry, _, launchErr := d.resolveAgentEntryForLaunch(runCtx, provider, entry)
+	var output string
+	err := launchErr
+	if err == nil {
+		credentialDir := os.Getenv("PI_CODING_AGENT_DIR")
+		if credentialDir == "" {
+			home, e := os.UserHomeDir()
+			if e != nil {
+				err = e
+			} else {
+				credentialDir = filepath.Join(home, ".pi", "agent")
+			}
+		}
+		scratch := filepath.Join(d.cfg.WorkspacesRoot, ".planning")
+		if err == nil {
+			err = os.MkdirAll(scratch, 0700)
+		}
+		if err == nil {
+			model := request.Model
+			if model == "" {
+				model = entry.Model
+			}
+			if request.Purpose == "task_draft" || request.Purpose == "model_probe" {
+				output, err = agent.RunTaskDraft(runCtx, provider, entry.Path, model, request.Prompt, scratch)
+			} else {
+				output, err = agent.RunReadOnlyPlanning(runCtx, entry.Path, model, request.Prompt, credentialDir, scratch)
+			}
+		}
+	}
+	payload := map[string]string{"run_id": request.RunID, "output": output}
+	if err != nil {
+		payload["error"] = err.Error()
+		if request.Purpose == "model_probe" {
+			payload["error"] = "other"
+			if runCtx.Err() != nil {
+				payload["error"] = "timeout"
+			}
+		}
+		payload["output"] = ""
+	}
+	reportCtx, stop := context.WithTimeout(ctx, 15*time.Second)
+	defer stop()
+	if e := d.client.postJSONWithToken(reportCtx, "/api/project-planning-results/"+request.ID, request.Token, payload, nil); e != nil {
+		d.logger.Warn("planning result delivery failed", "request_id", request.ID, "error", e)
+	}
+}
