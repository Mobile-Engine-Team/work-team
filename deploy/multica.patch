+func TestDynamicBindingsAndContentBoundary(t *testing.T) {
+	read := map[string]Evidence{"issue:a": {ID: "issue:a", Kind: "issue", Status: "in_progress"}, "comment:c": {ID: "comment:c", Kind: "comment"}, "conclusion:old": {ID: "conclusion:old", Kind: "conclusion", Status: "superseded"}}
+	fresh := func() *Dynamic {
+		d := NewDynamic()
+		d.Datasets["d1"] = Dataset{ID: "d1", Rows: []map[string]any{{"id": "issue:a", "status": "in_progress", "title": "task", "dueDate": nil}}, Complete: true}
+		if e := d.Apply(`{"type":"plan","plan":{"title":"T","intent":"I","layout":"stack","sections":[{"id":"main","title":"M","role":"primary"}]}}`, read); e != nil {
+			t.Fatal(e)
+		}
+		return d
+	}
+	for _, cl := range []Claim{{ID: "c1", Kind: "fact", Text: "x", EvidenceIDs: []string{"private"}}, {ID: "c1", Kind: "decision", Text: "x", EvidenceIDs: []string{"conclusion:old"}}, {ID: "c1", Kind: "statement", Text: "x", EvidenceIDs: []string{"issue:a"}}, {ID: "c1", Kind: "gap", Text: "x"}} {
+		d := fresh()
+		b, _ := json.Marshal(map[string]any{"type": "content", "content": Content{SectionID: "main", Claims: []Claim{cl}}})
+		if d.Apply(string(b), read) == nil {
+			t.Fatalf("accepted invalid claim: %+v", cl)
+		}
+	}
+	d := fresh()
+	f, e := bind(Binding{ID: "count", DatasetID: "d1", Op: "count", Filter: []Filter{{Field: "status", Op: "eq", Value: "in_progress"}}}, d.Datasets)
+	if e != nil || f.Value != 1 || !f.Complete {
+		t.Fatalf("bad count %+v %v", f, e)
+	}
+	f, e = bind(Binding{ID: "date", DatasetID: "d1", Op: "field", RowID: "issue:a", Field: "dueDate"}, d.Datasets)
+	if e != nil || f.Value != nil {
+		t.Fatal("null binding lost")
+	}
+	if _, e = bind(Binding{ID: "missing", DatasetID: "d1", Op: "field", RowID: "issue:a", Field: "leadName"}, d.Datasets); e == nil {
+		t.Fatal("absent field treated as null")
+	}
+	if _, e = bind(Binding{ID: "sum", DatasetID: "d1", Op: "sum", Field: "title"}, d.Datasets); e == nil {
+		t.Fatal("summed strings")
+	}
+	for _, line := range []string{`{"type":"final","sections":["main"]}`, `{"type":"unknown"}`, `{"type":"plan","plan":{}}`, `{"type":"section","section":{"id":"main","code":"function render(){}"}}`} {
+		if d.Apply(line, read) == nil {
+			t.Fatal("accepted invalid ordering", line)
+		}
+	}
+}
+func TestDynamicCompileAndComplete(t *testing.T) {
+	d := NewDynamic()
+	read := map[string]Evidence{}
+	lines := []string{`{"type":"plan","plan":{"title":"Empty","intent":"I","layout":"stack","sections":[{"id":"main","title":"No records","role":"primary"}]}}`, `{"type":"content","content":{"sectionId":"main","claims":[{"id":"gap","kind":"gap","gapType":"no_record","text":"No records","evidenceIds":[],"factIds":[]}],"facts":[],"dataRefs":[]}}`, `{"type":"section","section":{"id":"main","code":"function render(x,ui){return <ui.Claim id=\"gap\"/>}","state":{},"contentRefs":["gap"]}}`, `{"type":"final","sections":["main"],"limitations":[],"followUps":[]}`}
+	for _, l := range lines {
+		if e := d.Apply(l, read); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if !d.Complete || d.Sections["main"].JS == "" {
+		t.Fatal("missing compiled section")
+	}
+	if d.Apply(lines[3], read) == nil {
+		t.Fatal("duplicate final")
+	}
+	if _, e := Compile(`import x from "network"`); e == nil {
+		t.Fatal("import accepted")
+	}
+}
+
+func TestPlanSurfaceIsOptionalAndBounded(t *testing.T) {
+	for _, surface := range []string{"", ",\"surface\":\"plain\"", ",\"surface\":\"card\"", ",\"surface\":\"muted\""} {
+		d := NewDynamic()
+		line := `{"type":"plan","plan":{"title":"T","intent":"I","layout":"stack","sections":[{"id":"main","title":"M","role":"primary"` + surface + `}]}}`
+		if err := d.Apply(line, nil); err != nil {
+			t.Fatal(err)
