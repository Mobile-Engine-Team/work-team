diff --git a/server/pkg/llm/tools.go b/server/pkg/llm/tools.go
new file mode 100644
index 000000000..acf51b557
--- /dev/null
+++ b/server/pkg/llm/tools.go
@@ -0,0 +1,59 @@
+package llm
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	openai "github.com/openai/openai-go/v3"
+	"github.com/openai/openai-go/v3/shared"
+)
+
+// ToolSession preserves provider message extensions across tool turns.
+// Workbench sends the owner's questions and scoped business evidence here.
+type ToolSession struct {
+	client   *Client
+	messages []openai.ChatCompletionMessageParamUnion
+}
+type ToolCall struct{ ID, Name, Arguments string }
+type ToolReply struct {
+	Content                   string
+	Calls                     []ToolCall
+	InputTokens, OutputTokens int64
+	Model                     string
+}
+
+func (c *Client) NewToolSession(system, prompt string) *ToolSession {
+	return &ToolSession{client: c, messages: []openai.ChatCompletionMessageParamUnion{openai.SystemMessage(system), openai.UserMessage(prompt)}}
+}
+func (s *ToolSession) Feedback(text string) {
+	s.messages = append(s.messages, openai.UserMessage(text))
+}
+func (s *ToolSession) ToolResult(id, content string) {
+	s.messages = append(s.messages, openai.ToolMessage(content, id))
+}
+func (s *ToolSession) Next(ctx context.Context, parameters map[string]any) (ToolReply, error) {
+	out := ToolReply{}
+	p := openai.ChatCompletionNewParams{Messages: s.messages, MaxCompletionTokens: openai.Int(6000)}
+	p.Tools = []openai.ChatCompletionToolUnionParam{{OfFunction: &openai.ChatCompletionFunctionToolParam{Function: shared.FunctionDefinitionParam{Name: "query_business", Description: openai.String("Query current workspace business records by type, exact filters, keyword or relationship. Follow nextOffset to cover all candidates; revise keywords and read related types to investigate."), Parameters: shared.FunctionParameters(parameters)}}}}
+	response, err := s.client.Chat(ctx, p)
+	if err != nil {
+		return out, err
+	}
+	if len(response.Choices) == 0 {
+		return out, errors.New("empty model response")
+	}
+	message := response.Choices[0].Message
+	var param openai.ChatCompletionMessageParamUnion
+	if err = json.Unmarshal([]byte(message.RawJSON()), &param); err != nil {
+		return out, err
+	}
+	s.messages = append(s.messages, param)
+	out.Content = message.Content
+	out.InputTokens = response.Usage.PromptTokens
+	out.OutputTokens = response.Usage.CompletionTokens
+	out.Model = response.Model
+	for _, c := range message.ToolCalls {
+		out.Calls = append(out.Calls, ToolCall{ID: c.ID, Name: c.Function.Name, Arguments: c.Function.Arguments})
+	}
+	return out, nil
+}
