+package main
+
+import "testing"
+
+func TestConnectionFailureClassification(t *testing.T) {
+	for message, want := range map[string]string{
+		"Not logged in · Please run /login": "auth", "401 Unauthorized": "auth",
+		"model not found": "model", "connection refused": "network", "context deadline exceeded": "timeout", "failed": "other",
+	} {
+		if got := connectionFailure(message); got != want {
+			t.Errorf("%q: got %q, want %q", message, got, want)
+		}
+	}
+}
