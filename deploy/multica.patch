+	issue := dbfx.Issue(t, "共享署名验证")
+	comment := dbfx.Comment(t, issue, "共享回复", testutil.Cols{"author_type": "agent", "author_id": agent})
+	var entries []TimelineEntry
+	testutil.Call(t, testHandler.ListTimeline, withURLParam(newRequestAs(member, "GET", "/api/issues/"+issue+"/timeline", nil), "id", issue)).Want(200).JSON(&entries)
+	found := false
+	for _, entry := range entries {
+		if entry.ID == comment {
+			found = true
+			if entry.ActorName != "private-access-test-agent" {
+				t.Fatalf("missing author name: %#v", entry)
+			}
+		}
+	}
+	if !found {
+		t.Fatal("shared reply missing")
+	}
+	w := httptest.NewRecorder()
+	testHandler.ListAgents(w, newRequestAs(member, "GET", "/api/agents", nil))
+	if w.Code != 200 || listContainsAgent(t, w.Body.Bytes(), agent) {
+		t.Fatal("signature leaked directory access")
+	}
+	testutil.Call(t, testHandler.GetAgent, withURLParam(newRequestAs(member, "GET", "/api/agents/"+agent, nil), "id", agent)).Want(403)
+	testutil.Call(t, testHandler.CreateIssue, newRequestAs(member, "POST", "/api/issues", map[string]any{"title": "越权调用应拒绝", "assignee_type": "agent", "assignee_id": agent})).Want(403)
+}
