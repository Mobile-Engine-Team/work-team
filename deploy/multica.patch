diff --git a/server/migrations/622_topic_conclusions.up.sql b/server/migrations/622_topic_conclusions.up.sql
new file mode 100644
index 000000000..6fb066fb5
--- /dev/null
+++ b/server/migrations/622_topic_conclusions.up.sql
@@ -0,0 +1,13 @@
+ALTER TABLE project_topic ADD COLUMN discussion_issue_id uuid, ADD COLUMN conclusion_revision integer NOT NULL DEFAULT 0, ADD COLUMN conclusion_draft text NOT NULL DEFAULT '', ADD COLUMN draft_revision integer NOT NULL DEFAULT 0;
+CREATE TABLE project_topic_conclusion (topic_id uuid NOT NULL, revision integer NOT NULL, content text NOT NULL, confirmed_by uuid NOT NULL, confirmed_at timestamptz NOT NULL DEFAULT now(), message_cutoff timestamptz NOT NULL, PRIMARY KEY(topic_id,revision));
+CREATE TABLE project_topic_followup (id uuid PRIMARY KEY, topic_id uuid NOT NULL, conclusion_revision integer NOT NULL, kind text NOT NULL, issue_id uuid, planning_request_id uuid, description text NOT NULL DEFAULT '', created_by uuid NOT NULL, created_at timestamptz NOT NULL DEFAULT now());
+DO $$ DECLARE t record; carrier uuid; num integer; BEGIN
+ FOR t IN SELECT * FROM project_topic LOOP
+  carrier := gen_random_uuid();
+  UPDATE workspace SET issue_counter=GREATEST(issue_counter,(SELECT COALESCE(MAX(number),0) FROM issue WHERE workspace_id=t.workspace_id))+1 WHERE id=t.workspace_id RETURNING issue_counter INTO num;
+  INSERT INTO issue(id,workspace_id,title,description,status,priority,creator_type,creator_id,assignee_type,assignee_id,number,metadata) VALUES(carrier,t.workspace_id,t.title,'仅讨论本话题及本话题明确提供的材料。回复当前评论；不得启动关联业务任务。','todo','none','member',t.created_by,'member',t.created_by,num,jsonb_build_object('project_topic_id',t.id,'topic_project_id',t.project_id));
+  UPDATE project_topic SET discussion_issue_id=carrier,conclusion_revision=CASE WHEN conclusion<>'' THEN 1 ELSE 0 END WHERE id=t.id;
+  INSERT INTO comment(id,issue_id,workspace_id,author_type,author_id,content,type,created_at,updated_at) SELECT id,carrier,workspace_id,'member',created_by,content,'comment',created_at,created_at FROM project_topic_message WHERE topic_id=t.id;
+  IF t.conclusion<>'' THEN INSERT INTO project_topic_conclusion(topic_id,revision,content,confirmed_by,confirmed_at,message_cutoff) VALUES(t.id,1,t.conclusion,t.created_by,t.updated_at,t.updated_at); END IF;
+ END LOOP;
+END $$;
