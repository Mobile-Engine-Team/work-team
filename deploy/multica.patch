+++ b/server/internal/service/project_blueprint.go
@@ -0,0 +1,464 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/multica-ai/multica/server/internal/projectplan"
+	"github.com/multica-ai/multica/server/internal/util"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+	"github.com/multica-ai/multica/server/pkg/dbid"
+)
+
+type PlanError struct {
+	Status  int
+	Message string
+}
+
+func (e *PlanError) Error() string      { return e.Message }
+func planConflict(message string) error { return &PlanError{409, message} }
+
+type BlueprintDraft struct {
+	ProjectID   string            `json:"project_id"`
+	BaseVersion int               `json:"base_version"`
+	Revision    int               `json:"revision"`
+	Status      string            `json:"status"`
+	Graph       projectplan.Graph `json:"graph"`
+	UpdatedBy   string            `json:"updated_by"`
+	UpdatedAt   time.Time         `json:"updated_at"`
+}
+type BlueprintVersion struct {
+	ID          string            `json:"id"`
+	Number      int               `json:"number"`
+	Graph       projectplan.Graph `json:"graph"`
+	Reason      string            `json:"reason"`
+	PublishedBy string            `json:"published_by"`
+	CreatedAt   time.Time         `json:"created_at"`
+}
+type BlueprintChange struct {
+	NodeID string `json:"node_id"`
+	Kind   string `json:"kind"`
+	Title  string `json:"title"`
+}
+type BlueprintPreview struct {
+	Changes []BlueprintChange `json:"changes"`
+	Version int               `json:"version"`
+	Graph   projectplan.Graph `json:"graph"`
+}
+type BlueprintService struct{ Issues *IssueService }
+
+func (s BlueprintService) Begin(ctx context.Context, project db.Project) (pgx.Tx, error) {
+	tx, err := s.Issues.TxStarter.Begin(ctx)
+	if err != nil {
+		return nil, err
+	}
+	var workflow pgtype.UUID
+	if err = tx.QueryRow(ctx, "SELECT workflow_id FROM project WHERE id=$1 AND workspace_id=$2 FOR UPDATE", project.ID, project.WorkspaceID).Scan(&workflow); err != nil {
+		tx.Rollback(ctx)
+		return nil, err
+	}
+	if workflow.Valid {
+		tx.Rollback(ctx)
+		return nil, &PlanError{422, "此项目使用自定义工作流，暂不支持蓝图编辑"}
+	}
+	return tx, nil
+}
+func readDraft(ctx context.Context, tx pgx.Tx, p db.Project) (BlueprintDraft, error) {
+	var d BlueprintDraft
+	var raw []byte
+	err := tx.QueryRow(ctx, `SELECT project_id::text,base_version,revision,status,graph,updated_by::text,updated_at FROM project_blueprint_draft WHERE project_id=$1 AND workspace_id=$2`, p.ID, p.WorkspaceID).Scan(&d.ProjectID, &d.BaseVersion, &d.Revision, &d.Status, &raw, &d.UpdatedBy, &d.UpdatedAt)
+	if err == nil {
+		err = json.Unmarshal(raw, &d.Graph)
+	}
+	return d, err
+}
+func readVersion(ctx context.Context, tx pgx.Tx, p db.Project) (BlueprintVersion, error) {
+	v := BlueprintVersion{Graph: projectplan.Empty()}
+	var raw []byte
+	err := tx.QueryRow(ctx, `SELECT id::text,number,graph,reason,published_by::text,created_at FROM project_blueprint_version WHERE project_id=$1 AND workspace_id=$2 ORDER BY number DESC LIMIT 1`, p.ID, p.WorkspaceID).Scan(&v.ID, &v.Number, &raw, &v.Reason, &v.PublishedBy, &v.CreatedAt)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return v, nil
+	}
+	if err == nil {
+		err = json.Unmarshal(raw, &v.Graph)
+	}
+	return v, err
+}
+func (s BlueprintService) issueBaseline(ctx context.Context, tx pgx.Tx, i db.Issue) (projectplan.Baseline, error) {
+	due := ""
+	if i.DueDate.Valid {
+		due = i.DueDate.Time.Format("2006-01-02")
+	}
+	body := i.Description.String
+	if strings.Contains(body, "\n\n采用的话题结论：\n") {
+		rows, err := tx.Query(ctx, `SELECT DISTINCT c.content FROM project_topic_followup f
+            JOIN project_topic_conclusion c ON c.topic_id=f.topic_id AND c.revision=f.conclusion_revision
+            JOIN project_topic t ON t.id=f.topic_id
+            WHERE f.issue_id=$1 AND t.workspace_id=$2`, i.ID, i.WorkspaceID)
+		if err != nil {
+			return projectplan.Baseline{}, err
+		}
+		var adopted []string
+		for rows.Next() {
+			var content string
+			if err = rows.Scan(&content); err != nil {
+				rows.Close()
+				return projectplan.Baseline{}, err
+			}
+			adopted = append(adopted, content)
+		}
+		rows.Close()
+		if err = rows.Err(); err != nil {
+			return projectplan.Baseline{}, err
+		}
+		body = projectplan.TaskRequirementsBody(body, adopted)
+	}
+	return projectplan.Baseline{Contract: projectplan.Contract{Title: i.Title, Requirements: projectplan.Requirements(body), AssigneeType: i.AssigneeType.String, AssigneeID: util.UUIDToString(i.AssigneeID), DueDate: due}, Description: i.Description.String, Status: i.Status, ProjectID: util.UUIDToString(i.ProjectID)}, nil
+}
+func (s BlueprintService) hydrate(ctx context.Context, tx pgx.Tx, p db.Project, g *projectplan.Graph, old projectplan.Graph, reset bool) error {
+	q := s.Issues.Queries.WithTx(tx)
+	base := map[string]*projectplan.Baseline{}
+	for _, n := range old.Nodes {
+		if n.IssueID != "" {
+			base[n.IssueID] = n.Baseline
+		}
+	}
+	for idx := range g.Nodes {
+		n := &g.Nodes[idx]
+		if n.IssueID == "" {
+			n.Baseline = nil
+			continue
+		}
+		id, err := util.ParseUUID(n.IssueID)
+		if err != nil {
+			return &PlanError{422, fmt.Sprintf("节点 %s：任务标识无效", n.ID)}
+		}
+		issue, err := q.GetIssueInWorkspace(ctx, db.GetIssueInWorkspaceParams{ID: id, WorkspaceID: p.WorkspaceID})
+		if err != nil || (issue.ProjectID.Valid && issue.ProjectID != p.ID) {
+			return &PlanError{422, fmt.Sprintf("节点 %s：任务不可见或属于其他项目", n.ID)}
+		}
+		if !reset && base[n.IssueID] != nil {
+			n.Baseline = base[n.IssueID]
+		} else {
+			b, err := s.issueBaseline(ctx, tx, issue)
+			if err != nil {
+				return err
+			}
+			if reset {
+				if previous := base[n.IssueID]; previous != nil {
+					merged, err := projectplan.RefreshContract(previous.Contract, n.Contract, b.Contract)
+					if err != nil {
+						return planConflict(n.Title + "：" + err.Error())
+					}
+					n.Contract = merged
+				} else {
+					n.Contract = b.Contract
+				}
+			}
+			n.Baseline = &b
+		}
+	}
+	return nil
+}
+func (s BlueprintService) Draft(ctx context.Context, p db.Project, actor pgtype.UUID, create bool) (*BlueprintDraft, error) {
+	tx, err := s.Begin(ctx, p)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback(ctx)
+	d, err := readDraft(ctx, tx, p)
+	if err == nil && (d.Status == "active" || !create) {
+		return &d, nil
+	}
+	if err != nil && !errors.Is(err, pgx.ErrNoRows) {
+		return nil, err
+	}
+	if !create {
+		return nil, nil
+	}
+	v, err := readVersion(ctx, tx, p)
+	if err != nil {
+		return nil, err
+	}
+	if err = s.hydrate(ctx, tx, p, &v.Graph, projectplan.Empty(), true); err != nil {
+		return nil, err
+	}
+	raw, _ := json.Marshal(v.Graph)
+	_, err = tx.Exec(ctx, `INSERT INTO project_blueprint_draft(project_id,workspace_id,base_version,graph,updated_by) VALUES($1,$2,$3,$4,$5) ON CONFLICT(project_id) DO UPDATE SET base_version=$3,revision=project_blueprint_draft.revision+1,status='active',graph=$4,updated_by=$5,updated_at=now()`, p.ID, p.WorkspaceID, v.Number, raw, actor)
+	if err != nil {
+		return nil, err
+	}
+	d, err = readDraft(ctx, tx, p)
+	if err != nil {
+		return nil, err
+	}
+	return &d, tx.Commit(ctx)
+}
+func (s BlueprintService) Save(ctx context.Context, p db.Project, actor pgtype.UUID, revision int, g projectplan.Graph, refresh ...bool) (*BlueprintDraft, error) {
+	if err := g.Validate(); err != nil {
+		return nil, &PlanError{422, err.Error()}
+	}
+	tx, err := s.Begin(ctx, p)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback(ctx)
+	d, err := readDraft(ctx, tx, p)
+	if err != nil {
+		return nil, err
+	}
+	if d.Status != "active" || d.Revision != revision {
+		return nil, planConflict("草案已被更新，请比较本地和最新内容")
+	}
+	if err = s.hydrate(ctx, tx, p, &g, d.Graph, len(refresh) > 0 && refresh[0]); err != nil {
+		return nil, err
+	}
+	if err = s.validateAssignees(ctx, tx, p, g); err != nil {
+		return nil, err
+	}
+	raw, _ := json.Marshal(g)
+	_, err = tx.Exec(ctx, `UPDATE project_blueprint_draft SET graph=$2,revision=revision+1,updated_by=$3,updated_at=now() WHERE project_id=$1`, p.ID, raw, actor)
+	if err != nil {
+		return nil, err
+	}
+	d, err = readDraft(ctx, tx, p)
+	if err != nil {
+		return nil, err
+	}
+	return &d, tx.Commit(ctx)
+}
+func (s BlueprintService) validateAssignees(ctx context.Context, tx pgx.Tx, p db.Project, g projectplan.Graph) error {
+	for _, n := range g.Nodes {
+		if n.DueDate != "" {
+			if _, err := time.Parse("2006-01-02", n.DueDate); err != nil {
+				return &PlanError{422, fmt.Sprintf("%s：截止时间无效，请选择有效日期", n.Title)}
+			}
+		}
+		if n.AssigneeID == "" {
+			continue
+		}
+		id, err := util.ParseUUID(n.AssigneeID)
+		if err != nil {
+			return &PlanError{422, fmt.Sprintf("%s：负责人无效，请重新选择", n.Title)}
+		}
+		var exists bool
+		switch n.AssigneeType {
+		case "member":
+			err = tx.QueryRow(ctx, "SELECT EXISTS(SELECT 1 FROM member WHERE user_id=$1 AND workspace_id=$2)", id, p.WorkspaceID).Scan(&exists)
+		case "agent":
+			err = tx.QueryRow(ctx, "SELECT EXISTS(SELECT 1 FROM agent WHERE id=$1 AND workspace_id=$2 AND archived_at IS NULL)", id, p.WorkspaceID).Scan(&exists)
+		case "squad":
+			err = tx.QueryRow(ctx, "SELECT EXISTS(SELECT 1 FROM squad WHERE id=$1 AND workspace_id=$2 AND archived_at IS NULL)", id, p.WorkspaceID).Scan(&exists)
+		}
+		if err != nil {
+			return err
+		}
+		if !exists {
+			return &PlanError{422, fmt.Sprintf("%s：负责人已不可用，请选择当前工作区成员或智能体", n.Title)}
+		}
+	}
+	return nil
+}
+func (s BlueprintService) prepare(ctx context.Context, tx pgx.Tx, p db.Project, revision, base int) (BlueprintDraft, BlueprintPreview, error) {
+	d, err := readDraft(ctx, tx, p)
+	if err != nil {
+		return d, BlueprintPreview{}, err
+	}
+	v, err := readVersion(ctx, tx, p)
+	if err != nil {
+		return d, BlueprintPreview{}, err
+	}
+	preview := BlueprintPreview{Changes: []BlueprintChange{}, Version: v.Number + 1, Graph: d.Graph}
+	if d.Status != "active" || revision != d.Revision || base != d.BaseVersion || base != v.Number {
+		return d, preview, planConflict("草案或当前版本已更新，请重新核对")
+	}
+	if err = d.Graph.Validate(); err != nil {
+		return d, preview, &PlanError{422, err.Error()}
+	}
+	if err = s.validateAssignees(ctx, tx, p, d.Graph); err != nil {
+		return d, preview, err
+	}
+	old, newNodes := map[string]projectplan.Node{}, map[string]projectplan.Node{}
+	ids := map[string]bool{}
+	for _, n := range v.Graph.Nodes {
+		old[n.ID] = n
+		if n.IssueID != "" {
+			ids[n.IssueID] = true
+		}
+	}
+	for _, n := range d.Graph.Nodes {
+		newNodes[n.ID] = n
+		if n.IssueID != "" {
+			ids[n.IssueID] = true
+		}
+	}
+	ordered := []string{}
+	for id := range ids {
+		ordered = append(ordered, id)
+	}
+	sort.Strings(ordered)
+	actual := map[string]db.Issue{}
+	active := map[string]bool{}
+	q := s.Issues.Queries.WithTx(tx)
+	for _, id := range ordered {
+		uid, e := util.ParseUUID(id)
+		if e != nil {
+			return d, preview, &PlanError{422, "任务标识无效"}
+		}
+		var locked pgtype.UUID
+		if e = tx.QueryRow(ctx, "SELECT id FROM issue WHERE id=$1 AND workspace_id=$2 FOR UPDATE", uid, p.WorkspaceID).Scan(&locked); e != nil {
+			return d, preview, &PlanError{422, "引用任务不可用"}
+		}
+		i, e := q.GetIssueInWorkspace(ctx, db.GetIssueInWorkspaceParams{ID: uid, WorkspaceID: p.WorkspaceID})
+		if e != nil {
+			return d, preview, e
+		}
+		actual[id] = i
+		var running bool
+		if e = tx.QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM agent_task_queue WHERE issue_id=$1 AND status NOT IN ('completed','failed','cancelled'))`, uid).Scan(&running); e != nil {
+			return d, preview, e
+		}
+		active[id] = running
+	}
+	for _, n := range d.Graph.Nodes {
+		prev, had := old[n.ID]
+		if had && prev.IssueID != n.IssueID {
+			return d, preview, &PlanError{422, "已有节点不能替换真实任务身份"}
+		}
+		kind := ""
+		if !had {
+			kind = "added"
+		} else if n.Contract != prev.Contract {
+			kind = "changed"
+		}
+		if n.IssueID != "" {
+			i := actual[n.IssueID]
+			b, err := s.issueBaseline(ctx, tx, i)
+			if err != nil {
+				return d, preview, err
+			}
+			if n.Baseline == nil || n.Baseline.Contract != b.Contract || n.Baseline.Description != b.Description || n.Baseline.ProjectID != b.ProjectID {
+				return d, preview, planConflict(fmt.Sprintf("%s：任务要求或负责人已变化，请同步任务最新内容", n.Title))
+			}
+			if i.ProjectID.Valid && i.ProjectID != p.ID {
+				return d, preview, &PlanError{422, "引用任务已归属其他项目"}
+			}
+
+		}
+		if kind != "" {
+			preview.Changes = append(preview.Changes, BlueprintChange{n.ID, kind, n.Title})
+		}
+	}
+	for _, n := range v.Graph.Nodes {
+		if _, ok := newNodes[n.ID]; !ok {
+			if active[n.IssueID] {
+				return d, preview, planConflict(n.Title + "：运行期间不能移出计划")
+			}
+			preview.Changes = append(preview.Changes, BlueprintChange{n.ID, "removed", n.Title})
+		}
+	}
+	if !projectplan.SameDependencies(v.Graph.Edges, d.Graph.Edges) {
+		preview.Changes = append(preview.Changes, BlueprintChange{"", "dependencies", "交付依赖"})
+	}
+	return d, preview, nil
+}
+func (s BlueprintService) Publish(ctx context.Context, p db.Project, actor pgtype.UUID, revision, base int, key, reason string, previewOnly bool) (BlueprintPreview, *BlueprintVersion, error) {
+	tx, err := s.Begin(ctx, p)
+	if err != nil {
+		return BlueprintPreview{}, nil, err
+	}
+	defer tx.Rollback(ctx)
+	if !previewOnly {
+		if key == "" || len(key) > 100 {
+			return BlueprintPreview{}, nil, &PlanError{422, "请提供发布请求标识"}
+		}
+		var v BlueprintVersion
+		var raw []byte
+		e := tx.QueryRow(ctx, `SELECT id::text,number,graph,reason,published_by::text,created_at FROM project_blueprint_version WHERE project_id=$1 AND request_id=$2`, p.ID, key).Scan(&v.ID, &v.Number, &raw, &v.Reason, &v.PublishedBy, &v.CreatedAt)
+		if e == nil {
+			if err = json.Unmarshal(raw, &v.Graph); err != nil {
+				return BlueprintPreview{}, nil, err
+			}
+			return BlueprintPreview{}, &v, nil
+		}
+		if !errors.Is(e, pgx.ErrNoRows) {
+			return BlueprintPreview{}, nil, e
+		}
+	}
+	d, preview, err := s.prepare(ctx, tx, p, revision, base)
+	if err != nil {
+		return preview, nil, err
+	}
+	if previewOnly {
+		return preview, nil, nil
+	}
+	for idx := range d.Graph.Nodes {
+		n := &d.Graph.Nodes[idx]
+		var issue db.Issue
+		due := pgtype.Date{}
+		if n.DueDate != "" {
+			dt, _ := time.Parse("2006-01-02", n.DueDate)
+			due = pgtype.Date{Time: dt, Valid: true}
+		}
+		assignee := pgtype.UUID{}
+		if n.AssigneeID != "" {
+			assignee, _ = util.ParseUUID(n.AssigneeID)
+		}
+		if n.IssueID == "" {
+			result, e := s.Issues.CreateInTransaction(ctx, tx, IssueCreateParams{WorkspaceID: p.WorkspaceID, Title: n.Title, Description: pgtype.Text{String: projectplan.WithRequirements("", n.Requirements), Valid: true}, Status: "backlog", Priority: "none", AssigneeType: pgtype.Text{String: n.AssigneeType, Valid: n.AssigneeType != ""}, AssigneeID: assignee, CreatorType: "member", CreatorID: actor, ProjectID: p.ID, DueDate: due, AllowDuplicate: true})
+			if e != nil {
+				return preview, nil, e
+			}
+			issue = result.Issue
+			n.IssueID = util.UUIDToString(issue.ID)
+		} else {
+			uid, _ := util.ParseUUID(n.IssueID)
+			description := projectplan.PublishRequirements(*n.Baseline, n.Requirements)
+			if _, err = tx.Exec(ctx, `UPDATE issue SET project_id=$2,title=$3,description=$4,assignee_type=$5,assignee_id=$6,due_date=$7,updated_at=now() WHERE id=$1 AND workspace_id=$8`, uid, p.ID, n.Title, description, pgtype.Text{String: n.AssigneeType, Valid: n.AssigneeType != ""}, assignee, due, p.WorkspaceID); err != nil {
+				return preview, nil, err
+			}
+			issue, err = s.Issues.Queries.WithTx(tx).GetIssueInWorkspace(ctx, db.GetIssueInWorkspaceParams{ID: uid, WorkspaceID: p.WorkspaceID})
+			if err != nil {
+				return preview, nil, err
+			}
+		}
+		b, err := s.issueBaseline(ctx, tx, issue)
+		if err != nil {
+			return preview, nil, err
+		}
+		n.Baseline = &b
+	}
+	raw, _ := json.Marshal(d.Graph)
+	v := BlueprintVersion{ID: util.UUIDToString(dbid.NewV7()), Number: preview.Version, Graph: d.Graph, Reason: reason, PublishedBy: util.UUIDToString(actor)}
+	if err = tx.QueryRow(ctx, `INSERT INTO project_blueprint_version(id,project_id,workspace_id,number,graph,request_id,reason,published_by) VALUES($1,$2,$3,$4,$5,$6,$7,$8) RETURNING created_at`, v.ID, p.ID, p.WorkspaceID, v.Number, raw, key, reason, actor).Scan(&v.CreatedAt); err != nil {
+		return preview, nil, err
+	}
+	if _, err = tx.Exec(ctx, `UPDATE project_blueprint_draft SET status='published',graph=$2,revision=revision+1,updated_by=$3,updated_at=now() WHERE project_id=$1`, p.ID, raw, actor); err != nil {
+		return preview, nil, err
+	}
+	// Resolve adopted proposal nodes to their published issue identities atomically.
+	_, err = tx.Exec(ctx, `INSERT INTO project_topic_followup(id,topic_id,conclusion_revision,kind,issue_id,planning_request_id,description,created_by)
+ SELECT gen_random_uuid(),f.topic_id,f.conclusion_revision,'link',(n->>'issue_id')::uuid,f.planning_request_id,'来自已发布蓝图调整', $3
+ FROM project_topic_followup f JOIN project_planning_request pr ON pr.id=f.planning_request_id
+ CROSS JOIN LATERAL jsonb_array_elements($2::jsonb->'nodes') n
+ WHERE pr.project_id=$1 AND f.kind='blueprint' AND COALESCE(n->>'issue_id','')<>''
+ AND EXISTS(SELECT 1 FROM jsonb_array_elements(pr.result->'changes') c WHERE pr.applied ? (c->>'id')
+ AND (n->>'id'=COALESCE(NULLIF(c->'node'->>'id',''),c->>'target')
+ OR n->>'id'=c->'edge'->>'from' OR n->>'id'=c->'edge'->>'to'))
+ AND NOT EXISTS(SELECT 1 FROM project_topic_followup existing WHERE existing.topic_id=f.topic_id AND existing.conclusion_revision=f.conclusion_revision AND existing.issue_id=(n->>'issue_id')::uuid)`, p.ID, raw, actor)
+	if err != nil {
+		return BlueprintPreview{}, nil, err
+	}
+	_, err = tx.Exec(ctx, `UPDATE project_topic t SET issue_ids=ARRAY(SELECT DISTINCT x FROM unnest(t.issue_ids || ARRAY(SELECT f.issue_id FROM project_topic_followup f WHERE f.topic_id=t.id AND f.issue_id IS NOT NULL)) x) WHERE t.project_id=$1`, p.ID)
+	if err != nil {
+		return BlueprintPreview{}, nil, err
+	}
+	return preview, &v, tx.Commit(ctx)
+}
