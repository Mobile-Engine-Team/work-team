@@ -0,0 +1,43 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"github.com/spf13/cobra"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestValidateRemoteConnect(t *testing.T) {
+	valid := remoteConnectInput{ServerURL: "https://example.test", Token: "test", UserID: "12345678-1234-4234-8234-123456789012"}
+	if err := validateRemoteConnect(valid); err != nil {
+		t.Fatal(err)
+	}
+	for _, address := range []string{"file:///secret", "https://user:pass@example.test", "https://example.test/path", "https://example.test?token=test"} {
+		input := valid
+		input.ServerURL = address
+		if validateRemoteConnect(input) == nil {
+			t.Errorf("accepted %s", address)
+		}
+	}
+}
+
+func TestRemoteConnectRejectsIdentityBeforeWriting(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("MULTICA_CONFIG_HOME", home)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte(`{"id":"other-user"}`)) }))
+	defer server.Close()
+	cmd := &cobra.Command{}
+	cmd.SetContext(context.Background())
+	cmd.SetIn(bytes.NewBufferString(`{"server_url":"` + server.URL + `","token":"test","user_id":"12345678-1234-4234-8234-123456789012"}`))
+	if runDaemonConnect(cmd, nil) == nil {
+		t.Fatal("accepted another user")
+	}
+	if _, err := os.Stat(filepath.Join(home, ".multica")); !os.IsNotExist(err) {
+		t.Fatal("wrote config before verifying identity")
+	}
+}
diff --git a/server/cmd/multica/cmd_daemon_test_connection.go b/server/cmd/multica/cmd_daemon_test_connection.go
new file mode 100644
index 000000000..3b92fcbb7
--- /dev/null
+++ b/server/cmd/multica/cmd_daemon_test_connection.go
@@ -0,0 +1,104 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/daemon"
+	"github.com/multica-ai/multica/server/pkg/agent"
+	"github.com/spf13/cobra"
+)
+
+// Desktop-only diagnostic: the host verifies ownership and supplies the saved
+// runtime/model. Reuse native discovery and provider backends, never user tasks.
+func newDaemonTestConnectionCmd() *cobra.Command {
+	cmd := &cobra.Command{Use: "test-connection", Hidden: true, RunE: runDaemonTestConnection}
+	cmd.Flags().String("provider", "", "Runtime provider")
+	cmd.Flags().String("model", "", "Configured model")
+	cmd.Flags().String("directory", "", "Private diagnostic directory")
+	return cmd
+}
+func connectionFailure(message string) string {
+	value := strings.ToLower(message)
+	switch {
+	case strings.Contains(value, "401"), strings.Contains(value, "not logged in"), strings.Contains(value, "unauthorized"), strings.Contains(value, "authentication"), strings.Contains(value, "api key"), strings.Contains(value, "missing bearer"):
+		return "auth"
+	case strings.Contains(value, "model"), strings.Contains(value, "403"), strings.Contains(value, "404"):
+		return "model"
+	case strings.Contains(value, "timeout"), strings.Contains(value, "deadline"):
+		return "timeout"
+	case strings.Contains(value, "connect"), strings.Contains(value, "network"), strings.Contains(value, "dns"):
+		return "network"
+	default:
+		return "other"
+	}
+}
+func runDaemonTestConnection(cmd *cobra.Command, _ []string) error {
+	if err := requireHumanLocalCommand("daemon test-connection"); err != nil {
+		return err
+	}
+	provider, _ := cmd.Flags().GetString("provider")
+	model, _ := cmd.Flags().GetString("model")
+	directory, _ := cmd.Flags().GetString("directory")
+	if !filepath.IsAbs(directory) {
+		return fmt.Errorf("diagnostic directory must be absolute")
+	}
+	report := func(passed bool, reason string) error {
+		return json.NewEncoder(cmd.OutOrStdout()).Encode(map[string]any{"passed": passed, "reason": reason, "provider": provider, "model": model})
+	}
+	cfg, err := daemon.LoadConfig(daemon.Overrides{Profile: resolveProfile(cmd), AllowNoAgents: true})
+	if err != nil {
+		return report(false, "configuration")
+	}
+	entry, found := cfg.Agents[provider]
+	if !found {
+		return report(false, "not_installed")
+	}
+	if model == "" {
+		model = entry.Model
+	}
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		return err
+	}
+	work, err := os.MkdirTemp(directory, "connection-")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(work)
+	backend, err := agent.New(provider, agent.Config{ExecutablePath: entry.Path, BuiltinRuntime: true, Logger: slog.New(slog.NewTextHandler(io.Discard, nil))})
+	if err != nil {
+		return report(false, "unsupported")
+	}
+	ctx, cancel := context.WithTimeout(cmd.Context(), 55*time.Second)
+	defer cancel()
+	session, err := backend.Execute(ctx, "Connection check only. Do not use tools or read/write files. Reply with exactly MW_CONNECTION_OK.", agent.ExecOptions{Cwd: work, Model: model, MaxTurns: 1, Timeout: 50 * time.Second})
+	if err != nil {
+		return report(false, connectionFailure(err.Error()))
+	}
+	for {
+		select {
+		case <-ctx.Done():
+			return report(false, "timeout")
+		case _, open := <-session.Messages:
+			if !open {
+				session.Messages = nil
+			}
+		case result, open := <-session.Result:
+			if !open {
+				return report(false, "other")
+			}
+			passed := result.Status == "completed" && strings.Contains(result.Output, "MW_CONNECTION_OK")
+			if passed {
+				return report(true, "")
+			}
+			return report(false, connectionFailure(result.Error+" "+result.Output))
+		}
+	}
+}
