diff --git a/server/internal/projectplan/graph.go b/server/internal/projectplan/graph.go
new file mode 100644
index 000000000..d4d4dfaea
--- /dev/null
+++ b/server/internal/projectplan/graph.go
@@ -0,0 +1,155 @@
+// Package projectplan owns the versioned, non-executing project plan contract.
+package projectplan
+
+import (
+	"fmt"
+	"math"
+	"strings"
+)
+
+type Position struct {
+	X float64 `json:"x"`
+	Y float64 `json:"y"`
+}
+type Contract struct {
+	Title        string `json:"title"`
+	Requirements string `json:"requirements"`
+	AssigneeType string `json:"assignee_type"`
+	AssigneeID   string `json:"assignee_id"`
+	DueDate      string `json:"due_date"`
+}
+type Baseline struct {
+	Contract
+	Description string `json:"description"`
+	Status      string `json:"status"`
+	ProjectID   string `json:"project_id"`
+}
+type Node struct {
+	ID      string `json:"id"`
+	IssueID string `json:"issue_id"`
+	Contract
+	Position Position  `json:"position"`
+	Baseline *Baseline `json:"baseline,omitempty"`
+}
+type Edge struct {
+	ID      string `json:"id"`
+	From    string `json:"from"`
+	To      string `json:"to"`
+	Handoff string `json:"handoff"`
+}
+type Graph struct {
+	SchemaVersion int    `json:"schema_version"`
+	Nodes         []Node `json:"nodes"`
+	Edges         []Edge `json:"edges"`
+}
+
+func Empty() Graph { return Graph{1, []Node{}, []Edge{}} }
+func (g Graph) Validate() error {
+	if g.SchemaVersion != 1 {
+		return fmt.Errorf("不支持此蓝图格式")
+	}
+	if len(g.Nodes) > 100 || len(g.Edges) > 300 {
+		return fmt.Errorf("蓝图最多支持 100 项任务、300 条依赖")
+	}
+	nodes, issues, edges, pairs := map[string]bool{}, map[string]bool{}, map[string]bool{}, map[string]bool{}
+	degree, next := map[string]int{}, map[string][]string{}
+	for index, n := range g.Nodes {
+		if n.ID == "" || len(n.ID) > 100 || nodes[n.ID] {
+			return fmt.Errorf("节点 %s：标识为空或重复", n.ID)
+		}
+		nodes[n.ID] = true
+		if strings.TrimSpace(n.Title) == "" {
+			return fmt.Errorf("第 %d 项任务：标题不能为空，请在右侧填写任务标题", index+1)
+		}
+		if len(n.Title) > 1000 {
+			return fmt.Errorf("第 %d 项任务：标题过长，请缩短后重试", index+1)
+		}
+		if len(n.Requirements) > 30000 {
+			return fmt.Errorf("%s：交付要求过长，请精简后重试", n.Title)
+		}
+		if math.IsNaN(n.Position.X) || math.IsInf(n.Position.X, 0) || math.IsNaN(n.Position.Y) || math.IsInf(n.Position.Y, 0) {
+			return fmt.Errorf("节点 %s：位置无效", n.ID)
+		}
+		if n.IssueID != "" {
+			if issues[n.IssueID] {
+				return fmt.Errorf("节点 %s：重复引用任务", n.ID)
+			}
+			issues[n.IssueID] = true
+		}
+		if (n.AssigneeID == "") != (n.AssigneeType == "") || (n.AssigneeType != "" && n.AssigneeType != "member" && n.AssigneeType != "agent" && n.AssigneeType != "squad") {
+			return fmt.Errorf("节点 %s：负责人无效", n.ID)
+		}
+	}
+	for _, e := range g.Edges {
+		pair := e.From + "\x00" + e.To
+		if e.ID == "" || edges[e.ID] || pairs[pair] || e.From == e.To || !nodes[e.From] || !nodes[e.To] || len(e.Handoff) > 4000 {
+			return fmt.Errorf("依赖 %s：自环、重复或未知节点", e.ID)
+		}
+		edges[e.ID], pairs[pair] = true, true
+		degree[e.To]++
+		next[e.From] = append(next[e.From], e.To)
+	}
+	queue := []string{}
+	for id := range nodes {
+		if degree[id] == 0 {
+			queue = append(queue, id)
+		}
+	}
+	for i := 0; i < len(queue); i++ {
+		for _, id := range next[queue[i]] {
+			degree[id]--
+			if degree[id] == 0 {
+				queue = append(queue, id)
+			}
+		}
+	}
+	if len(queue) != len(nodes) {
+		return fmt.Errorf("依赖形成循环，请检查连线方向")
+	}
+	return nil
+}
+
+const requirementStart = "\n\n<!-- mw-blueprint-requirements -->\n"
+const requirementEnd = "\n<!-- /mw-blueprint-requirements -->"
+
+func Requirements(description string) string {
+	_, tail, ok := strings.Cut(description, requirementStart)
+	if !ok {
+		return description
+	}
+	body, _, ok := strings.Cut(tail, requirementEnd)
+	if !ok {
+		return description
+	}
+	return body
+}
+func WithRequirements(description, requirements string) string {
+	before, tail, ok := strings.Cut(description, requirementStart)
+	if ok {
+		_, after, closed := strings.Cut(tail, requirementEnd)
+		if closed {
+			return before + requirementStart + requirements + requirementEnd + after
+		}
+	}
+	return description + requirementStart + requirements + requirementEnd
+}
+
+// SameDependencies compares the published meaning, not editor IDs or array order.
+func SameDependencies(a, b []Edge) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	type dependency struct{ From, To, Handoff string }
+	counts := map[dependency]int{}
+	for _, e := range a {
+		counts[dependency{e.From, e.To, e.Handoff}]++
+	}
+	for _, e := range b {
+		k := dependency{e.From, e.To, e.Handoff}
+		if counts[k] == 0 {
+			return false
+		}
+		counts[k]--
+	}
+	return true
+}
