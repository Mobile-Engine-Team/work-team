+	"time"
+
+	"github.com/multica-ai/multica/server/internal/testutil"
+	"golang.org/x/crypto/bcrypt"
+)
+
+func TestDemoPasswordAuth(t *testing.T) {
+	t.Setenv("MW_DEMO_PASSWORD_AUTH", "1")
+	t.Setenv("APP_ENV", "development")
+	username := fmt.Sprintf("passwordtest%d", time.Now().UnixNano())
+	call := func(mode, name, password string, status int, out *LoginResponse) {
+		t.Helper()
+		req := httptest.NewRequest(http.MethodPost, "/auth/password/"+mode, strings.NewReader(fmt.Sprintf(`{"username":%q,"password":%q}`, name, password)))
+		result := testutil.Call(t, testHandler.DemoPasswordAuth, req).Want(status)
+		if out != nil {
+			result.JSON(out)
+		}
+	}
+	var registered, logged LoginResponse
+	call("register", username, "demo-password-123", 200, &registered)
+	t.Cleanup(func() {
+		testPool.Exec(context.Background(), `DELETE FROM demo_password_account WHERE username=$1`, username)
+		testPool.Exec(context.Background(), `DELETE FROM "user" WHERE id=$1`, parseUUID(registered.User.ID))
+	})
+	if registered.Token == "" || registered.User.Email != username+demoEmailSuffix {
+		t.Fatal("missing native identity")
+	}
+	stored, err := testHandler.Queries.GetDemoPasswordAccount(context.Background(), username)
+	if err != nil || stored.PasswordHash == "demo-password-123" || bcrypt.CompareHashAndPassword([]byte(stored.PasswordHash), []byte("demo-password-123")) != nil {
+		t.Fatal("password not hashed")
+	}
+	call("register", username, "another-password", 409, nil)
+	call("login", strings.ToUpper(username), "demo-password-123", 200, &logged)
+	if logged.User.ID != registered.User.ID {
+		t.Fatal("login changed user")
+	}
+	call("login", username, "wrong-password", 401, nil)
+	call("register", "bad name", "demo-password-123", 400, nil)
+	call("register", "validname", "short", 400, nil)
+	if _, _, err := testHandler.findOrCreateUser(context.Background(), registered.User.Email); err == nil {
+		t.Fatal("email authentication bypassed password")
+	}
+	t.Setenv("MW_DEMO_PASSWORD_AUTH", "0")
+	call("login", username, "demo-password-123", 404, nil)
+	t.Setenv("MW_DEMO_PASSWORD_AUTH", "1")
+	t.Setenv("APP_ENV", "production")
+	call("login", username, "demo-password-123", 404, nil)
+}
