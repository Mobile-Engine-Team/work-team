diff --git a/server/internal/daemon/model_probe_test.go b/server/internal/daemon/model_probe_test.go
new file mode 100644
index 000000000..3b8531a61
--- /dev/null
+++ b/server/internal/daemon/model_probe_test.go
@@ -0,0 +1,68 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestModelProbeUsesIsolatedRunnerAndSanitizedResult(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(map[bool]string{false: "success", true: "failure"}[fail], func(t *testing.T) {
+			root := t.TempDir()
+			t.Setenv("HOME", root)
+			t.Setenv("CODEX_HOME", filepath.Join(root, "credentials"))
+			t.Setenv("MULTICA_TOKEN", "must-not-reach-agent")
+			executable := filepath.Join(root, "fake-agent")
+			script := `#!/bin/sh
+[ -z "$MULTICA_TOKEN" ] || exit 20
+case " $* " in *" --model saved-model "*) ;; *) exit 21;; esac
+case " $* " in *" --sandbox read-only "*) ;; *) exit 22;; esac
+read prompt
+[ "$prompt" = 'Connection check only.' ] || exit 23
+printf '%s\n' '{"type":"item.completed","item":{"type":"agent_message","text":"MW_CONNECTION_OK"}}'
+`
+			if fail {
+				script = "#!/bin/sh\necho 'private-provider-detail' >&2\nexit 1\n"
+			}
+			if err := os.WriteFile(executable, []byte(script), 0700); err != nil {
+				t.Fatal(err)
+			}
+			reports := make(chan map[string]string, 1)
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == "POST" {
+					var result map[string]string
+					if err := json.NewDecoder(r.Body).Decode(&result); err != nil {
+						t.Error(err)
+					}
+					if r.Header.Get("Authorization") != "Bearer isolated-result-token" {
+						t.Error("wrong result token")
+					}
+					reports <- result
+				}
+				w.Header().Set("Content-Type", "application/json")
+				w.Write([]byte(`{"status":"running"}`))
+			}))
+			defer srv.Close()
+			d := newSelfHealTestDaemon()
+			d.cfg = Config{WorkspacesRoot: root, Agents: map[string]AgentEntry{"codex": {Path: executable}}}
+			d.client = NewClient(srv.URL)
+			d.runProjectPlanning(context.Background(), planningClaim{Purpose: "model_probe", Provider: "codex", ID: "request", RunID: "run", Token: "isolated-result-token", Model: "saved-model", Prompt: "Connection check only."})
+			result := <-reports
+			if result["run_id"] != "run" {
+				t.Fatal(result)
+			}
+			if fail {
+				if result["error"] != "other" || result["output"] != "" {
+					t.Fatal(result)
+				}
