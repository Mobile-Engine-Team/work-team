diff --git a/server/internal/handler/project_blueprint.go b/server/internal/handler/project_blueprint.go
new file mode 100644
index 000000000..610cf3c3b
--- /dev/null
+++ b/server/internal/handler/project_blueprint.go
@@ -0,0 +1,195 @@
+package handler
+
+import (
+	"encoding/json"
+	"errors"
+	"log/slog"
+	"net/http"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/multica-ai/multica/server/internal/projectplan"
+	"github.com/multica-ai/multica/server/internal/service"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+	"github.com/multica-ai/multica/server/pkg/protocol"
+)
+
+func (h *Handler) projectAccess(w http.ResponseWriter, r *http.Request, write, publish bool) (db.Project, db.Member, bool) {
+	p, ok := h.loadProjectForResource(w, r, chi.URLParam(r, "id"))
+	if !ok {
+		return p, db.Member{}, false
+	}
+	m, ok := h.requireWorkspaceMember(w, r, uuidToString(p.WorkspaceID), "project not found")
+	if !ok {
+		return p, m, false
+	}
+	actor, _ := h.resolveActor(r, requestUserID(r), uuidToString(p.WorkspaceID))
+	if write && (m.Role == "guest" || actor != "member") {
+		writeError(w, 403, "仅人类工作区成员可以编辑项目计划")
+		return p, m, false
+	}
+	if publish && !roleAllowed(m.Role, "owner", "admin") && !(p.LeadType.String == "member" && p.LeadID == m.UserID) {
+		writeError(w, 403, "仅项目负责人或工作区管理员可以发布和修改项目设置")
+		return p, m, false
+	}
+	return p, m, true
+}
+func planWriteError(w http.ResponseWriter, err error) {
+	var e *service.PlanError
+	if errors.As(err, &e) {
+		writeError(w, e.Status, e.Message)
+		return
+	}
+	slog.Error("project operation failed", "error", err)
+	writeError(w, 500, "项目服务暂时无法完成操作，请稍后重试；编辑内容仍保留")
+}
+func decodePlan(w http.ResponseWriter, r *http.Request, target any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, 2<<20)
+	if err := json.NewDecoder(r.Body).Decode(target); err != nil {
+		writeError(w, 400, "请求内容无效或超过限制")
+		return false
+	}
+	return true
+}
+func (h *Handler) projectChanged(r *http.Request, p db.Project) {
+	h.publish(protocol.EventProjectUpdated, uuidToString(p.WorkspaceID), "member", requestUserID(r), map[string]any{"project_id": uuidToString(p.ID)})
+}
+func (h *Handler) BlueprintDraft(w http.ResponseWriter, r *http.Request) {
+	create := r.Method == http.MethodPost
+	p, m, ok := h.projectAccess(w, r, create, false)
+	if !ok {
+		return
+	}
+	d, err := (service.BlueprintService{Issues: h.IssueService}).Draft(r.Context(), p, m.UserID, create)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if create {
+		h.projectChanged(r, p)
+	}
+	writeJSON(w, 200, map[string]any{"draft": d})
+}
+func (h *Handler) SaveBlueprintDraft(w http.ResponseWriter, r *http.Request) {
+	p, m, ok := h.projectAccess(w, r, true, false)
+	if !ok {
+		return
+	}
+	var req struct {
+		RefreshBaseline  bool              `json:"refresh_baseline"`
+		ExpectedRevision int               `json:"expected_revision"`
+		Graph            projectplan.Graph `json:"graph"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	for _, n := range req.Graph.Nodes {
+		if n.AssigneeID != "" {
+			id, ok := parseUUIDOrBadRequest(w, n.AssigneeID, "assignee_id")
+			if !ok {
+				return
+			}
+			if status, msg := h.validateAssigneePair(r.Context(), r, uuidToString(p.WorkspaceID), pgtype.Text{String: n.AssigneeType, Valid: true}, id); status != 0 {
+				writeError(w, status, msg)
+				return
+			}
+		}
+	}
+	d, err := (service.BlueprintService{Issues: h.IssueService}).Save(r.Context(), p, m.UserID, req.ExpectedRevision, req.Graph, req.RefreshBaseline)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	h.projectChanged(r, p)
+	writeJSON(w, 200, map[string]any{"draft": d})
+}
+func (h *Handler) PublishBlueprint(w http.ResponseWriter, r *http.Request) {
+	p, m, ok := h.projectAccess(w, r, true, true)
+	if !ok {
+		return
+	}
+	var req struct {
+		ExpectedRevision int    `json:"expected_revision"`
+		BaseVersion      int    `json:"base_version"`
+		RequestID        string `json:"request_id"`
+		Reason           string `json:"reason"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	draft, err := (service.BlueprintService{Issues: h.IssueService}).Draft(r.Context(), p, m.UserID, false)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if draft != nil {
+		for _, n := range draft.Graph.Nodes {
+			if n.AssigneeID != "" {
+				id, ok := parseUUIDOrBadRequest(w, n.AssigneeID, "assignee_id")
+				if !ok {
+					return
+				}
+				if status, msg := h.validateAssigneePair(r.Context(), r, uuidToString(p.WorkspaceID), pgtype.Text{String: n.AssigneeType, Valid: true}, id); status != 0 {
+					writeError(w, status, msg)
+					return
+				}
+			}
+		}
+	}
+	previewOnly := chi.URLParam(r, "action") == "publish-preview"
+	preview, v, err := (service.BlueprintService{Issues: h.IssueService}).Publish(r.Context(), p, m.UserID, req.ExpectedRevision, req.BaseVersion, req.RequestID, req.Reason, previewOnly)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if previewOnly {
+		writeJSON(w, 200, preview)
+	} else {
+		h.projectChanged(r, p)
+		writeJSON(w, 200, v)
+	}
+}
+func (h *Handler) BlueprintVersions(w http.ResponseWriter, r *http.Request) {
+	p, _, ok := h.projectAccess(w, r, false, false)
+	if !ok {
+		return
+	}
+	rows, err := h.Queries.ListBlueprintVersions(r.Context(), db.ListBlueprintVersionsParams{ProjectID: p.ID, WorkspaceID: p.WorkspaceID})
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	versions := []service.BlueprintVersion{}
+	for _, row := range rows {
+		var g projectplan.Graph
+		if err = json.Unmarshal(row.Graph, &g); err != nil {
+			planWriteError(w, err)
+			return
+		}
+		versions = append(versions, service.BlueprintVersion{ID: uuidToString(row.ID), Number: int(row.Number), Graph: g, Reason: row.Reason, PublishedBy: uuidToString(row.PublishedBy), CreatedAt: row.CreatedAt.Time})
+	}
+	writeJSON(w, 200, map[string]any{"versions": versions})
+}
+
+type projectTopic struct {
+	ConclusionConfirmedAt string    `json:"conclusion_confirmed_at"`
+	ConclusionCutoff      string    `json:"conclusion_cutoff"`
+	DiscussionIssueID     string    `json:"discussion_issue_id"`
+	ConclusionRevision    int       `json:"conclusion_revision"`
+	ConclusionDraft       string    `json:"conclusion_draft"`
+	DraftRevision         int       `json:"draft_revision"`
+	ID                    string    `json:"id"`
+	Title                 string    `json:"title"`
+	Status                string    `json:"status"`
+	Conclusion            string    `json:"conclusion"`
+	IssueIDs              []string  `json:"issue_ids"`
+	CreatedBy             string    `json:"created_by"`
+	CreatedAt             time.Time `json:"created_at"`
+}
+type projectMessage struct {
+	ID        string    `json:"id"`
+	Content   string    `json:"content"`
+	CreatedBy string    `json:"created_by"`
+	CreatedAt time.Time `json:"created_at"`
+}
diff --git a/server/internal/handler/project_blueprint_test.go b/server/internal/handler/project_blueprint_test.go
new file mode 100644
index 000000000..035fc7d40
--- /dev/null
+++ b/server/internal/handler/project_blueprint_test.go
@@ -0,0 +1,138 @@
+package handler
+
+import (
+	"context"
+	"github.com/multica-ai/multica/server/pkg/dbid"
+	"net/http"
+	"testing"
+
+	"github.com/multica-ai/multica/server/internal/projectplan"
+	"github.com/multica-ai/multica/server/internal/service"
+	"github.com/multica-ai/multica/server/internal/testutil"
+)
+
+func planRequest(t *testing.T, h http.HandlerFunc, projectID, method string, body any, status int, out any) {
+	t.Helper()
+	call := testutil.Call(t, h, withURLParam(newRequest(method, "/api/projects/"+projectID+"/blueprint/draft", body), "id", projectID)).Want(status)
+	if out != nil {
+		call.JSON(out)
+	}
+}
+func TestBlueprintPublishAtomicIdempotentNoDispatch(t *testing.T) {
+	p := dbfx.Project(t, "蓝图回归", testutil.Cols{"lead_type": "member", "lead_id": testUserID})
+	var env struct {
+		Draft service.BlueprintDraft `json:"draft"`
+	}
+	planRequest(t, testHandler.BlueprintDraft, p, "POST", nil, 200, &env)
+	issue := dbfx.Issue(t, "原任务", testutil.Cols{"status": "backlog", "description": "人工原文"})
+	if _, err := testPool.Exec(context.Background(), "UPDATE workspace SET issue_counter=(SELECT COALESCE(MAX(number),0) FROM issue WHERE workspace_id=$1) WHERE id=$1", testWorkspaceID); err != nil {
+		t.Fatal(err)
+	}
+	g := projectplan.Empty()
+	g.Nodes = []projectplan.Node{{ID: "new", Contract: projectplan.Contract{Title: "新任务", Requirements: "可验收交付"}}, {ID: "existing", IssueID: issue, Contract: projectplan.Contract{Title: "原任务"}}}
+	g.Edges = []projectplan.Edge{{ID: "dependency", From: "existing", To: "new", Handoff: "输入报告"}}
+	planRequest(t, testHandler.SaveBlueprintDraft, p, "PUT", map[string]any{"expected_revision": env.Draft.Revision, "graph": g}, 200, &env)
+	stale := env.Draft.Revision - 1
+	planRequest(t, testHandler.SaveBlueprintDraft, p, "PUT", map[string]any{"expected_revision": stale, "graph": g}, 409, nil)
+	var before int
+	testPool.QueryRow(context.Background(), "SELECT count(*) FROM agent_task_queue").Scan(&before)
+	body := map[string]any{"expected_revision": env.Draft.Revision, "base_version": 0, "request_id": "publish-once"}
+	var v, retry service.BlueprintVersion
+	planRequest(t, testHandler.PublishBlueprint, p, "POST", body, 200, &v)
+	planRequest(t, testHandler.PublishBlueprint, p, "POST", body, 200, &retry)
+	if v.ID != retry.ID || v.Number != 1 || len(v.Graph.Nodes) != 2 || v.Graph.Nodes[1].IssueID != issue {
+		t.Fatalf("identity/version mismatch: %#v %#v", v, retry)
+	}
+	var after, count int
+	testPool.QueryRow(context.Background(), "SELECT count(*) FROM agent_task_queue").Scan(&after)
+	testPool.QueryRow(context.Background(), "SELECT count(*) FROM issue WHERE project_id=$1", p).Scan(&count)
+	if before != after || count != 2 {
+		t.Fatalf("publication dispatched or duplicated tasks: before=%d after=%d issues=%d", before, after, count)
+	}
+	var description, status string
+	testPool.QueryRow(context.Background(), "SELECT description,status FROM issue WHERE id=$1", v.Graph.Nodes[0].IssueID).Scan(&description, &status)
+	if projectplan.Requirements(description) != "可验收交付" || status != "backlog" {
+		t.Fatal("delivery contract not stored in backlog task")
+	}
+	// A failed multi-issue publish must not leak its earlier inserts or version.
+	planRequest(t, testHandler.BlueprintDraft, p, "POST", nil, 200, &env)
+	env.Draft.Graph.Nodes = append(env.Draft.Graph.Nodes, projectplan.Node{ID: "new2", Contract: projectplan.Contract{Title: "第二个"}}, projectplan.Node{ID: "new3", Contract: projectplan.Contract{Title: "第三个"}})
+	planRequest(t, testHandler.SaveBlueprintDraft, p, "PUT", map[string]any{"expected_revision": env.Draft.Revision, "graph": env.Draft.Graph}, 200, &env)
+	_, err := testPool.Exec(context.Background(), `CREATE OR REPLACE FUNCTION fail_blueprint_test() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.title='第三个' THEN RAISE EXCEPTION 'injected publication failure'; END IF; RETURN NEW; END $$; CREATE TRIGGER fail_blueprint_test BEFORE INSERT ON issue FOR EACH ROW EXECUTE FUNCTION fail_blueprint_test()`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		testPool.Exec(context.Background(), "DROP TRIGGER IF EXISTS fail_blueprint_test ON issue; DROP FUNCTION IF EXISTS fail_blueprint_test()")
+	})
+	planRequest(t, testHandler.PublishBlueprint, p, "POST", map[string]any{"expected_revision": env.Draft.Revision, "base_version": 1, "request_id": "fail"}, 500, nil)
+	testPool.QueryRow(context.Background(), "SELECT count(*) FROM issue WHERE project_id=$1", p).Scan(&count)
+	if count != 2 {
+		t.Fatalf("orphan issues after rollback: %d", count)
+	}
+	var versions int
+	testPool.QueryRow(context.Background(), "SELECT count(*) FROM project_blueprint_version WHERE project_id=$1", p).Scan(&versions)
+	if versions != 1 {
+		t.Fatal("failed publication changed version")
+	}
+	t.Cleanup(func() {
+		testPool.Exec(context.Background(), "DELETE FROM project_blueprint_version WHERE project_id=$1", p)
+		testPool.Exec(context.Background(), "DELETE FROM project_blueprint_draft WHERE project_id=$1", p)
+		testPool.Exec(context.Background(), "DELETE FROM issue WHERE project_id=$1", p)
+	})
+}
+
+func TestBlueprintRequirementsSyncPublishPreservesSnapshot(t *testing.T) {
+	ctx := context.Background()
+	p, topic, _ := discussionFixture(t)
+	discussionCall(t, testHandler.ProjectTopicMessages, p, topic, "PATCH", map[string]any{"conclusion": "确认快照", "expected_revision": 0}, 200, nil)
+	issue := dbfx.Issue(t, "已有正文", testutil.Cols{"description": "原始任务要求", "project_id": p})
+	discussionCall(t, testHandler.ProjectTopicFollowups, p, topic, "POST", map[string]any{"request_id": uuidToString(dbid.NewV7()), "revision": 1, "kind": "link", "issue_id": issue}, 200, nil)
+	suffix := "\n\n采用的话题结论：\n确认快照"
+	if _, err := testPool.Exec(ctx, "UPDATE issue SET description=$2 WHERE id=$1", issue, "原始任务要求"+suffix); err != nil {
+		t.Fatal(err)
+	}
+	var env struct {
+		Draft service.BlueprintDraft `json:"draft"`
+	}
+	planRequest(t, testHandler.BlueprintDraft, p, "POST", nil, 200, &env)
+	g := projectplan.Empty()
+	g.Nodes = []projectplan.Node{{ID: "existing", IssueID: issue, Contract: projectplan.Contract{Title: "已有正文", Requirements: "原始任务要求"}}}
+	planRequest(t, testHandler.SaveBlueprintDraft, p, "PUT", map[string]any{"expected_revision": env.Draft.Revision, "graph": g}, 200, &env)
+	if env.Draft.Graph.Nodes[0].Baseline.Requirements != "原始任务要求" {
+		t.Fatal("adopted snapshot leaked into requirements")
+	}
+	env.Draft.Graph.Nodes[0].Requirements = "蓝图人工修改"
+	if _, err := testPool.Exec(ctx, "UPDATE issue SET due_date='2026-11-20' WHERE id=$1", issue); err != nil {
+		t.Fatal(err)
+	}
+	planRequest(t, testHandler.SaveBlueprintDraft, p, "PUT", map[string]any{"expected_revision": env.Draft.Revision, "graph": env.Draft.Graph, "refresh_baseline": true}, 200, &env)
+	if n := env.Draft.Graph.Nodes[0]; n.Requirements != "蓝图人工修改" || n.DueDate != "2026-11-20" {
+		t.Fatalf("lost disjoint edit: %+v", n)
+	}
+	var version service.BlueprintVersion
+	planRequest(t, testHandler.PublishBlueprint, p, "POST", map[string]any{"expected_revision": env.Draft.Revision, "base_version": 0, "request_id": "ux10-publish"}, 200, &version)
+	var description string
+	if err := testPool.QueryRow(ctx, "SELECT description FROM issue WHERE id=$1", issue).Scan(&description); err != nil {
+		t.Fatal(err)
+	}
+	if description != "蓝图人工修改"+suffix {
+		t.Fatalf("duplicated body or lost snapshot: %q", description)
+	}
+	planRequest(t, testHandler.BlueprintDraft, p, "POST", nil, 200, &env)
+	if env.Draft.Graph.Nodes[0].Requirements != "蓝图人工修改" {
+		t.Fatal("reopened requirements mismatch")
+	}
+	env.Draft.Graph.Nodes[0].Requirements = "第二次人工修改"
+	if _, err := testPool.Exec(ctx, "UPDATE issue SET description=$2 WHERE id=$1", issue, "任务侧同时修改"+suffix); err != nil {
+		t.Fatal(err)
+	}
+	planRequest(t, testHandler.SaveBlueprintDraft, p, "PUT", map[string]any{"expected_revision": env.Draft.Revision, "graph": env.Draft.Graph, "refresh_baseline": true}, 409, nil)
+	var unchanged struct {
+		Draft service.BlueprintDraft `json:"draft"`
+	}
+	planRequest(t, testHandler.BlueprintDraft, p, "GET", nil, 200, &unchanged)
+	if unchanged.Draft.Revision != env.Draft.Revision {
+		t.Fatal("conflict changed saved draft")
+	}
+}
diff --git a/server/internal/handler/project_conclusion.go b/server/internal/handler/project_conclusion.go
new file mode 100644
index 000000000..5af8bd141
--- /dev/null
+++ b/server/internal/handler/project_conclusion.go
@@ -0,0 +1,273 @@
+package handler
+
+import (
+	"github.com/go-chi/chi/v5"
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/multica-ai/multica/server/internal/service"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+	"net/http"
+	"strings"
+	"time"
+)
+
+func (h *Handler) updateTopicConclusion(w http.ResponseWriter, r *http.Request, p db.Project, user pgtype.UUID, role string, id, author pgtype.UUID, status string, conclusion *string, expected *int, draft *string, expectedDraft *int) {
+	if author != user && !(p.LeadType.String == "member" && p.LeadID == user) && !roleAllowed(role, "owner", "admin") {
+		writeError(w, 403, "仅话题作者、项目负责人或管理员可以整理结论")
+		return
+	}
+	if (status != "" && status != "open" && status != "resolved") || (conclusion != nil && (len(*conclusion) > 10000 || strings.TrimSpace(*conclusion) == "")) || (draft != nil && len(*draft) > 10000) {
+		writeError(w, 422, "话题状态或结论无效")
+		return
+	}
+	tx, err := h.TxStarter.Begin(r.Context())
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	defer tx.Rollback(r.Context())
+	var revision, dr int
+	var previous string
+	if err = tx.QueryRow(r.Context(), `SELECT conclusion_revision,draft_revision,conclusion FROM project_topic WHERE id=$1 AND workspace_id=$2 FOR UPDATE`, id, p.WorkspaceID).Scan(&revision, &dr, &previous); err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if (conclusion != nil && (expected == nil || *expected != revision)) || (draft != nil && (expectedDraft == nil || *expectedDraft != dr)) {
+		writeError(w, 409, "结论已被更新，请保留本地文字并重新核对版本")
+		return
+	}
+	if status != "" {
+		_, err = tx.Exec(r.Context(), `UPDATE project_topic SET status=$2,updated_at=now() WHERE id=$1`, id, status)
+	}
+	if err == nil && conclusion != nil && *conclusion != previous {
+		revision++
+		_, err = tx.Exec(r.Context(), `INSERT INTO project_topic_conclusion(topic_id,revision,content,confirmed_by,message_cutoff) VALUES($1,$2,$3,$4,now())`, id, revision, *conclusion, user)
+		if err == nil {
+			_, err = tx.Exec(r.Context(), `UPDATE project_topic SET conclusion=$2,conclusion_revision=$3,updated_at=now() WHERE id=$1`, id, *conclusion, revision)
+		}
+	}
+	if err == nil && draft != nil {
+		_, err = tx.Exec(r.Context(), `UPDATE project_topic SET conclusion_draft=$2,draft_revision=draft_revision+1,updated_at=now() WHERE id=$1`, id, *draft)
+	}
+	if err == nil {
+		err = tx.Commit(r.Context())
+	}
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	h.projectChanged(r, p)
+	writeJSON(w, 200, map[string]bool{"ok": true})
+}
+
+type topicFollowup struct {
+	Implemented  bool      `json:"implemented"`
+	ID           string    `json:"id"`
+	Kind         string    `json:"kind"`
+	IssueID      string    `json:"issue_id"`
+	Title        string    `json:"title"`
+	Status       string    `json:"status"`
+	AssigneeID   string    `json:"assignee_id"`
+	AssigneeType string    `json:"assignee_type"`
+	DueDate      string    `json:"due_date"`
+	Revision     int       `json:"revision"`
+	Conclusion   string    `json:"conclusion"`
+	Description  string    `json:"description"`
+	CreatedAt    time.Time `json:"created_at"`
+}
+
+func (h *Handler) ProjectTopicFollowups(w http.ResponseWriter, r *http.Request) {
+	p, m, ok := h.projectAccess(w, r, r.Method != "GET", false)
+	if !ok {
+		return
+	}
+	id, ok := parseUUIDOrBadRequest(w, chi.URLParam(r, "topicId"), "topic_id")
+	if !ok {
+		return
+	}
+	var revision int
+	var conclusion string
+	var author pgtype.UUID
+	if err := h.DB.QueryRow(r.Context(), `SELECT conclusion_revision,conclusion,created_by FROM project_topic WHERE id=$1 AND project_id=$2 AND workspace_id=$3`, id, p.ID, p.WorkspaceID).Scan(&revision, &conclusion, &author); err != nil {
+		writeError(w, 404, "话题不存在")
+		return
+	}
+	if r.Method == "GET" {
+		rows, err := h.DB.Query(r.Context(), `SELECT f.id::text,f.kind,COALESCE(f.issue_id::text,''),COALESCE(i.title,''),COALESCE(i.status,''),COALESCE(i.assignee_id::text,''),COALESCE(i.assignee_type,''),COALESCE(i.due_date::text,''),f.conclusion_revision,c.content,f.description,f.created_at,EXISTS(SELECT 1 FROM project_topic_followup linked WHERE linked.topic_id=f.topic_id AND linked.conclusion_revision=f.conclusion_revision AND linked.issue_id IS NOT NULL AND linked.planning_request_id IS NOT NULL AND (f.planning_request_id IS NULL OR linked.planning_request_id=f.planning_request_id)) FROM project_topic_followup f JOIN project_topic_conclusion c ON c.topic_id=f.topic_id AND c.revision=f.conclusion_revision LEFT JOIN issue i ON i.id=f.issue_id AND i.workspace_id=$2 WHERE f.topic_id=$1 ORDER BY f.created_at`, id, p.WorkspaceID)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		defer rows.Close()
+		items := []topicFollowup{}
+		for rows.Next() {
+			var f topicFollowup
+			if err = rows.Scan(&f.ID, &f.Kind, &f.IssueID, &f.Title, &f.Status, &f.AssigneeID, &f.AssigneeType, &f.DueDate, &f.Revision, &f.Conclusion, &f.Description, &f.CreatedAt, &f.Implemented); err != nil {
+				planWriteError(w, err)
+				return
+			}
+			items = append(items, f)
+		}
+		if rows.Err() != nil {
+			planWriteError(w, rows.Err())
+			return
+		}
+		writeJSON(w, 200, map[string]any{"items": items})
+		return
+	}
+	var req struct {
+		RequestID     string   `json:"request_id"`
+		Revision      int      `json:"revision"`
+		Kind          string   `json:"kind"`
+		IssueID       string   `json:"issue_id"`
+		Title         string   `json:"title"`
+		Description   string   `json:"description"`
+		Status        string   `json:"status"`
+		AssigneeType  string   `json:"assignee_type"`
+		AssigneeID    string   `json:"assignee_id"`
+		DueDate       string   `json:"due_date"`
+		AttachmentIDs []string `json:"attachment_ids"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	fid, ok := parseUUIDOrBadRequest(w, req.RequestID, "request_id")
+	if !ok {
+		return
+	}
+	if req.Kind != "create" && req.Kind != "link" && req.Kind != "blueprint" && req.Kind != "record" {
+		writeError(w, 422, "请选择后续处理方式")
+		return
+	}
+	if len(req.Description) > 12000 || len(req.Title) > 500 {
+		writeError(w, 422, "内容过长")
+		return
+	}
+	tx, err := h.TxStarter.Begin(r.Context())
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	defer tx.Rollback(r.Context())
+	// Serialize duplicate clicks and validate the exact adopted revision under the same lock.
+	if err = tx.QueryRow(r.Context(), `SELECT conclusion_revision,conclusion FROM project_topic WHERE id=$1 FOR UPDATE`, id).Scan(&revision, &conclusion); err != nil {
+		planWriteError(w, err)
+		return
+	}
+	var existing string
+	if err = tx.QueryRow(r.Context(), `SELECT id::text FROM project_topic_followup WHERE id=$1 AND topic_id=$2 AND created_by=$3`, fid, id, m.UserID).Scan(&existing); err == nil {
+		writeJSON(w, 200, map[string]string{"id": existing})
+		return
+	}
+	if revision == 0 || revision != req.Revision {
+		writeError(w, 409, "请先确认并核对最新结论版本")
+		return
+	}
+	var issueID pgtype.UUID
+	if req.Kind == "create" {
+		if strings.TrimSpace(req.Title) == "" {
+			writeError(w, 422, "请填写后续任务名称")
+			return
+		}
+
+		status := req.Status
+		if status == "" {
+			status = "backlog"
+		}
+		status, ok = h.resolveIssueStatusKey(w, r, p.WorkspaceID, status)
+		if !ok {
+			return
+		}
+		assigneeType := pgtype.Text{String: req.AssigneeType, Valid: req.AssigneeType != ""}
+		var assigneeID pgtype.UUID
+		if req.AssigneeID != "" {
+			assigneeID, ok = parseUUIDOrBadRequest(w, req.AssigneeID, "assignee_id")
+			if !ok {
+				return
+			}
+		}
+		if code, msg := h.validateAssigneePair(r.Context(), r, uuidToString(p.WorkspaceID), assigneeType, assigneeID); code != 0 {
+			writeError(w, code, msg)
+			return
+		}
+		var due pgtype.Date
+		if req.DueDate != "" {
+			date, e := time.Parse("2006-01-02", req.DueDate)
+			if e != nil {
+				writeError(w, 422, "截止时间无效，请选择有效日期")
+				return
+			}
+			due = pgtype.Date{Time: date, Valid: true}
+		}
+		attachments := []pgtype.UUID{}
+		seen := map[string]bool{}
+		for _, value := range req.AttachmentIDs {
+			aid, valid := parseUUIDOrBadRequest(w, value, "attachment_id")
+			if !valid {
+				return
+			}
+			if seen[value] {
+				continue
+			}
+			seen[value] = true
+			var available bool
+			if e := tx.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM attachment WHERE id=$1 AND workspace_id=$2 AND uploader_type='member' AND uploader_id=$3 AND issue_id IS NULL AND comment_id IS NULL AND source_context_id IS NULL)`, aid, p.WorkspaceID, m.UserID).Scan(&available); e != nil {
+				planWriteError(w, e)
+				return
+			}
+			if !available {
+				writeError(w, 422, "附件不可用，请移除后重新上传；任务尚未创建")
+				return
+			}
+			attachments = append(attachments, aid)
+		}
+		result, e := h.IssueService.CreateInTransaction(r.Context(), tx, service.IssueCreateParams{WorkspaceID: p.WorkspaceID, ProjectID: p.ID, Title: req.Title, Description: pgtype.Text{String: req.Description, Valid: true}, Status: status, AssigneeType: assigneeType, AssigneeID: assigneeID, DueDate: due, Priority: "none", CreatorType: "member", CreatorID: m.UserID, AllowDuplicate: true})
+		if e != nil {
+			planWriteError(w, e)
+			return
+		}
+		issueID = result.Issue.ID
+		if len(attachments) > 0 {
+			linked, e := h.Queries.WithTx(tx).LinkAttachmentsToIssue(r.Context(), db.LinkAttachmentsToIssueParams{IssueID: issueID, WorkspaceID: p.WorkspaceID, AttachmentIds: attachments})
+			if e != nil {
+				planWriteError(w, e)
+				return
+			}
+			if linked.LinkedCount != int64(len(attachments)) {
+				writeError(w, 409, "附件已被其他操作使用，请重新上传；任务尚未创建")
+				return
+			}
+		}
+	} else if req.Kind == "link" {
+		issueID, ok = parseUUIDOrBadRequest(w, req.IssueID, "issue_id")
+		if !ok {
+			return
+		}
+		var valid bool
+		if err = tx.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM issue WHERE id=$1 AND workspace_id=$2 AND (project_id IS NULL OR project_id=$3) AND NOT(metadata ? 'project_topic_id'))`, issueID, p.WorkspaceID, p.ID).Scan(&valid); err != nil {
+			planWriteError(w, err)
+			return
+		}
+		if !valid {
+			writeError(w, 422, "任务不可访问或属于其他项目")
+			return
+		}
+		// Repeated linking of the same conclusion to the same task is idempotent across request IDs.
+		if e := tx.QueryRow(r.Context(), `SELECT id::text FROM project_topic_followup WHERE topic_id=$1 AND conclusion_revision=$2 AND issue_id=$3`, id, revision, issueID).Scan(&existing); e == nil {
+			writeJSON(w, 200, map[string]string{"id": existing})
+			return
+		}
+	}
+	_, err = tx.Exec(r.Context(), `INSERT INTO project_topic_followup(id,topic_id,conclusion_revision,kind,issue_id,description,created_by) VALUES($1,$2,$3,$4,$5,$6,$7)`, fid, id, revision, req.Kind, issueID, req.Description, m.UserID)
+	if err == nil && issueID.Valid {
+		_, err = tx.Exec(r.Context(), `UPDATE project_topic SET issue_ids=CASE WHEN $2=ANY(issue_ids) THEN issue_ids ELSE array_append(issue_ids,$2) END,updated_at=now() WHERE id=$1`, id, issueID)
+	}
+	if err == nil {
+		err = tx.Commit(r.Context())
+	}
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	h.projectChanged(r, p)
+	writeJSON(w, 200, map[string]string{"id": req.RequestID})
+}
