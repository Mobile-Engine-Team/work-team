+func TestWorkbenchDynamicPartialCancelAndNoPin(t *testing.T) {
+	f := testutil.New(testPool, testWorkspaceID, testUserID)
+	conv := f.Insert(t, "workbench_conversation", testutil.Cols{"workspace_id": testWorkspaceID, "owner_id": testUserID, "title": "partial"})
+	result := workbench.Result{View: workbench.View{SchemaVersion: 2}, Dynamic: workbench.NewDynamic(), RequestedModel: "deepseek-flash", Evidence: []workbench.Evidence{}}
+	msg := f.Insert(t, "workbench_message", testutil.Cols{"id": uuid.NewString(), "conversation_id": conv, "workspace_id": testWorkspaceID, "owner_id": testUserID, "prompt": "same", "status": "running", "result": benchJSON(result)})
+	testutil.Call(t, testHandler.WorkbenchPin, newRequest("POST", "/", map[string]string{"messageId": msg})).Want(404)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	testHandler.benchRuns.Store(msg, cancel)
+	defer testHandler.benchRuns.Delete(msg)
+	testutil.Call(t, testHandler.WorkbenchCancel, withURLParam(newRequest("POST", "/", nil), "id", msg)).Want(200)
+	if ctx.Err() == nil {
+		t.Fatal("runtime not cancelled")
+	}
+	var got benchMessage
+	testutil.Call(t, testHandler.WorkbenchMessage, withURLParam(newRequest("GET", "/", nil), "id", msg)).Want(200).JSON(&got)
+	if got.Status != "cancelled" || got.Result == nil || got.Result.Dynamic == nil {
+		t.Fatal("partial snapshot lost")
+	}
