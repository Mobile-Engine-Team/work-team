--- /dev/null
+++ b/server/internal/projectplan/suggestion_test.go
@@ -0,0 +1,44 @@
+package projectplan
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestSuggestionPreservesHumanChanges(t *testing.T) {
+	base := Empty()
+	base.Nodes = []Node{{ID: "a", Contract: Contract{Title: "原文"}}, {ID: "b", Contract: Contract{Title: "下游"}}}
+	base.Edges = []Edge{{ID: "edge", From: "a", To: "b", Handoff: "旧输入"}}
+	s := Suggestion{SchemaVersion: 1, Changes: []Change{{ID: "remove", Kind: "remove", Target: "a"}}}
+	current := base
+	current.Edges = []Edge{{ID: "edge", From: "a", To: "b", Handoff: "人修改的输入"}}
+	if _, err := ApplySuggestion(base, current, s, []string{"remove"}); err == nil {
+		t.Fatal("removed human-modified edge")
+	}
+	s.Changes = []Change{{ID: "remove", Kind: "remove_edge", Target: "edge"}}
+	if _, err := ApplySuggestion(base, current, s, []string{"remove"}); err == nil {
+		t.Fatal("deleted changed handoff")
+	}
+	raw := []byte(`{"schema_version":1,"changes":[{"id":"c","kind":"remove_edge","target":"e1"}]}`)
+	if _, err := ValidateSuggestion(raw, base, []string{"a"}); err == nil {
+		t.Fatal("edge outside selected scope accepted")
+	}
+	n := base.Nodes[0]
+	n.Title = "AI标题"
+	s.Changes = []Change{{ID: "update", Kind: "update", Target: "a", Node: &n}}
+	current = base
+	current.Nodes = append([]Node{}, base.Nodes...)
+	current.Nodes[0].Requirements = "人的要求"
+	result, err := ApplySuggestion(base, current, s, []string{"update"})
+	if err != nil || result.Nodes[0].Requirements != "人的要求" || result.Nodes[0].Title != "AI标题" {
+		t.Fatal("disjoint changes not preserved", err)
+	}
+	current.Nodes[0].Title = "人改的标题"
+	if _, err = ApplySuggestion(base, current, s, []string{"update"}); err == nil {
+		t.Fatal("conflicting human title overwritten")
+	}
+	encoded, _ := json.Marshal(Suggestion{SchemaVersion: 1, Changes: []Change{{ID: "cycle", Kind: "add_edge", Edge: &Edge{From: "n2", To: "n1"}}}})
+	if _, err = ValidateSuggestion(encoded, base, nil); err == nil {
+		t.Fatal("cycle accepted")
+	}
+}
