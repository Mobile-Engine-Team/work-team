new file mode 100644
index 000000000..e02815544
--- /dev/null
+++ b/server/migrations/618_project_run_input.up.sql
@@ -0,0 +1,25 @@
+-- Every issue-bound enqueue path captures its input at the common row boundary.
+-- No trigger schedules work or mutates a project or issue.
+CREATE FUNCTION capture_project_run_input() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE i issue%ROWTYPE; v project_blueprint_version%ROWTYPE; p project%ROWTYPE; n jsonb; inputs jsonb;
+BEGIN
+ IF TG_OP = 'UPDATE' THEN
+  IF OLD.context ? 'project_plan' THEN NEW.context = COALESCE(NEW.context,'{}'::jsonb) || jsonb_build_object('project_plan',OLD.context->'project_plan'); END IF;
+  RETURN NEW;
+ END IF;
+ IF NEW.issue_id IS NULL THEN RETURN NEW; END IF;
+ SELECT * INTO i FROM issue WHERE id=NEW.issue_id;
+ IF i.project_id IS NULL THEN RETURN NEW; END IF;
+ SELECT * INTO p FROM project WHERE id=i.project_id AND workspace_id=i.workspace_id;
+ SELECT * INTO v FROM project_blueprint_version WHERE project_id=i.project_id AND workspace_id=i.workspace_id ORDER BY number DESC LIMIT 1;
+ IF v.id IS NULL THEN RETURN NEW; END IF;
+ SELECT value INTO n FROM jsonb_array_elements(v.graph->'nodes') WHERE value->>'issue_id'=i.id::text LIMIT 1;
+ SELECT COALESCE(jsonb_agg(jsonb_build_object('issue_id',up.id,'title',up.title,'description',up.description,'status',up.status,'handoff',edge->>'handoff','attachments',COALESCE((SELECT jsonb_agg(jsonb_build_object('id',a.id,'filename',a.filename)) FROM attachment a WHERE a.issue_id=up.id),'[]'::jsonb))),'[]'::jsonb) INTO inputs
+ FROM jsonb_array_elements(v.graph->'edges') edge
+ JOIN jsonb_array_elements(v.graph->'nodes') upstream ON upstream->>'id'=edge->>'from'
+ JOIN issue up ON up.id::text=upstream->>'issue_id' AND up.workspace_id=i.workspace_id
+ WHERE edge->>'to'=n->>'id';
+ NEW.context=COALESCE(NEW.context,'{}'::jsonb)||jsonb_build_object('project_plan',jsonb_build_object('version_id',v.id,'version',v.number,'project_id',p.id,'project_title',p.title,'project_goal',p.description,'issue_id',i.id,'title',i.title,'description',i.description,'assignee_type',i.assignee_type,'assignee_id',i.assignee_id,'node',n,'inputs',inputs));
+ RETURN NEW;
+END $$;
+CREATE TRIGGER capture_project_run_input BEFORE INSERT OR UPDATE OF context ON agent_task_queue FOR EACH ROW EXECUTE FUNCTION capture_project_run_input();
