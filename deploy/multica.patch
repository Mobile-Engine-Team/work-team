+func TestDynamicFragmentedStreamReconcilesAndPersistsOnlyValidEvents(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node required for protocol fixture")
+	}
+	lines := []string{`{"type":"plan","plan":{"title":"Test","intent":"I","layout":"stack","sections":[{"id":"main","title":"Main","role":"primary"}]}}`, `{"type":"section","section":{"id":"main","dataRefs":["d1"],"facts":[],"surface":{"catalogId":"https://mobilework.local/catalog/answer/v1","components":[{"id":"root","component":"AnswerSummary","kind":"fact","text":"Supported","evidenceIds":["issue:a"]}]}}}`, `{"type":"final","sections":["main"],"limitations":[],"followUps":[]}`}
+	for _, tc := range []struct {
+		name, replace string
+		want          bool
+	}{{"fragmented", "", true}, {"unread", "private", false}, {"truncated", "truncate", false}, {"mismatch", "mismatch", false}, {"duplicate", "duplicate", false}, {"missing_final", "no_final", false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			text := strings.Join(lines, "\n")
+			switch tc.replace {
+			case "private":
+				text = strings.ReplaceAll(text, "issue:a", "private")
+			case "truncate":
+				text = text[:len(text)-8]
+			case "no_final":
+				text = strings.Join(lines[:2], "\n")
+			case "duplicate":
+				text += "\n" + lines[2]
+			}
+			encoded, _ := json.Marshal(text)
+			final := encoded
+			if tc.replace == "mismatch" {
+				final = []byte(`"different"`)
+			}
+			script := `import readline from 'node:readline';process.stdout.write(JSON.stringify({type:'runtime_ready'})+'\n');let id;const out=e=>process.stdout.write(JSON.stringify({runId:id,...e})+'\n');readline.createInterface({input:process.stdin}).on('line',l=>{const r=JSON.parse(l);if(r.type==='abort')out({type:'settled',error:'cancelled'});if(r.type==='run'){id=r.runId;out({type:'request',calls:1});out({type:'tool_request',callId:'q',query:{source:'issue'}})}if(r.type==='tool_result'&&r.callId==='q'){out({type:'attempt',attemptId:1});const text=` + string(encoded) + `;for(const ch of text)out({type:'text_delta',text:ch});out({type:'message_end',text:` + string(final) + `,stopReason:'stop'});out({type:'validate'})}if(r.callId==='verdict')out({type:'settled'})});`
+			path := filepath.Join(t.TempDir(), "fixture.mjs")
+			if err := os.WriteFile(path, []byte(script), 0600); err != nil {
+				t.Fatal(err)
+			}
+			pi := NewPi(PiConfig{Key: "fake", BaseURL: "http://127.0.0.1:1", Script: path})
+			defer pi.Close()
+			waitPiReady(t, pi)
+			c := Corpus{At: time.Now().UTC().Format(time.RFC3339), Records: []Evidence{{ID: "issue:a", Kind: "issue", ObjectID: "a", Text: `{}`, RelatedIDs: []string{}}}}
+			seq := 0
+			published := 0
+			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+			defer cancel()
+			r, err := GenerateDynamic(ctx, pi, c, "run", "mock", "user", "question", "", func(string) {}, func() error { return nil }, func(r Result) error {
+				if r.Dynamic.Seq <= seq {
+					t.Fatal("non-monotonic sequence")
+				}
+				seq = r.Dynamic.Seq
+				if len(r.Dynamic.Contents) > 0 {
+					published++
+				}
+				return nil
+			})
+			if r.Repairs != 0 {
+				t.Fatal("repair requested but never executed must not be counted")
+			}
+			if tc.replace == "no_final" && !strings.Contains(strings.Join(r.ValidationErrors, " "), "final") {
+				t.Fatal("missing final needs a concrete diagnostic")
+			}
+			if (err == nil) != tc.want {
+				t.Fatalf("err=%v complete=%v", err, r.Dynamic.Complete)
+			}
+			if tc.replace == "private" && published != 0 {
+				t.Fatal("unread content published")
+			}
+			if tc.want && published == 0 {
+				t.Fatal("no incremental content")
+			}
+		})
+	}
+}
+
+func TestDynamicRepairCollectsRegionErrorsAndKeepsLaterValidRegion(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node required")
+	}
+	plan := `{"type":"plan","plan":{"title":"Test","intent":"I","layout":"stack","sections":[{"id":"first","role":"primary"},{"id":"second","role":"primary"},{"id":"third","role":"secondary"}]}}`
+	section := func(id, evidence string) string {
+		return `{"type":"section","section":{"id":"` + id + `","dataRefs":["d1"],"surface":{"catalogId":"https://mobilework.local/catalog/answer/v1","components":[{"id":"root","component":"AnswerSummary","kind":"fact","text":"Supported ` + id + `","evidenceIds":["` + evidence + `"]}]}}}`
+	}
+	final := `{"type":"final","sections":["first","second","third"],"limitations":[],"followUps":[]}`
+	bad, _ := json.Marshal(strings.Join([]string{plan, section("first", "private1"), section("second", "private2"), section("third", "issue:a"), final}, "\n"))
+	fixed, _ := json.Marshal(strings.Join([]string{section("first", "issue:a"), section("second", "issue:a"), final}, "\n"))
+	script := `import readline from 'node:readline';process.stdout.write(JSON.stringify({type:'runtime_ready'})+'\n');let id;const out=e=>process.stdout.write(JSON.stringify({runId:id,...e})+'\n');const stream=(text,attemptId)=>{out({type:'attempt',attemptId});out({type:'text_delta',text});out({type:'message_end',text,stopReason:'stop'})};readline.createInterface({input:process.stdin}).on('line',l=>{const r=JSON.parse(l);if(r.type==='abort')out({type:'settled',error:'cancelled'});if(r.type==='run'){id=r.runId;out({type:'tool_request',callId:'q',query:{source:'issue'}})}if(r.callId==='q'){stream(` + string(bad) + `,1);out({type:'validate'})}if(r.callId==='verdict'){const repair=r.result.repair;if(!repair.includes('private1')||!repair.includes('private2')||!repair.includes('third')||r.result.allowTools!==false){out({type:'settled',error:'bad_diagnostics'});return}out({type:'repair'});stream(` + string(fixed) + `,2);out({type:'settled'})}});`
+	path := filepath.Join(t.TempDir(), "fixture.mjs")
+	if err := os.WriteFile(path, []byte(script), 0600); err != nil {
+		t.Fatal(err)
+	}
+	pi := NewPi(PiConfig{Key: "fake", BaseURL: "http://127.0.0.1:1", Script: path})
+	defer pi.Close()
+	waitPiReady(t, pi)
+	c := Corpus{At: time.Now().UTC().Format(time.RFC3339), Records: []Evidence{{ID: "issue:a", Kind: "issue", ObjectID: "a", Text: `{}`, RelatedIDs: []string{}}}}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	kept := false
+	r, err := GenerateDynamic(ctx, pi, c, "run", "mock", "u", "q", "", func(string) {}, func() error { return nil }, func(r Result) error {
+		if r.Dynamic.AttemptID == 1 && len(r.Dynamic.Sections) == 1 {
+			_, kept = r.Dynamic.Sections["third"]
+		}
+		return nil
+	})
+	if err != nil || !kept || !r.Dynamic.Complete || len(r.Dynamic.Sections) != 3 || r.Repairs != 1 {
+		t.Fatalf("err=%v kept=%v complete=%v sections=%d repairs=%d", err, kept, r.Dynamic.Complete, len(r.Dynamic.Sections), r.Repairs)
+	}
+}
+
+// A populated workspace must not turn unrelated conversation into forced retrieval.
+func TestDynamicGeneralAnswerWithoutRetrievalInPopulatedWorkspace(t *testing.T) {
+	lines := `{"type":"plan","plan":{"title":"笑话","intent":"讲个笑话","layout":"stack","sections":[{"id":"reply","role":"primary","surface":"plain"}]}}
+{"type":"section","section":{"id":"reply","dataRefs":[],"facts":[],"surface":{"catalogId":"https://mobilework.local/catalog/answer/v1","components":[{"id":"root","component":"Prose","body":"程序员去买菜，老板说：没有bug，只有葱。"}]}}}
+{"type":"final","sections":["reply"],"limitations":[],"followUps":[]}`
+	encoded, _ := json.Marshal(lines)
+	script := `import readline from 'node:readline';process.stdout.write(JSON.stringify({type:'runtime_ready'})+'\n');let id;const out=e=>process.stdout.write(JSON.stringify({runId:id,...e})+'\n');readline.createInterface({input:process.stdin}).on('line',l=>{const r=JSON.parse(l);if(r.type==='run'){id=r.runId;out({type:'request',calls:1});out({type:'attempt',attemptId:1});const text=` + string(encoded) + `;out({type:'text_delta',text});out({type:'message_end',text,stopReason:'stop'});out({type:'validate'})}if(r.callId==='verdict')out({type:'settled'});});`
+	path := filepath.Join(t.TempDir(), "general.mjs")
+	if err := os.WriteFile(path, []byte(script), 0600); err != nil {
+		t.Fatal(err)
+	}
+	pi := NewPi(PiConfig{Key: "fake", BaseURL: "http://127.0.0.1:1", Script: path})
+	defer pi.Close()
+	waitPiReady(t, pi)
+	c := Corpus{At: time.Now().UTC().Format(time.RFC3339), Records: []Evidence{{ID: "issue:private", Kind: "issue", Text: `{"title":"Private task"}`}}}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	r, err := GenerateDynamic(ctx, pi, c, "general", "mock", "user", "讲个笑话", "", func(string) {}, func() error { return nil }, func(Result) error { return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !r.Dynamic.Complete || len(r.Dynamic.Datasets) != 0 || len(r.Evidence) != 0 || r.Calls != 1 {
+		t.Fatalf("unexpected general answer: %+v", r)
+	}
+	// The stored surface retains the body for subsequent-turn history.
+	if !strings.Contains(string(r.Dynamic.Sections["reply"].Surface), "程序员") {
+		t.Fatal("body not persisted")
+	}
+}
+
+func TestDynamicRepairFeedbackRecoversEmptyAndDistributionAnswers(t *testing.T) {
+	for _, tc := range []struct{ name, bad, fixed, hint string }{
+		{"empty", `{"id":"root","component":"AnswerSummary","kind":"fact","text":"未见资料","evidenceIds":[]}`, `{"id":"root","component":"EmptyState","kind":"gap","gapType":"no_record","text":"本次检索范围内未见相关记录","evidenceIds":[]}`, "gapType"},
+		{"distribution", `{"id":"root","component":"Stat","label":"负责人","value":{"@path":"/facts/owners/value"}}`, `{"id":"root","component":"Distribution","title":"负责人","data":{"@path":"/facts/owners/value"},"variant":"bars"}`, "Distribution.data"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			plan := `{"type":"plan","plan":{"title":"Test","intent":"I","layout":"stack","sections":[{"id":"main","role":"primary"}]}}`
+			section := func(node string) string {
+				return `{"type":"section","section":{"id":"main","dataRefs":["d1"],"facts":[{"id":"owners","datasetId":"d1","op":"distribution","field":"assigneeName"}],"surface":{"catalogId":"https://mobilework.local/catalog/answer/v1","components":[` + node + `]}}}`
+			}
+			final := `{"type":"final","sections":["main"],"limitations":[],"followUps":[]}`
+			bad, _ := json.Marshal(plan + "\n" + section(tc.bad) + "\n" + final)
+			fixed, _ := json.Marshal(section(tc.fixed) + "\n" + final)
+			hint, _ := json.Marshal(tc.hint)
+			script := `import readline from 'node:readline';process.stdout.write(JSON.stringify({type:'runtime_ready'})+'\n');let id;const out=e=>process.stdout.write(JSON.stringify({runId:id,...e})+'\n');const stream=(text,attemptId)=>{out({type:'attempt',attemptId});out({type:'text_delta',text});out({type:'message_end',text,stopReason:'stop'})};readline.createInterface({input:process.stdin}).on('line',l=>{const r=JSON.parse(l);if(r.type==='run'){id=r.runId;out({type:'tool_request',callId:'q',query:{source:'issue'}})}if(r.callId==='q'){stream(` + string(bad) + `,1);out({type:'validate'})}if(r.callId==='verdict'){const repair=r.result.repair;if(!repair.includes('section=main')||!repair.includes('root')||!repair.includes(` + string(hint) + `)||r.result.allowTools!==false){out({type:'settled',error:'missing actionable guidance'});return}out({type:'repair'});stream(` + string(fixed) + `,2);out({type:'settled'})}});`
+			path := filepath.Join(t.TempDir(), "fixture.mjs")
+			if err := os.WriteFile(path, []byte(script), 0600); err != nil {
+				t.Fatal(err)
+			}
+			pi := NewPi(PiConfig{Key: "fake", BaseURL: "http://127.0.0.1:1", Script: path})
+			defer pi.Close()
+			waitPiReady(t, pi)
+			c := Corpus{At: time.Now().UTC().Format(time.RFC3339), Records: []Evidence{}}
+			if tc.name == "distribution" {
+				c.Records = []Evidence{{ID: "issue:a", Kind: "issue", ObjectID: "a", Text: `{"assigneeName":"A"}`, RelatedIDs: []string{}}}
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+			defer cancel()
+			r, err := GenerateDynamic(ctx, pi, c, "repair-test", "mock", "u", "q", "", func(string) {}, func() error { return nil }, func(Result) error { return nil })
+			if err != nil || !r.Dynamic.Complete || r.Repairs != 1 || len(r.Dynamic.Sections) != 1 {
+				t.Fatalf("repair failed: err=%v errors=%v", err, r.ValidationErrors)
+			}
+		})
+	}
+}
