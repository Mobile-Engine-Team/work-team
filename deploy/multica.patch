diff --git a/server/internal/workbench/catalog_surface.go b/server/internal/workbench/catalog_surface.go
new file mode 100644
index 000000000..29a5a733d
--- /dev/null
+++ b/server/internal/workbench/catalog_surface.go
@@ -0,0 +1,172 @@
+package workbench
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+const answerCatalog = "https://mobilework.local/catalog/answer/v1"
+
+type surfaceComponent struct {
+	ID        string                     `json:"id"`
+	Component string                     `json:"component"`
+	Props     map[string]json.RawMessage `json:"props"`
+	Children  []string                   `json:"children"`
+}
+
+var catalogProps = map[string][]string{
+	"Stack": {"gap", "padding", "tone", "surface", "direction", "align"}, "Split": {},
+	"Brief": {"id", "label"}, "Panel": {"label", "description", "tone"}, "Comparison": {},
+	"Record": {"datasetId", "rowId"}, "CheckItem": {"id", "label"}, "Feedback": {"datasetId", "rowIds"},
+	"Claim": {"id", "variant"}, "Fact": {"id", "label", "variant"},
+	"Field": {"datasetId", "rowId", "field", "label", "variant"},
+	"Table": {"datasetId", "fields", "rowIds", "label", "variant"}, "List": {"datasetId", "fields", "rowIds", "label"},
+	"Timeline": {"datasetId", "fields", "rowIds", "label"}, "BarChart": {"factId", "label"},
+	"Collapse": {"label"}, "Entity": {"id", "variant"}, "Evidence": {"id"}, "Action": {"kind", "value", "label"},
+}
+
+func (d *Dynamic) validateSurface(raw json.RawMessage, c Content, read map[string]Evidence) error {
+	var surface struct {
+		CatalogID  string             `json:"catalogId"`
+		Components []surfaceComponent `json:"components"`
+	}
+	if len(raw) > 32000 || strict(raw, &surface) != nil || surface.CatalogID != answerCatalog || len(surface.Components) < 1 || len(surface.Components) > 120 {
+		return fmt.Errorf("invalid catalog surface")
+	}
+	nodes := map[string]surfaceComponent{}
+	displayed := map[string]bool{}
+	for _, node := range surface.Components {
+		allowed, ok := catalogProps[node.Component]
+		if !ok || !idPattern.MatchString(node.ID) || nodes[node.ID].ID != "" || len(node.Children) > 80 {
+			return fmt.Errorf("invalid catalog component %s", node.ID)
+		}
+		for key := range node.Props {
+			if !contains(allowed, key) {
+				return fmt.Errorf("unsupported %s prop %s", node.Component, key)
+			}
+		}
+		str := func(key string) string { var v string; _ = json.Unmarshal(node.Props[key], &v); return v }
+		for _, key := range []string{"label", "description"} {
+			if len(str(key)) > 540 {
+				return fmt.Errorf("catalog label too long")
+			}
+		}
+		switch node.Component {
+		case "Brief", "Claim", "CheckItem":
+			id := str("id")
+			found := false
+			for _, cl := range c.Claims {
+				if cl.ID == id {
+					found = true
+				}
+			}
+			if !found || displayed[id] {
+				return fmt.Errorf("unknown or repeated catalog claim %s", id)
+			}
+			if node.Component == "CheckItem" && d.Claims[id].Kind != "gap" && d.Claims[id].Kind != "suggestion" {
+				return fmt.Errorf("check item needs gap or suggestion")
+			}
+			displayed[id] = true
+		case "Field", "Record", "Table", "List", "Timeline", "Feedback":
+			ds, ok := d.Datasets[str("datasetId")]
+			if !ok || !contains(c.DataRefs, ds.ID) {
+				return fmt.Errorf("unknown catalog dataset")
+			}
+			if node.Component == "Field" || node.Component == "Record" {
+				found := false
+				for _, r := range ds.Rows {
+					if r["id"] == str("rowId") {
+						if node.Component == "Record" {
+							found = r["kind"] == "issue"
+						} else {
+							_, found = r[str("field")]
+						}
+					}
+				}
+				if !found {
+					return fmt.Errorf("unknown catalog row or field")
+				}
+			}
+			var rowIDs []string
+			if v, ok := node.Props["rowIds"]; ok {
+				if json.Unmarshal(v, &rowIDs) != nil || len(rowIDs) > 80 {
+					return fmt.Errorf("invalid row ids")
+				}
+				for _, id := range rowIDs {
+					found := false
+					for _, r := range ds.Rows {
+						if r["id"] == id {
+							found = true
+						}
+					}
+					if !found {
+						return fmt.Errorf("unknown selected row")
+					}
+				}
+			}
+			if node.Component == "Feedback" {
+				for _, r := range ds.Rows {
+					if len(rowIDs) == 0 || contains(rowIDs, fmt.Sprint(r["id"])) {
+						if r["kind"] != "comment" && r["kind"] != "topic" {
+							return fmt.Errorf("feedback requires member records")
+						}
+					}
+				}
+			}
+		case "Entity", "Evidence":
+			if _, ok := read[str("id")]; !ok {
+				return fmt.Errorf("unknown catalog evidence")
+			}
+		case "Fact":
+			if _, ok := d.Facts[str("id")]; !ok {
+				return fmt.Errorf("unknown catalog fact")
+			}
+		case "BarChart":
+			if d.Facts[str("factId")].Binding.Op != "groupCount" {
+				return fmt.Errorf("invalid chart fact")
+			}
+		case "Action":
+			if str("kind") == "evidence" {
+				if _, ok := read[str("value")]; !ok {
+					return fmt.Errorf("unknown action evidence")
+				}
+			} else if str("kind") != "followUp" {
+				return fmt.Errorf("invalid action")
+			}
+		}
+		nodes[node.ID] = node
+	}
+	visited := map[string]bool{}
+	var visit func(string, int) error
+	visit = func(id string, depth int) error {
+		node, ok := nodes[id]
+		if !ok || visited[id] || depth > 16 {
+			return fmt.Errorf("invalid catalog graph")
+		}
+		visited[id] = true
+		if node.Component == "Split" && len(node.Children) != 2 {
+			return fmt.Errorf("split needs main and sidebar")
+		}
+		for _, child := range node.Children {
+			if node.Component == "Comparison" && nodes[child].Component != "Record" && nodes[child].Component != "CheckItem" {
+				return fmt.Errorf("comparison needs record or gap rows")
+			}
+			if err := visit(child, depth+1); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := visit("root", 0); err != nil {
+		return err
+	}
+	if len(visited) != len(nodes) {
+		return fmt.Errorf("unreachable catalog nodes")
+	}
+	for _, cl := range c.Claims {
+		if !displayed[cl.ID] {
+			return fmt.Errorf("catalog missing claim %s", cl.ID)
+		}
+	}
+	return nil
+}
diff --git a/server/internal/workbench/catalog_surface_test.go b/server/internal/workbench/catalog_surface_test.go
new file mode 100644
index 000000000..f4ba7ffb5
--- /dev/null
+++ b/server/internal/workbench/catalog_surface_test.go
@@ -0,0 +1,62 @@
+package workbench
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestCatalogSurfaceValidationAndPersistence(t *testing.T) {
+	fresh := func() *Dynamic {
+		d := NewDynamic()
+		for _, line := range []string{`{"type":"plan","plan":{"title":"T","intent":"I","layout":"stack","sections":[{"id":"main","title":"","role":"primary"}]}}`, `{"type":"content","content":{"sectionId":"main","claims":[{"id":"gap","kind":"gap","gapType":"no_record","text":"No records"}],"facts":[],"dataRefs":[]}}`} {
+			if err := d.Apply(line, nil); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return d
+	}
+	valid := `{"type":"section","section":{"id":"main","surface":{"catalogId":"https://mobilework.local/catalog/answer/v1","components":[{"id":"root","component":"Brief","props":{"id":"gap"},"children":[]}]},"contentRefs":["gap"]}}`
+	d := fresh()
+	if err := d.Apply(valid, nil); err != nil {
+		t.Fatal(err)
+	}
+	if d.Sections["main"].JS != "" || d.Sections["main"].SDK != "workbench-catalog@1" {
+		t.Fatal("catalog ran through compiler")
+	}
+	raw, err := json.Marshal(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var restored Dynamic
+	if err = json.Unmarshal(raw, &restored); err != nil {
+		t.Fatal(err)
+	}
+	if string(restored.Sections["main"].Surface) != string(d.Sections["main"].Surface) {
+		t.Fatal("surface lost in persistence")
+	}
+	next := NewDynamic()
+	next.Plan = d.Plan
+	next.reuse = &restored
+	if err = next.reuseRegion("main", d.Sections["main"].Hash); err != nil {
+		t.Fatal(err)
+	}
+	if string(next.Sections["main"].Surface) != string(d.Sections["main"].Surface) {
+		t.Fatal("surface lost in reuse")
+	}
+	for name, line := range map[string]string{
+		"remote catalog":   strings.Replace(valid, "mobilework.local/catalog/answer/v1", "unknown.local/x", 1),
+		"unknown claim":    strings.Replace(valid, `"props":{"id":"gap"}`, `"props":{"id":"private"}`, 1),
+		"script":           strings.Replace(valid, `"component":"Brief"`, `"component":"script"`, 1),
+		"url":              strings.Replace(valid, `"props":{"id":"gap"}`, `"props":{"id":"gap","url":"https://evil"}`, 1),
+		"cycle":            strings.Replace(valid, `"children":[]`, `"children":["root"]`, 1),
+		"missing child":    strings.Replace(valid, `"children":[]`, `"children":["missing"]`, 1),
+		"executable mixed": strings.Replace(valid, `"id":"main","surface"`, `"id":"main","code":"fetch()","surface"`, 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if fresh().Apply(line, nil) == nil {
+				t.Fatal("accepted invalid surface")
+			}
+		})
+	}
+}
diff --git a/server/internal/workbench/contract.go b/server/internal/workbench/contract.go
new file mode 100644
index 000000000..53389585f
--- /dev/null
+++ b/server/internal/workbench/contract.go
@@ -0,0 +1,121 @@
+package workbench
+
+import (
+	_ "embed"
+	"encoding/json"
+	"fmt"
+	"github.com/santhosh-tekuri/jsonschema/v6"
+)
+
+//go:embed view.schema.json
+var SchemaJSON string
+var schema = func() *jsonschema.Schema {
+	var document any
+	if err := json.Unmarshal([]byte(SchemaJSON), &document); err != nil {
+		panic(err)
+	}
+	c := jsonschema.NewCompiler()
+	if err := c.AddResource("view.json", document); err != nil {
+		panic(err)
+	}
+	return c.MustCompile("view.json")
+}()
+
+type Query struct {
+	Source    string `json:"source"`
+	ProjectID string `json:"projectId,omitempty"`
+	Status    string `json:"status,omitempty"`
+	Text      string `json:"text,omitempty"`
+	RelatedID string `json:"relatedId,omitempty"`
+	Offset    int    `json:"offset,omitempty"`
+	Limit     int    `json:"limit,omitempty"`
+}
+type Item struct {
+	Cells       []string `json:"cells,omitempty"`
+	Title       string   `json:"title"`
+	Text        string   `json:"text,omitempty"`
+	Value       string   `json:"value,omitempty"`
+	Group       string   `json:"group,omitempty"`
+	EvidenceIDs []string `json:"evidenceIds"`
+}
+type Block struct {
+	Type        string   `json:"type"`
+	Title       string   `json:"title"`
+	Text        string   `json:"text,omitempty"`
+	Columns     []string `json:"columns,omitempty"`
+	Items       []Item   `json:"items"`
+	EvidenceIDs []string `json:"evidenceIds"`
+}
+type View struct {
+	SchemaVersion int      `json:"schemaVersion"`
+	Title         string   `json:"title"`
+	Intent        string   `json:"intent"`
+	Queries       []Query  `json:"queries"`
+	TimeSensitive bool     `json:"timeSensitive,omitempty"`
+	Semantic      bool     `json:"semantic"`
+	Blocks        []Block  `json:"blocks"`
+	Limitations   []string `json:"limitations"`
+}
+type Evidence struct {
+	ID         string   `json:"id"`
+	Kind       string   `json:"kind"`
+	ObjectID   string   `json:"objectId"`
+	ProjectID  string   `json:"projectId"`
+	TopicID    string   `json:"topicId,omitempty"`
+	IssueID    string   `json:"issueId"`
+	Title      string   `json:"title"`
+	Text       string   `json:"text"`
+	Status     string   `json:"status"`
+	Version    string   `json:"version"`
+	UpdatedAt  string   `json:"updatedAt"`
+	RelatedIDs []string `json:"relatedIds"`
+}
+type Result struct {
+	FirstTokenMS     int64      `json:"firstTokenMs,omitempty"`
+	RetrievalMS      int64      `json:"retrievalMs,omitempty"`
+	ValidationErrors []string   `json:"validationErrors,omitempty"`
+	Dynamic          *Dynamic   `json:"dynamic,omitempty"`
+	RequestedModel   string     `json:"requestedModel,omitempty"`
+	Provider         string     `json:"provider,omitempty"`
+	Runtime          string     `json:"runtime,omitempty"`
+	ElapsedMS        int64      `json:"elapsedMs,omitempty"`
+	Repairs          int        `json:"repairs,omitempty"`
+	Stale            bool       `json:"stale,omitempty"`
+	View             View       `json:"view"`
+	Evidence         []Evidence `json:"evidence"`
+	Fingerprint      string     `json:"fingerprint"`
+	GeneratedAt      string     `json:"generatedAt"`
+	Model            string     `json:"model"`
+	Calls            int        `json:"calls"`
+	InputTokens      int64      `json:"inputTokens"`
+	OutputTokens     int64      `json:"outputTokens"`
+}
+
+func ParseView(raw string, evidence map[string]Evidence) (View, error) {
+	var value any
+	var view View
+	if err := json.Unmarshal([]byte(raw), &value); err != nil {
+		return view, err
+	}
+	if err := schema.Validate(value); err != nil {
+		return view, err
+	}
+	if err := json.Unmarshal([]byte(raw), &view); err != nil {
+		return view, err
+	}
+	for _, b := range view.Blocks {
+		refs := append([]string{}, b.EvidenceIDs...)
+		for _, i := range b.Items {
+			refs = append(refs, i.EvidenceIDs...)
+			if b.Type == "table" && len(b.Columns) > 0 && len(i.Cells) != len(b.Columns) {
+				return view, fmt.Errorf("table cells must match columns")
+			}
+		}
+		for _, id := range refs {
+			if _, ok := evidence[id]; !ok {
+				return view, fmt.Errorf("unknown evidence: %s", id)
+			}
+		}
+	}
+	return view, nil
+}
