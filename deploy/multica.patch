@@ -0,0 +1,53 @@
+package projectplan
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestGraphValidation(t *testing.T) {
+	a, b := Node{ID: "a", Contract: Contract{Title: "A"}}, Node{ID: "b", Contract: Contract{Title: "B"}}
+	cases := []struct {
+		name  string
+		g     Graph
+		valid bool
+	}{
+		{"empty", Empty(), true}, {"isolated", Graph{1, []Node{a, b}, []Edge{}}, true},
+		{"dag", Graph{1, []Node{a, b}, []Edge{{ID: "ab", From: "a", To: "b"}}}, true},
+		{"self", Graph{1, []Node{a}, []Edge{{ID: "aa", From: "a", To: "a"}}}, false},
+		{"cycle", Graph{1, []Node{a, b}, []Edge{{ID: "ab", From: "a", To: "b"}, {ID: "ba", From: "b", To: "a"}}}, false},
+		{"unknown", Graph{1, []Node{a}, []Edge{{ID: "ab", From: "a", To: "b"}}}, false},
+		{"duplicate", Graph{1, []Node{a, b}, []Edge{{ID: "ab", From: "a", To: "b"}, {ID: "ab2", From: "a", To: "b"}}}, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if err := c.g.Validate(); (err == nil) != c.valid {
+				t.Fatalf("valid=%v error=%v", c.valid, err)
+			}
+		})
+	}
+}
+func TestRequirementsPreserveHumanText(t *testing.T) {
+	original := "用户原始说明\n\n保留附件引用"
+	first := WithRequirements(original, "初始交付")
+	second := WithRequirements(first, "新版交付")
+	if Requirements(second) != "新版交付" || Requirements(WithRequirements(second, "")) != "" || !strings.HasPrefix(second, original) {
+		t.Fatal("overwrote human description")
+	}
+}
+
+func TestDependencyMeaningIgnoresEditorOrderAndIDs(t *testing.T) {
+	a := []Edge{{ID: "one", From: "a", To: "b", Handoff: "验收清单"}, {ID: "two", From: "b", To: "c"}}
+	b := []Edge{{ID: "regenerated", From: "b", To: "c"}, {ID: "other", From: "a", To: "b", Handoff: "验收清单"}}
+	if !SameDependencies(a, b) {
+		t.Fatal("editor-only changes reported as dependencies")
+	}
+	b[1].Handoff = "新交付要求"
+	if SameDependencies(a, b) {
+		t.Fatal("handoff change was lost")
+	}
+	b[1] = b[0]
+	if SameDependencies(a, b) {
+		t.Fatal("different dependencies treated as equal")
+	}
+}
diff --git a/server/internal/projectplan/requirements.go b/server/internal/projectplan/requirements.go
new file mode 100644
index 000000000..297604acc
--- /dev/null
+++ b/server/internal/projectplan/requirements.go
@@ -0,0 +1,65 @@
+package projectplan
+
+import (
+	"fmt"
+	"strings"
+)
+
+// TaskRequirementsBody removes only verified historical adopted snapshots.
+func TaskRequirementsBody(description string, adopted []string) string {
+	for {
+		changed := false
+		for _, content := range adopted {
+			suffix := "\n\n采用的话题结论：\n" + content
+			if strings.HasSuffix(description, suffix) {
+				description = strings.TrimSuffix(description, suffix)
+				changed = true
+				break
+			}
+		}
+		if !changed {
+			return description
+		}
+	}
+}
+
+// PublishRequirements edits the same field that supplied the imported contract.
+// Existing marked blocks keep their separate human input; plain tasks replace
+// their body, retaining any verified adopted snapshot suffix verbatim.
+func PublishRequirements(base Baseline, requirements string) string {
+	_, tail, found := strings.Cut(base.Description, requirementStart)
+	if found && strings.Contains(tail, requirementEnd) {
+		return WithRequirements(base.Description, requirements)
+	}
+	return requirements + strings.TrimPrefix(base.Description, base.Requirements)
+}
+
+// RefreshContract is a three-way merge. Conflicts leave the transaction intact.
+func RefreshContract(base, local, remote Contract) (Contract, error) {
+	out := local
+	fields := []struct {
+		name                string
+		base, local, remote string
+		out                 *string
+	}{
+		{"标题", base.Title, local.Title, remote.Title, &out.Title},
+		{"交付要求", base.Requirements, local.Requirements, remote.Requirements, &out.Requirements},
+		{"截止日期", base.DueDate, local.DueDate, remote.DueDate, &out.DueDate},
+	}
+	for _, f := range fields {
+		if f.local == f.base {
+			*f.out = f.remote
+		} else if f.remote != f.base && f.local != f.remote {
+			return local, fmt.Errorf("%s在任务和草稿中均已修改，请核对并统一该字段后重试", f.name)
+		}
+	}
+	baseOwner := base.AssigneeType + ":" + base.AssigneeID
+	localOwner := local.AssigneeType + ":" + local.AssigneeID
+	remoteOwner := remote.AssigneeType + ":" + remote.AssigneeID
+	if localOwner == baseOwner {
+		out.AssigneeType, out.AssigneeID = remote.AssigneeType, remote.AssigneeID
+	} else if remoteOwner != baseOwner && localOwner != remoteOwner {
+		return local, fmt.Errorf("负责人在任务和草稿中均已修改，请核对并统一后重试")
+	}
+	return out, nil
+}
diff --git a/server/internal/projectplan/requirements_test.go b/server/internal/projectplan/requirements_test.go
new file mode 100644
index 000000000..378874698
--- /dev/null
+++ b/server/internal/projectplan/requirements_test.go
@@ -0,0 +1,72 @@
+package projectplan
+
+import "testing"
+
+func TestTaskRequirementsImportPublishRoundTrip(t *testing.T) {
+	body := "原任务要求\n保留附件引用"
+	suffix := "\n\n采用的话题结论：\n已确认快照"
+	for _, description := range []string{body, body + suffix, body + suffix + suffix} {
+		stripped := TaskRequirementsBody(description, []string{"已确认快照"})
+		b := Baseline{Contract: Contract{Requirements: Requirements(stripped)}, Description: description}
+		if b.Requirements != body {
+			t.Fatalf("snapshot imported: %q", b.Requirements)
+		}
+		if got := PublishRequirements(b, body); got != description {
+			t.Fatalf("unchanged publish duplicated input: %q", got)
+		}
+		published := PublishRequirements(b, "修改后的要求")
+		expected := "修改后的要求" + description[len(body):]
+		if published != expected {
+			t.Fatalf("publish=%q want=%q", published, expected)
+		}
+		b.Description = published
+		b.Requirements = Requirements(TaskRequirementsBody(published, []string{"已确认快照"}))
+		if PublishRequirements(b, b.Requirements) != published {
+			t.Fatal("republish changed description")
+		}
+	}
+	unverified := body + suffix
+	if TaskRequirementsBody(unverified, []string{"另一个版本"}) != unverified {
+		t.Fatal("removed human-authored text")
+	}
+}
+func TestMarkedRequirementsPreserveInputAndEmpty(t *testing.T) {
+	description := WithRequirements("原始输入", "交付要求")
+	b := Baseline{Contract: Contract{Requirements: Requirements(description)}, Description: description}
+	got := PublishRequirements(b, "新要求")
+	if got != WithRequirements("原始输入", "新要求") {
+		t.Fatal(got)
+	}
+	if Requirements(PublishRequirements(b, "")) != "" {
+		t.Fatal("clearing fell back to original input")
+	}
+}
+func TestRefreshContractPreservesEditsAndRejectsConflicts(t *testing.T) {
+	base := Contract{Title: "任务", Requirements: "原要求", AssigneeType: "member", AssigneeID: "u"}
+	local, remote := base, base
+	local.Requirements = "人工修改"
+	remote.DueDate = "2026-11-20"
+	got, err := RefreshContract(base, local, remote)
+	if err != nil || got.Requirements != local.Requirements || got.DueDate != remote.DueDate {
+		t.Fatalf("got=%+v err=%v", got, err)
+	}
+	remote.Requirements = "任务侧修改"
+	if _, err = RefreshContract(base, local, remote); err == nil {
+		t.Fatal("same-field conflict silently overwritten")
+	}
+	remote.Requirements = local.Requirements
+	if _, err = RefreshContract(base, local, remote); err != nil {
+		t.Fatal(err)
+	}
+	old := Contract{Title: "旧版空要求"}
+	got, err = RefreshContract(old, old, Contract{Title: old.Title, Requirements: "任务正文"})
+	if err != nil || got.Requirements != "任务正文" {
+		t.Fatal("legacy untouched empty draft not refreshed")
+	}
+	local, remote = base, base
+	local.AssigneeType, local.AssigneeID = "agent", "a"
+	remote.AssigneeID = "v"
+	if _, err = RefreshContract(base, local, remote); err == nil {
+		t.Fatal("owner pair conflict lost")
+	}
+}
diff --git a/server/internal/projectplan/suggestion.go b/server/internal/projectplan/suggestion.go
new file mode 100644
index 000000000..95d0bbbd4
--- /dev/null
+++ b/server/internal/projectplan/suggestion.go
@@ -0,0 +1,252 @@
+package projectplan
+
+import (
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"strings"
+)
+
+type Change struct {
+	ID     string `json:"id"`
+	Kind   string `json:"kind"`
+	Reason string `json:"reason"`
+	Node   *Node  `json:"node,omitempty"`
+	Edge   *Edge  `json:"edge,omitempty"`
+	Target string `json:"target,omitempty"`
+}
+type Suggestion struct {
+	SchemaVersion int      `json:"schema_version"`
+	Changes       []Change `json:"changes"`
+	Questions     []string `json:"questions"`
+}
+
+// ValidateSuggestion maps only request-scoped aliases; model text never selects
+// arbitrary database UUIDs. A package is inert until explicit adoption.
+func ValidateSuggestion(raw []byte, base Graph, allowed []string) (Suggestion, error) {
+	var s Suggestion
+	if err := json.Unmarshal(raw, &s); err != nil {
+		return s, fmt.Errorf("规划结果不是有效 JSON：%w", err)
+	}
+	if s.SchemaVersion != 1 || len(s.Changes) > 100 {
+		return s, fmt.Errorf("建议格式不支持或超过 100 项变更")
+	}
+	refs := map[string]string{}
+	for i, n := range base.Nodes {
+		refs[fmt.Sprintf("n%d", i+1)] = n.ID
+	}
+	for i, e := range base.Edges {
+		refs[fmt.Sprintf("e%d", i+1)] = e.ID
+	}
+	scope := map[string]bool{}
+	for _, id := range allowed {
+		scope[id] = true
+	}
+	changeIDs := map[string]bool{}
+	for i := range s.Changes {
+		c := &s.Changes[i]
+		if c.ID == "" || changeIDs[c.ID] || len(c.ID) > 100 {
+			return s, fmt.Errorf("建议标识为空或重复")
+		}
+		changeIDs[c.ID] = true
+		if c.Kind == "add" {
+			if c.Node == nil || !strings.HasPrefix(c.Node.ID, "new") || refs[c.Node.ID] != "" || c.Node.IssueID != "" || c.Node.AssigneeID != "" {
+				return s, fmt.Errorf("新增任务包含未知引用或未经选择的负责人")
+			}
+			refs[c.Node.ID] = c.Node.ID
+		}
+	}
+	for idx := range s.Changes {
+		c := &s.Changes[idx]
+		switch c.Kind {
+		case "add":
+			c.Node.Baseline = nil
+		case "update", "remove":
+			target, ok := refs[c.Target]
+			if !ok || !strings.HasPrefix(c.Target, "n") {
+				return s, fmt.Errorf("建议引用了输入之外的任务")
+			}
+			if len(scope) > 0 && !scope[target] {
+				return s, fmt.Errorf("建议修改超出选中的节点范围")
+			}
+			c.Target = target
+			if c.Kind == "update" {
+				if c.Node == nil {
+					return s, fmt.Errorf("修改建议缺少节点")
+				}
+				for _, n := range base.Nodes {
+					if n.ID == target {
+						c.Node.ID = n.ID
+						c.Node.IssueID = n.IssueID
+						c.Node.AssigneeID = n.AssigneeID
+						c.Node.AssigneeType = n.AssigneeType
+						c.Node.Baseline = n.Baseline
+						c.Node.Position = n.Position
+					}
+				}
+			}
+		case "add_edge":
+			if c.Edge == nil {
+				return s, fmt.Errorf("建议缺少依赖")
+			}
+			from, ok := refs[c.Edge.From]
+			if !ok {
+				return s, fmt.Errorf("依赖引用未知上游")
+			}
+			to, ok := refs[c.Edge.To]
+			if !ok {
+				return s, fmt.Errorf("依赖引用未知下游")
+			}
+			if len(scope) > 0 && !scope[to] && !strings.HasPrefix(to, "new") {
+				return s, fmt.Errorf("依赖修改超出选定范围")
+			}
+			c.Edge.From = from
+			c.Edge.To = to
+			c.Edge.ID = "suggestion-" + c.ID
+		case "remove_edge":
+			target, ok := refs[c.Target]
+			if !ok || !strings.HasPrefix(c.Target, "e") {
+				return s, fmt.Errorf("建议引用未知依赖")
+			}
+			for _, e := range base.Edges {
+				if e.ID == target && len(scope) > 0 && !scope[e.To] {
+					return s, fmt.Errorf("依赖修改超出选定范围")
+				}
+			}
+			c.Target = target
+		default:
+			return s, fmt.Errorf("未知建议类型：%s", c.Kind)
+		}
+	}
+	ids := []string{}
+	for _, c := range s.Changes {
+		ids = append(ids, c.ID)
+	}
+	_, err := ApplySuggestion(base, base, s, ids)
+	return s, err
+}
+func ApplySuggestion(base, current Graph, s Suggestion, selected []string) (Graph, error) {
+	raw, _ := json.Marshal(current)
+	var g Graph
+	json.Unmarshal(raw, &g)
+	chosen := map[string]bool{}
+	for _, id := range selected {
+		chosen[id] = true
+	}
+	found := map[string]bool{}
+	for _, c := range s.Changes {
+		if !chosen[c.ID] {
+			continue
+		}
+		found[c.ID] = true
+		switch c.Kind {
+		case "add":
+			for _, n := range g.Nodes {
+				if n.ID == c.Node.ID {
+					return g, fmt.Errorf("新增节点已采用")
+				}
+			}
+			g.Nodes = append(g.Nodes, *c.Node)
+		case "update":
+			var old *Node
+			for i := range base.Nodes {
+				if base.Nodes[i].ID == c.Target {
+					old = &base.Nodes[i]
+				}
+			}
+			if old == nil {
+				return g, fmt.Errorf("建议基线节点缺失")
+			}
+			matched := false
+			for i := range g.Nodes {
+				n := &g.Nodes[i]
+				if n.ID != c.Target {
+					continue
+				}
+				matched = true
+				fields := []struct {
+					base  string
+					next  string
+					value *string
+				}{{old.Title, c.Node.Title, &n.Title}, {old.Requirements, c.Node.Requirements, &n.Requirements}, {old.DueDate, c.Node.DueDate, &n.DueDate}}
+				for _, f := range fields {
+					if f.next == f.base {
+						continue
+					}
+					if *f.value != f.base && *f.value != f.next {
+						return g, fmt.Errorf("%s：人的修改与建议冲突，请重新生成或手工调整", n.Title)
+					}
+					*f.value = f.next
+				}
+			}
+			if !matched {
+				return g, fmt.Errorf("建议节点已被移出")
+			}
+		case "remove":
+			var old *Node
+			for i := range base.Nodes {
+				if base.Nodes[i].ID == c.Target {
+					old = &base.Nodes[i]
+				}
+			}
+			if old == nil {
+				return g, fmt.Errorf("建议基线缺失")
+			}
+			incident := func(graph Graph) map[string]Edge {
+				r := map[string]Edge{}
+				for _, e := range graph.Edges {
+					if e.From == c.Target || e.To == c.Target {
+						r[e.ID] = e
+					}
+				}
+				return r
+			}
+			if !reflect.DeepEqual(incident(base), incident(current)) {
+				return g, fmt.Errorf("任务依赖已被人修改，不能采用移出建议")
+			}
+			nodes := []Node{}
+			for _, n := range g.Nodes {
+				if n.ID == c.Target {
+					if n.Contract != old.Contract {
+						return g, fmt.Errorf("任务已修改，不能采用移出建议")
+					}
+				} else {
+					nodes = append(nodes, n)
+				}
+			}
+			g.Nodes = nodes
+			edges := []Edge{}
+			for _, e := range g.Edges {
+				if e.From != c.Target && e.To != c.Target {
+					edges = append(edges, e)
+				}
+			}
+			g.Edges = edges
+		case "add_edge":
+			g.Edges = append(g.Edges, *c.Edge)
+		case "remove_edge":
+			for _, e := range current.Edges {
+				if e.ID == c.Target {
+					for _, old := range base.Edges {
+						if old.ID == e.ID && old != e {
+							return g, fmt.Errorf("依赖已被人修改，不能采用删除建议")
+						}
+					}
+				}
+			}
+			edges := []Edge{}
+			for _, e := range g.Edges {
+				if e.ID != c.Target {
+					edges = append(edges, e)
+				}
+			}
+			g.Edges = edges
+		}
+	}
+	for id := range chosen {
+		if !found[id] {
+			return g, fmt.Errorf("建议项不存在：%s", id)
+		}
+	}
+	return g, g.Validate()
+}
