+package workbench
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestWorkbenchSchemaRejectsForgedEvidenceAndComponents(t *testing.T) {
+	e := map[string]Evidence{"issue:one": {ID: "issue:one"}}
+	v := View{SchemaVersion: 1, Title: "test", Intent: "unfinished work", Queries: []Query{{Source: "issue"}}, Blocks: []Block{{Type: "list", Title: "work", Items: []Item{{Title: "one", EvidenceIDs: []string{"issue:one"}}}, EvidenceIDs: []string{}}}, Limitations: []string{}}
+	raw, _ := json.Marshal(v)
+	if _, err := ParseView(string(raw), e); err != nil {
+		t.Fatal(err)
+	}
+	v.Blocks[0].Items[0].EvidenceIDs = []string{"issue:forged"}
+	raw, _ = json.Marshal(v)
+	if _, err := ParseView(string(raw), e); err == nil {
+		t.Fatal("forged reference accepted")
+	}
+	v.Blocks[0].Items[0].EvidenceIDs = []string{}
+	v.Blocks[0].Type = "javascript"
+	raw, _ = json.Marshal(v)
+	if _, err := ParseView(string(raw), e); err == nil {
+		t.Fatal("unknown component accepted")
+	}
+}
+func TestWorkbenchCandidateCoverageAndRelationshipExpansion(t *testing.T) {
+	c := Corpus{Records: []Evidence{{ID: "issue:1", Kind: "issue", Status: "blocked", ObjectID: "1", ProjectID: "p", Title: "权限"}, {ID: "issue:2", Kind: "issue", Status: "todo", ObjectID: "2", ProjectID: "p", Title: "验收"}, {ID: "issue:3", Kind: "issue", Status: "done", ObjectID: "3", ProjectID: "p"}, {ID: "comment:4", Kind: "comment", IssueID: "2", Text: "自测通过，等待用户验收"}}}
+	first, err := c.Search(Query{Source: "issue", Status: "unfinished", Limit: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.Total != 2 || first.Complete || first.NextOffset == nil {
+		t.Fatalf("bad coverage %+v", first)
+	}
+	second, _ := c.Search(Query{Source: "issue", Status: "unfinished", Limit: 1, Offset: *first.NextOffset})
+	if !second.Complete || second.Records[0].ObjectID != "2" {
+		t.Fatal(second)
+	}
+	comments, _ := c.Search(Query{Source: "comment", RelatedID: "2", Text: "验收"})
+	if comments.Total != 1 {
+		t.Fatal(comments)
+	}
+	if _, err = c.Search(Query{Source: "private_chat"}); err == nil {
+		t.Fatal("unapproved source accepted")
+	}
+	c.Records = append(c.Records, Evidence{ID: "issue:new", ObjectID: "new", Kind: "issue", Status: "blocked"})
+	newPage, _ := c.Search(Query{Source: "issue", Status: "unfinished"})
+	if newPage.Total != 3 {
+		t.Fatal("new candidate not found")
+	}
+}
+
+func TestWorkbenchOnlyRelativeTimeViewsExpireWithoutBusinessChanges(t *testing.T) {
+	before := Corpus{Fingerprint: "same-records", At: "2026-11-15T00:04:59Z"}
+	after := Corpus{Fingerprint: "same-records", At: "2026-11-15T00:05:01Z"}
+	if before.ViewFingerprint(View{}) != after.ViewFingerprint(View{}) {
+		t.Fatal("ordinary view triggered unnecessary regeneration")
+	}
+	if before.ViewFingerprint(View{TimeSensitive: true}) == after.ViewFingerprint(View{TimeSensitive: true}) {
+		t.Fatal("relative-time view stayed stale")
+	}
+}
diff --git a/server/internal/workbench/distribution.go b/server/internal/workbench/distribution.go
new file mode 100644
index 000000000..549bd39d5
--- /dev/null
+++ b/server/internal/workbench/distribution.go
@@ -0,0 +1,127 @@
+package workbench
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+type DistributionGroup struct {
+	Key         string         `json:"key"`
+	Label       string         `json:"label"`
+	RecordID    string         `json:"recordId"`
+	Total       int            `json:"total"`
+	Values      map[string]int `json:"values"`
+	EvidenceIDs []string       `json:"evidenceIds"`
+}
+type DistributionValue struct {
+	Field       string              `json:"field"`
+	SeriesField string              `json:"seriesField"`
+	Series      []string            `json:"series"`
+	Groups      []DistributionGroup `json:"groups"`
+}
+
+// Aggregate only supplied fields. Missing fields must not become null groups.
+func aggregateDistribution(b Binding, rows []map[string]any, datasets map[string]Dataset) (DistributionValue, []string, bool, error) {
+	out := DistributionValue{Field: b.Field, SeriesField: b.SeriesField, Series: []string{}, Groups: []DistributionGroup{}}
+	labelIDs := []string{}
+	if !rowFields[b.Field] || (b.SeriesField != "" && !rowFields[b.SeriesField]) {
+		return out, nil, false, fmt.Errorf("invalid distribution field")
+	}
+	labels := map[string]map[string]any{}
+	complete := true
+	if b.LabelDatasetID != "" {
+		ds, ok := datasets[b.LabelDatasetID]
+		if !ok {
+			return out, nil, false, fmt.Errorf("unknown label dataset")
+		}
+		complete = ds.Complete
+		for _, r := range ds.Rows {
+			id, ok := r["id"].(string)
+			if !ok {
+				return out, nil, false, fmt.Errorf("invalid label id")
+			}
+			if _, ok := r["title"].(string); !ok {
+				return out, nil, false, fmt.Errorf("missing label title")
+			}
+			labels[id] = r
+			if _, suffix, found := strings.Cut(id, ":"); found {
+				if prior, exists := labels[suffix]; exists && prior["id"] != id {
+					return out, nil, false, fmt.Errorf("ambiguous label id")
+				}
+				labels[suffix] = r
+			}
+		}
+	}
+	groups := map[string]*DistributionGroup{}
+	series := map[string]bool{}
+	for _, r := range rows {
+		key, err := distributionKey(r, b.Field)
+		if err != nil {
+			return out, nil, false, err
+		}
+		sk := "count"
+		if b.SeriesField != "" {
+			sk, err = distributionKey(r, b.SeriesField)
+			if err != nil {
+				return out, nil, false, err
+			}
+		}
+		g := groups[key]
+		if g == nil {
+			g = &DistributionGroup{Key: key, Label: key, Values: map[string]int{}, EvidenceIDs: []string{}}
+			if b.LabelDatasetID != "" && key != "" {
+				lr, ok := labels[key]
+				if !ok {
+					return out, nil, false, fmt.Errorf("distribution label not supplied: %s", key)
+				}
+				g.Label = lr["title"].(string)
+				g.RecordID = lr["id"].(string)
+				if !contains(labelIDs, g.RecordID) {
+					labelIDs = append(labelIDs, g.RecordID)
+				}
+			}
+			groups[key] = g
+		}
+		g.Total++
+		g.Values[sk]++
+		g.EvidenceIDs = append(g.EvidenceIDs, r["id"].(string))
+		series[sk] = true
+	}
+	if len(groups) > 80 || len(series) > 20 {
+		return out, nil, false, fmt.Errorf("distribution too many groups or series; narrow query")
+	}
+	keys := make([]string, 0, len(groups))
+	for k := range groups {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for s := range series {
+		out.Series = append(out.Series, s)
+	}
+	sort.Strings(out.Series)
+	for _, k := range keys {
+		g := groups[k]
+		for _, s := range out.Series {
+			if _, ok := g.Values[s]; !ok {
+				g.Values[s] = 0
+			}
+		}
+		out.Groups = append(out.Groups, *g)
+	}
+	return out, labelIDs, complete, nil
+}
+func distributionKey(row map[string]any, field string) (string, error) {
+	v, ok := row[field]
+	if !ok {
+		return "", fmt.Errorf("distribution field not supplied: %s", field)
+	}
+	if v == nil {
+		return "", nil
+	}
+	switch v.(type) {
+	case string, float64, int, bool:
+		return fmt.Sprint(v), nil
+	}
+	return "", fmt.Errorf("invalid distribution value")
+}
