+func TestMWPendingThreadNeverMergesDifferentSquadContexts(t *testing.T) {
+	useMWCommentPolicy(t)
+	runtimeID := dbfx.Runtime(t, "MW context runtime")
+	leader := dbfx.Agent(t, "MW context leader", runtimeID)
+	squadA := dbfx.Squad(t, "MW context A", leader)
+	squadB := dbfx.Squad(t, "MW context B", leader)
+	issueID := dbfx.Issue(t, "MW context isolation")
+	var root CommentResponse
+	testutil.Call(t, testHandler.CreateComment, withURLParam(newRequest(http.MethodPost, "/api/issues/"+issueID+"/comments", map[string]any{"content": fmt.Sprintf("[@A](mention://squad/%s) request", squadA)}), "id", issueID)).Want(http.StatusCreated).JSON(&root)
+	for _, target := range []struct{ kind, id string }{{"agent", leader}, {"squad", squadB}} {
+		body := map[string]any{"content": fmt.Sprintf("[@target](mention://%s/%s) request", target.kind, target.id), "parent_id": root.ID}
+		var preview CommentTriggerPreviewResponse
+		testutil.Call(t, testHandler.PreviewCommentTriggers, withURLParam(newRequest(http.MethodPost, "/preview", body), "id", issueID)).Want(http.StatusOK).JSON(&preview)
+		if len(preview.Agents) != 0 || len(preview.Blocked) != 1 || preview.Blocked[0].ReasonCode != ReasonInvocationScopeConflict {
+			t.Fatalf("scope conflict preview = %+v", preview)
+		}
+		var posted CommentResponse
+		testutil.Call(t, testHandler.CreateComment, withURLParam(newRequest(http.MethodPost, "/comments", body), "id", issueID)).Want(http.StatusCreated).JSON(&posted)
+		if len(posted.TriggerOutcomes) != 1 || posted.TriggerOutcomes[0].ReasonCode != ReasonInvocationScopeConflict {
+			t.Fatalf("scope conflict outcome = %+v", posted.TriggerOutcomes)
+		}
+	}
+	tasks, err := testHandler.Queries.ListTasksByIssue(context.Background(), parseUUID(issueID))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(tasks) != 1 || uuidToString(tasks[0].SquadID) != squadA || uuidToString(tasks[0].TriggerCommentID) != root.ID || len(tasks[0].CoalescedCommentIds) != 0 {
