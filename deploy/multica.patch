+)
+
+func TestDistributionCountsLabelsNullAndCompleteness(t *testing.T) {
+	datasets := map[string]Dataset{
+		"tasks": {Complete: true, Rows: []map[string]any{
+			{"id": "issue:a", "projectId": "p", "status": "done", "assigneeName": nil},
+			{"id": "issue:b", "projectId": "p", "status": "blocked", "assigneeName": "甲"},
+			{"id": "issue:c", "projectId": "q", "status": "blocked", "assigneeName": "甲"},
+		}},
+		"projects": {Complete: true, Rows: []map[string]any{{"id": "project:p", "title": "门户"}, {"id": "project:q", "title": "平台"}}},
+	}
+	b := Binding{ID: "matrix", DatasetID: "tasks", Op: "distribution", Field: "projectId", SeriesField: "status", LabelDatasetID: "projects"}
+	f, err := bind(b, datasets)
+	if err != nil {
+		t.Fatal(err)
+	}
+	v := f.Value.(DistributionValue)
+	if len(v.Groups) != 2 || v.Groups[0].Label != "门户" || v.Groups[0].Total != 2 || !reflect.DeepEqual(v.Groups[0].Values, map[string]int{"done": 1, "blocked": 1}) || v.Groups[1].Values["done"] != 0 || len(f.EvidenceIDs) != 5 {
+		t.Fatalf("bad aggregate: %+v", f)
+	}
+	b.Field = "assigneeName"
+	b.SeriesField = ""
+	b.LabelDatasetID = ""
+	f, err = bind(b, datasets)
+	if err != nil {
+		t.Fatal(err)
+	}
+	v = f.Value.(DistributionValue)
+	if v.Groups[0].Key != "" || v.Groups[0].Total != 1 || v.Groups[1].Values["count"] != 2 {
+		t.Fatal(v)
+	}
+	b.Field = "dueDate"
+	if _, err = bind(b, datasets); err == nil {
+		t.Fatal("missing field silently grouped")
+	}
+	b.Field = "projectId"
+	b.LabelDatasetID = "projects"
+	ds := datasets["projects"]
+	ds.Complete = false
+	datasets["projects"] = ds
+	f, err = bind(b, datasets)
+	if err != nil || f.Complete {
+		t.Fatal("partial labels reported complete", err)
+	}
+	b.Filter = []Filter{{Field: "status", Op: "eq", Value: "todo"}}
+	f, err = bind(b, datasets)
+	if err != nil || len(f.Value.(DistributionValue).Groups) != 0 {
+		t.Fatal("empty aggregate", err)
+	}
+}
+
+func TestA2UIDistributionAndNumbersPublishAtomically(t *testing.T) {
+	makeAnswer := func() (*Dynamic, map[string]Evidence) {
+		d, r := a2uiTestAnswer(t)
+		ds := d.Datasets["d1"]
+		ds.Rows[0]["projectId"] = "p"
+		d.Datasets["d1"] = ds
+		d.Datasets["projects"] = Dataset{Complete: true, Rows: []map[string]any{{"id": "project:p", "title": "演示"}}}
+		r["project:p"] = Evidence{ID: "project:p", Kind: "project", Text: "演示"}
+		return d, r
+	}
+	line := `{"type":"section","section":{"id":"main","dataRefs":["d1","projects"],"facts":[{"id":"total","datasetId":"d1","op":"count"},{"id":"matrix","datasetId":"d1","op":"distribution","field":"projectId","seriesField":"status","labelDatasetId":"projects"}],"surface":{"catalogId":"https://mobilework.local/catalog/answer/v1","components":[{"id":"root","component":"Stack","children":["summary","metric","chart"]},{"id":"summary","component":"AnswerSummary","kind":"inference","text":"当前有{{fact:total}}条任务。","evidenceIds":[]},{"id":"metric","component":"Stat","label":"任务总量","value":{"@path":"/facts/total/value"},"tone":"info"},{"id":"chart","component":"Distribution","title":"项目状态","data":{"@path":"/facts/matrix/value"},"variant":"bars"}]}}}`
+	d, r := makeAnswer()
+	if err := d.applyGeneratedA2UI(line, r); err != nil {
+		t.Fatal(err)
+	}
+	cl := d.Claims[internalID("c", "main", "summary")]
+	if cl.Text != "当前有1条任务。" || len(cl.FactIDs) != 1 || len(cl.EvidenceIDs) != 1 {
+		t.Fatalf("unbound summary %+v", cl)
+	}
+	raw, _ := json.Marshal(d)
+	var restored Dynamic
+	if err := json.Unmarshal(raw, &restored); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(raw), `"label":"演示"`) {
+		t.Fatal("labels lost")
+	}
+	for _, bad := range []string{
+		strings.Replace(line, "{{fact:total}}", "12", 1),
+		strings.Replace(line, "{{fact:total}}", "{{fact:missing}}", 1),
+		strings.Replace(line, "{{fact:total}}", "{{fact:matrix}}", 1),
+		strings.Replace(line, `["d1","projects"]`, `["d1"]`, 1),
+		strings.Replace(line, `/facts/matrix/value`, `/facts/total/value`, 1),
+		strings.Replace(line, `"data":{"@path":"/facts/matrix/value"}`, `"data":{"groups":[]}`, 1),
+	} {
+		d, r := makeAnswer()
+		if err := d.applyGeneratedA2UI(bad, r); err == nil {
+			t.Fatal("accepted invalid aggregate/count")
+		}
+		if len(d.Sections)+len(d.Claims)+len(d.Facts) != 0 {
+			t.Fatal("partial section leaked")
+		}
+	}
+}
+
+func TestAnalysisCountBindingsDoNotConfuseDatesOrIdentifiers(t *testing.T) {
+	for _, s := range []string{"截止日期为2026年11月16日。", "参考任务DEMO-12。", "需要核对负责人。"} {
+		if _, _, err := interpolateAnalysis(s, nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, s := range []string{"共12条任务。", "完成率20%。", "有3个项目。"} {
+		if _, _, err := interpolateAnalysis(s, nil); err == nil {
+			t.Fatal("accepted count", s)
+		}
+	}
+}
diff --git a/server/internal/workbench/dynamic.go b/server/internal/workbench/dynamic.go
new file mode 100644
index 000000000..f5b216b57
--- /dev/null
+++ b/server/internal/workbench/dynamic.go
@@ -0,0 +1,536 @@
+package workbench
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"reflect"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/evanw/esbuild/pkg/api"
+)
+
+const SDKVersion = "workbench-ui@2"
+const RuntimeVersion = "quickjs@0.32.0"
+
+type Dataset struct {
+	ID         string           `json:"id"`
+	Query      Query            `json:"query"`
+	Rows       []map[string]any `json:"rows"`
+	Total      int              `json:"total"`
+	Complete   bool             `json:"complete"`
+	NextOffset *int             `json:"nextOffset"`
+}
+type Filter struct {
+	Field string `json:"field"`
+	Op    string `json:"op"`
+	Value any    `json:"value"`
+}
+type Binding struct {
+	ID             string   `json:"id"`
+	DatasetID      string   `json:"datasetId"`
+	Op             string   `json:"op"`
+	Field          string   `json:"field,omitempty"`
+	RowID          string   `json:"rowId,omitempty"`
+	SeriesField    string   `json:"seriesField,omitempty"`
+	LabelDatasetID string   `json:"labelDatasetId,omitempty"`
+	Filter         []Filter `json:"filter,omitempty"`
+}
+type Fact struct {
+	Binding     Binding  `json:"binding"`
+	Value       any      `json:"value"`
+	Complete    bool     `json:"complete"`
+	EvidenceIDs []string `json:"evidenceIds"`
+}
+type Claim struct {
+	ID          string   `json:"id"`
+	Kind        string   `json:"kind"`
+	Text        string   `json:"text"`
+	EvidenceIDs []string `json:"evidenceIds"`
+	FactIDs     []string `json:"factIds"`
+	GapType     string   `json:"gapType,omitempty"`
+}
+type Region struct {
+	ID      string `json:"id"`
+	Title   string `json:"title"`
+	Role    string `json:"role"`
+	Surface string `json:"surface,omitempty"`
+}
+type Plan struct {
+	Title         string   `json:"title"`
+	Intent        string   `json:"intent"`
+	Layout        string   `json:"layout"`
+	TimeSensitive bool     `json:"timeSensitive"`
+	Sections      []Region `json:"sections"`
+}
+type StateSpec struct {
+	Default any   `json:"default"`
+	Values  []any `json:"values"`
+}
+type Section struct {
+	Surface     json.RawMessage      `json:"surface,omitempty"`
+	ID          string               `json:"id"`
+	Revision    int                  `json:"revision"`
+	Code        string               `json:"code"`
+	JS          string               `json:"js"`
+	Hash        string               `json:"hash"`
+	SDK         string               `json:"sdk"`
+	Runtime     string               `json:"runtime"`
+	State       map[string]StateSpec `json:"state"`
+	ContentRefs []string             `json:"contentRefs"`
+	DataRefs    []string             `json:"dataRefs"`
+	Fallback    string               `json:"fallback,omitempty"`
+	CompileMS   int64                `json:"compileMs"`
+}
+type Content struct {
+	SectionID string    `json:"sectionId"`
+	Claims    []Claim   `json:"claims"`
+	Facts     []Binding `json:"facts"`
+	DataRefs  []string  `json:"dataRefs"`
+}
+type Dynamic struct {
+	reuse         *Dynamic
+	SchemaVersion int                `json:"schemaVersion"`
+	Plan          *Plan              `json:"plan"`
+	Datasets      map[string]Dataset `json:"datasets"`
+	Facts         map[string]Fact    `json:"facts"`
+	Claims        map[string]Claim   `json:"claims"`
+	Contents      map[string]Content `json:"contents"`
+	Sections      map[string]Section `json:"sections"`
+	Complete      bool               `json:"complete"`
+	Seq           int                `json:"seq"`
+	AttemptID     int                `json:"attemptId"`
+	Limitations   []string           `json:"limitations"`
+	FollowUps     []string           `json:"followUps"`
+}
+
+func NewDynamic() *Dynamic {
+	return &Dynamic{SchemaVersion: 2, Datasets: map[string]Dataset{}, Facts: map[string]Fact{}, Claims: map[string]Claim{}, Contents: map[string]Content{}, Sections: map[string]Section{}, Limitations: []string{}, FollowUps: []string{}}
+}
+
+var idPattern = regexp.MustCompile(`^[A-Za-z][A-Za-z0-9_-]{0,63}$`)
+var rowFields = map[string]bool{"id": true, "title": true, "status": true, "kind": true, "description": true, "assigneeType": true, "assigneeId": true, "assigneeName": true, "leadType": true, "leadId": true, "leadName": true, "startDate": true, "dueDate": true, "authorType": true, "authorId": true, "authorName": true, "content": true, "acceptanceCriteria": true, "updatedAt": true, "text": true, "projectId": true, "version": true, "relation": true, "issueTitle": true, "issueStatus": true, "dependsOnTitle": true, "dependsOnStatus": true}
+
+func MakeDataset(id string, q Query, p Page) Dataset {
+	d := Dataset{ID: id, Query: q, Rows: []map[string]any{}, Total: p.Total, Complete: q.Offset == 0 && p.Complete, NextOffset: p.NextOffset}
+	for _, e := range p.Records {
+		r := map[string]any{"id": e.ID, "title": e.Title, "status": e.Status, "kind": e.Kind, "projectId": e.ProjectID, "updatedAt": e.UpdatedAt, "version": e.Version}
+		var fields map[string]any
+		if json.Unmarshal([]byte(e.Text), &fields) == nil {
+			for k, v := range fields {
+				if rowFields[k] {
+					switch v.(type) {
+					case nil, string, float64, bool:
+						r[k] = v
+					case []any:
+						if k == "acceptanceCriteria" {
+							raw, _ := json.Marshal(v)
+							r[k] = string(raw)
+						}
+					}
+				}
+			}
+		} else {
+			r["text"] = e.Text
+		}
+		d.Rows = append(d.Rows, r)
+	}
+	return d
+}
+func bind(b Binding, datasets map[string]Dataset) (Fact, error) {
+	f := Fact{Binding: b, EvidenceIDs: []string{}}
+	d, ok := datasets[b.DatasetID]
+	if !ok || !idPattern.MatchString(b.ID) || len(b.Filter) > 8 {
+		return f, fmt.Errorf("invalid fact binding")
+	}
+	f.Complete = d.Complete
+	rows := []map[string]any{}
+	for _, r := range d.Rows {
+		match := true
+		for _, v := range b.Filter {
+			if !rowFields[v.Field] || v.Op != "eq" {
+				return f, fmt.Errorf("invalid filter")
+			}
+			if !reflect.DeepEqual(r[v.Field], v.Value) {
+				match = false
+			}
+		}
+		if match {
+			rows = append(rows, r)
+			f.EvidenceIDs = append(f.EvidenceIDs, r["id"].(string))
+		}
+	}
+	switch b.Op {
+	case "count":
+		f.Value = len(rows)
+	case "field":
+		if !rowFields[b.Field] {
+			return f, fmt.Errorf("invalid field")
+		}
+		found := false
+		for _, r := range rows {
+			if r["id"] == b.RowID {
+				value, exists := r[b.Field]
+				if !exists {
+					return f, fmt.Errorf("field not supplied")
+				}
+				f.Value = value
+				f.EvidenceIDs = []string{b.RowID}
+				found = true
+				break
+			}
+		}
+		if !found {
+			return f, fmt.Errorf("unknown row")
+		}
+	case "groupCount":
+		if !rowFields[b.Field] {
+			return f, fmt.Errorf("invalid grouping field")
+		}
+		v := map[string]int{}
+		for _, r := range rows {
+			key := fmt.Sprint(r[b.Field])
+			v[key]++
+		}
+		f.Value = v
+	case "distribution":
+		value, labelIDs, complete, err := aggregateDistribution(b, rows, datasets)
+		if err != nil {
+			return f, err
+		}
+		f.Value = value
+		f.Complete = f.Complete && complete
+		f.EvidenceIDs = append(f.EvidenceIDs, labelIDs...)
+	case "sum":
+		if !rowFields[b.Field] {
+			return f, fmt.Errorf("invalid sum field")
+		}
+		sum := 0.0
+		for _, r := range rows {
+			n, ok := r[b.Field].(float64)
+			if !ok || math.IsNaN(n) || math.IsInf(n, 0) {
+				return f, fmt.Errorf("sum requires numeric values")
+			}
+			sum += n
+		}
+		f.Value = sum
+	default:
+		return f, fmt.Errorf("unsupported fact operation")
+	}
+	return f, nil
+}
+func strict(raw []byte, v any) error {
+	d := json.NewDecoder(strings.NewReader(string(raw)))
+	d.DisallowUnknownFields()
+	return d.Decode(v)
+}
+func (d *Dynamic) hasRegion(id string) bool {
+	if d.Plan != nil {
+		for _, r := range d.Plan.Sections {
+			if r.ID == id {
+				return true
+			}
+		}
+	}
+	return false
+}
+func (d *Dynamic) Apply(line string, read map[string]Evidence) error {
+	if strings.Contains(line, `"__proto__"`) || strings.Contains(line, `"constructor"`) || strings.Contains(line, `"prototype"`) {
+		return fmt.Errorf("reserved key")
+	}
+	if len(line) > 65536 {
+		return fmt.Errorf("event exceeds 64 KiB")
+	}
+	var envelope struct {
+		Type    string   `json:"type"`
+		Plan    *Plan    `json:"plan,omitempty"`
+		Content *Content `json:"content,omitempty"`
+		Section *struct {
+			ID          string               `json:"id"`
+			DataRefs    []string             `json:"dataRefs,omitempty"`
+			Facts       []Binding            `json:"facts,omitempty"`
+			Surface     json.RawMessage      `json:"surface,omitempty"`
+			Code        string               `json:"code"`
+			ReuseHash   string               `json:"reuseHash,omitempty"`
+			State       map[string]StateSpec `json:"state"`
+			ContentRefs []string             `json:"contentRefs"`
+		} `json:"section,omitempty"`
+		Limitations []string `json:"limitations,omitempty"`
+		FollowUps   []string `json:"followUps,omitempty"`
+		Sections    []string `json:"sections,omitempty"`
+	}
+	if err := strict([]byte(line), &envelope); err != nil {
+		return fmt.Errorf("invalid NDJSON event: %w", err)
+	}
+	if d.Complete {
+		return fmt.Errorf("event after final")
+	}
+	switch envelope.Type {
+	case "plan":
+		p := envelope.Plan
+		if p == nil || d.Plan != nil || p.Title == "" || len(p.Title) > 900 || p.Intent == "" || len(p.Intent) > 24000 || len(p.Sections) < 1 || len(p.Sections) > 6 {
+			return fmt.Errorf("invalid plan")
+		}
+		if p.Layout != "stack" && p.Layout != "main-sidebar" && p.Layout != "columns" {
+			return fmt.Errorf("invalid layout")
+		}
+		seen := map[string]bool{}
+		for _, s := range p.Sections {
+			if !idPattern.MatchString(s.ID) || seen[s.ID] || len(s.Title) > 600 || (s.Role != "primary" && s.Role != "secondary") {
+				return fmt.Errorf("invalid section plan id=%q role=%q: id must be unique ASCII letter then letters/digits/_/-, role primary or secondary", s.ID, s.Role)
+			}
+			if s.Surface != "" && s.Surface != "plain" && s.Surface != "card" && s.Surface != "muted" {
+				return fmt.Errorf("invalid section surface")
+			}
+			seen[s.ID] = true
+		}
+		d.Plan = p
+	case "content":
+		c := envelope.Content
+		if c == nil || !d.hasRegion(c.SectionID) || len(c.Claims) > 16 || len(c.Facts) > 24 || len(c.DataRefs) > 16 {
+			return fmt.Errorf("invalid content")
+		}
+		if _, ok := d.Contents[c.SectionID]; ok {
+			return fmt.Errorf("duplicate content")
+		}
+		facts := map[string]Fact{}
+		for _, b := range c.Facts {
+			if d.reservedInOtherRegion(c.SectionID, b.ID, false) {
+				return fmt.Errorf("fact %s is reserved by an unchanged region; use a fresh edit_ prefixed id", b.ID)
+			}
+			if _, ok := d.Facts[b.ID]; ok {
+				return fmt.Errorf("duplicate fact")
+			}
+			if _, ok := facts[b.ID]; ok {
+				return fmt.Errorf("duplicate fact")
+			}
+			f, err := bind(b, d.Datasets)
+			if err != nil {
+				return err
+			}
+			facts[b.ID] = f
+		}
+		claims := map[string]Claim{}
+		for _, cl := range c.Claims {
+			if d.reservedInOtherRegion(c.SectionID, cl.ID, true) {
+				return fmt.Errorf("claim %s is reserved by an unchanged region; use a fresh edit_ prefixed id", cl.ID)
+			}
+			if !idPattern.MatchString(cl.ID) || len(cl.Text) == 0 || len(cl.Text) > 6000 || len(cl.EvidenceIDs) > 30 || len(cl.FactIDs) > 24 {
+				return fmt.Errorf("invalid claim")
+			}
+			if _, ok := d.Claims[cl.ID]; ok {
+				return fmt.Errorf("claim has multiple primary locations")
+			}
+			if _, ok := claims[cl.ID]; ok {
+				return fmt.Errorf("duplicate claim")
+			}
+			for _, existing := range d.Claims {
+				if strings.Join(strings.Fields(existing.Text), "") == strings.Join(strings.Fields(cl.Text), "") {
+					return fmt.Errorf("claim %s duplicates retained claim %s; remove repeated analysis from this region", cl.ID, existing.ID)
+				}
+			}
+			switch cl.Kind {
+			case "fact", "statement", "decision", "inference", "gap", "suggestion":
+			default:
+				return fmt.Errorf("invalid claim kind")
+			}
+			for _, id := range cl.EvidenceIDs {
+				if _, ok := read[id]; !ok {
+					return fmt.Errorf("unread evidence: %s; use page.records[].id including kind prefix", id)
+				}
+			}
+			if err := checkAcceptanceWording(cl, read); err != nil {
+				return err
+			}
+			for _, id := range cl.FactIDs {
+				if _, ok := facts[id]; !ok {
+					if _, ok = d.Facts[id]; !ok {
+						return fmt.Errorf("unknown fact")
+					}
+				}
+			}
+			if cl.Kind != "gap" && len(cl.EvidenceIDs)+len(cl.FactIDs) == 0 {
+				return fmt.Errorf("claim needs evidence: %s", cl.ID)
+			}
+			if cl.Kind == "statement" {
+				found := false
+				for _, id := range cl.EvidenceIDs {
+					if read[id].Kind == "comment" || read[id].Kind == "topic" {
+						found = true
+					}
+				}
+				if !found {
+					return fmt.Errorf("claim %s: statement needs comment/topic evidence; historical conclusion is fact, interpretation is inference", cl.ID)
+				}
+			}
+			if cl.Kind == "decision" {
+				found := false
+				for _, id := range cl.EvidenceIDs {
+					if read[id].Kind == "conclusion" && read[id].Status == "current" {
+						found = true
+					}
+				}
+				if !found {
+					return fmt.Errorf("decision needs current confirmed conclusion")
+				}
+			}
+			if cl.Kind == "gap" {
+				switch cl.GapType {
+				case "null_field", "not_supplied", "unresolved_name", "not_searched", "no_record":
+				default:
+					return fmt.Errorf("gap needs scope")
+				}
+			}
+			claims[cl.ID] = cl
+		}
+		for _, id := range c.DataRefs {
+			if _, ok := d.Datasets[id]; !ok {
+				return fmt.Errorf("unknown dataset")
+			}
+		}
+		for k, v := range facts {
+			d.Facts[k] = v
+		}
+		for k, v := range claims {
+			d.Claims[k] = v
+		}
+		d.Contents[c.SectionID] = *c
+	case "section":
+		s := envelope.Section
+		if s == nil || !d.hasRegion(s.ID) || len(s.Code) > 32000 || len(s.State) > 8 {
+			return fmt.Errorf("invalid section")
+		}
+		if len(s.Surface) > 0 && s.DataRefs != nil {
+			if s.Code != "" || s.ReuseHash != "" || len(s.State) > 0 || len(s.ContentRefs) > 0 {
+				return fmt.Errorf("a2ui section cannot mix executable or legacy fields")
+			}
+			if err := d.applyA2UI(s.ID, s.Surface, s.DataRefs, s.Facts, read); err != nil {
+				return err
+			}
+			d.Seq++
+			return nil
+		}
+		if s.ReuseHash != "" {
+			if s.Code != "" || len(s.Surface) > 0 || len(s.State) > 0 || len(s.ContentRefs) > 0 {
+				return fmt.Errorf("reuseHash cannot be mixed with new section fields")
+			}
+			if err := d.reuseRegion(s.ID, s.ReuseHash); err != nil {
+				return err
+			}
+			d.Seq++
+			return nil
+		}
+		c, ok := d.Contents[s.ID]
+		if !ok {
+			return fmt.Errorf("section before content")
+		}
+		if _, ok := d.Sections[s.ID]; ok {
+			return fmt.Errorf("duplicate section")
+		}
+		if len(s.ContentRefs) != len(c.Claims) {
+			return fmt.Errorf("section %s contentRefs must list all its %d claim ids", s.ID, len(c.Claims))
+		}
+		seen := map[string]bool{}
+		for _, id := range s.ContentRefs {
+			found := false
+			for _, cl := range c.Claims {
+				if cl.ID == id {
+					found = true
+				}
+			}
+			if !found || seen[id] {
+				return fmt.Errorf("invalid contentRefs")
+			}
+			seen[id] = true
+		}
+		for key, st := range s.State {
+			if !idPattern.MatchString(key) || len(st.Values) == 0 || len(st.Values) > 30 {
+				return fmt.Errorf("invalid state")
+			}
+			found := false
+			for _, v := range st.Values {
+				switch v.(type) {
+				case string, bool, float64:
+				default:
+					return fmt.Errorf("state must be scalar")
+				}
+				if fmt.Sprint(v) == fmt.Sprint(st.Default) {
+					found = true
+				}
+			}
+			if !found {
+				return fmt.Errorf("invalid state default")
+			}
+		}
+		if len(s.Surface) > 0 {
+			if s.Code != "" || len(s.State) > 0 {
+				return fmt.Errorf("surface cannot contain executable code or state")
+			}
+			if err := d.validateSurface(s.Surface, c, read); err != nil {
+				return err
+			}
+			sum := sha256.Sum256(s.Surface)
+			d.Sections[s.ID] = Section{ID: s.ID, Revision: d.Seq + 1, Surface: s.Surface, SDK: "workbench-catalog@1", Runtime: "a2ui@1.0", Hash: hex.EncodeToString(sum[:]), State: map[string]StateSpec{}, ContentRefs: s.ContentRefs, DataRefs: c.DataRefs}
+			d.Seq++
+			return nil
+		}
+		start := time.Now()
+		js, err := Compile(s.Code)
+		sec := Section{ID: s.ID, Revision: d.Seq + 1, Code: s.Code, JS: js, SDK: SDKVersion, Runtime: RuntimeVersion, State: s.State, ContentRefs: s.ContentRefs, DataRefs: c.DataRefs, CompileMS: time.Since(start).Milliseconds()}
+		if sec.State == nil {
+			sec.State = map[string]StateSpec{}
+		}
+		sum := sha256.Sum256([]byte(s.Code))
+		sec.Hash = hex.EncodeToString(sum[:])
+		if err != nil {
+			sec.Fallback = "布局编译失败，显示已核对内容"
+		}
+		d.Sections[s.ID] = sec
+	case "final":
+		if d.Plan == nil || len(envelope.Sections) != len(d.Plan.Sections) || len(envelope.Limitations) > 12 || len(envelope.FollowUps) > 5 {
+			return fmt.Errorf("incomplete final")
+		}
+		seen := map[string]bool{}
+		for _, id := range envelope.Sections {
+			if _, ok := d.Sections[id]; !ok || seen[id] {
+				return fmt.Errorf("missing final section")
+			}
+			seen[id] = true
+		}
+		for _, v := range append(append([]string{}, envelope.Limitations...), envelope.FollowUps...) {
+			if len(v) > 3000 {
+				return fmt.Errorf("final text too long")
+			}
+		}
+		d.Limitations = envelope.Limitations
+		if d.Limitations == nil {
+			d.Limitations = []string{}
+		}
+		d.FollowUps = envelope.FollowUps
+		if d.FollowUps == nil {
+			d.FollowUps = []string{}
+		}
+		d.Complete = true
+	default:
+		return fmt.Errorf("unknown event")
+	}
+	d.Seq++
+	return nil
+}
+
+var imports = regexp.MustCompile(`\b(import|export|require)\b`)
+
+func Compile(code string) (string, error) {
+	if len(code) > 32000 || imports.MatchString(code) {
+		return "", fmt.Errorf("imports are not allowed")
+	}
+	r := api.Transform(code, api.TransformOptions{Loader: api.LoaderTSX, JSXFactory: "ui.h", JSXFragment: "ui.Fragment", Target: api.ES2020, LegalComments: api.LegalCommentsNone})
+	if len(r.Errors) > 0 {
+		return "", fmt.Errorf("invalid JSX")
+	}
+	return string(r.Code), nil
+}
diff --git a/server/internal/workbench/dynamic_diagnostics.go b/server/internal/workbench/dynamic_diagnostics.go
new file mode 100644
index 000000000..4cc35c53a
--- /dev/null
