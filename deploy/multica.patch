diff --git a/server/workbench-pi/README.md b/server/workbench-pi/README.md
new file mode 100644
index 000000000..1a881ef0a
--- /dev/null
+++ b/server/workbench-pi/README.md
@@ -0,0 +1,32 @@
+# Workbench Pi runtime
+
+Isolated server-side runtime for read-only workbench questions. Install from this
+folder with `pnpm install --frozen-lockfile`. Run `node --test main.test.mjs`.
+Go prewarms `main.mjs` at API startup and passes only PATH, an empty HOME, WB_API_KEY and
+WB_BASE_URL. The API owns authorization, retrieval, facts, persistence and SSE;
+this process owns the Pi model/tool loop. It exposes only query_business and does
+not load repository instructions, extensions, skills, MCP, or filesystem tools.
+
+`MULTICA_WORKBENCH_PI_SCRIPT` may select an absolute script path.
+`MULTICA_WORKBENCH_PRO_ENABLED=1` exposes the optional Pro model after smoke tests;
+it never changes an existing Pin's model. Both models send thinking disabled; Pro thinking mode exceeded the
+180-second budget in the local coordination smoke test. Network retries are disabled. Each run has at most 5 HTTP
+requests, 16 total tools / 8 per turn, 180 seconds, and one protocol repair.
+After static imports finish, `runtime_ready` announces process readiness without
+creating a session or calling a provider. Workbench state exposes `runtimeStatus`
+and actual `modelReady`; new sends and generation refreshes return 503 before
+persistence while warming or unavailable. Other business pages remain available.
+
+A crashed process fails its active request. Background warmup restarts the shared
+child (checking every 5 seconds; a 180-second warmup timeout kills a stuck child).
+Failed user work is never automatically rerun. Requests remain serialized with a
+15-second admission timeout; each uses an independent in-memory agent session.
+
+
+Unified chat: the model chooses query_business only when workspace evidence is needed.
+The workspace being populated no longer forces retrieval or rejects a tool-free answer.
+The same plan/section/final pipeline supports literal Prose for general conversation,
+existing sourced analysis for business-grounded drafts, and bound data components.
+Business evidence, scope and computed-statistic validation remain unchanged. Prose is
+not a verified business claim. The client renders text-only Markdown, never HTML,
+remote images or executable model code. No separate intent-classification request is added.
diff --git a/server/workbench-pi/main.mjs b/server/workbench-pi/main.mjs
new file mode 100644
index 000000000..eaf5f506c
--- /dev/null
+++ b/server/workbench-pi/main.mjs
@@ -0,0 +1,83 @@
+import { queryPayload, MAX_MODEL_REQUESTS } from "./request-policy.mjs";
+import readline from 'node:readline';
+import { createAgentSession, DefaultResourceLoader, ModelRuntime, SessionManager, SettingsManager, defineTool } from '@earendil-works/pi-coding-agent';
+import { InMemoryCredentialStore, InMemoryModelsStore } from '@earendil-works/pi-ai';
+import { Type } from 'typebox';
+
+const send = (event) => process.stdout.write(JSON.stringify(event) + '\n');
+let active;
+const replies = new Map();
+async function run(req) {
+  if (active) { send({type:'settled',runId:req.runId,error:'busy'}); return; }
+  const state = active = {runId:req.runId, session:null, calls:0, tools:0, turnTools:0, httpCalls:0, attempt:0, cancelled:false};
+  let timer;
+  try {
+    const runtime = await ModelRuntime.create({credentials:new InMemoryCredentialStore(),modelsStore:new InMemoryModelsStore(),modelsPath:null,allowModelNetwork:false,refreshOnCreate:false});
+    runtime.registerProvider('workbench', {api:'openai-completions',baseUrl:process.env.WB_BASE_URL,models:[{id:req.model,name:req.model,reasoning:false,input:['text'],contextWindow:65536,maxTokens:10000,cost:{input:0,output:0,cacheRead:0,cacheWrite:0},compat:{supportsDeveloperRole:false,supportsStore:false}}]});
+    await runtime.setRuntimeApiKey('workbench',process.env.WB_API_KEY);
+    const settings = SettingsManager.inMemory({compaction:{enabled:false},retry:{enabled:false,maxRetries:0}});
+    const loader = new DefaultResourceLoader({cwd:process.cwd(),agentDir:process.cwd(),settingsManager:settings,noExtensions:true,noSkills:true,noPromptTemplates:true,noThemes:true,noContextFiles:true,systemPromptOverride:()=>req.system});
+    await loader.reload();
+    const query = defineTool({name:'query_business',label:'业务查询',description:'Read authorized snapshot. Use the returned datasetId and row fields for bound UI. Follow nextOffset for complete coverage.',parameters:Type.Object({source:Type.Union(['issue','project','comment','topic','conclusion','blueprint','resource','dependency'].map(x=>Type.Literal(x))),projectId:Type.Optional(Type.String()),status:Type.Optional(Type.String()),text:Type.Optional(Type.String()),relatedId:Type.Optional(Type.String()),offset:Type.Optional(Type.Integer({minimum:0})),limit:Type.Optional(Type.Integer({minimum:1,maximum:80}))}),execute:async(callId,args)=>{
+      if (++state.tools>16 || ++state.turnTools>8) throw Error('tool budget exhausted');
+      const result = await new Promise((resolve,reject)=>{replies.set(callId,{resolve,reject}); send({type:'tool_request',runId:req.runId,callId,query:args});});
+      return {content:[{type:'text',text:JSON.stringify(result)}],details:{}};
+    }});
+    const {session} = await createAgentSession({cwd:process.cwd(),agentDir:process.cwd(),model:runtime.getModel('workbench',req.model),modelRuntime:runtime,thinkingLevel:'off',tools:['query_business'],customTools:[query],resourceLoader:loader,settingsManager:settings,sessionManager:SessionManager.inMemory()});
+    state.session=session;
+    const original = session.agent.streamFunction;
+    session.agent.streamFunction = (model,context,options)=>{
+      if (state.cancelled) throw Error('cancelled');
+      if (state.calls >= MAX_MODEL_REQUESTS) {state.failure='request_budget_exhausted';throw Error(state.failure);}
+      state.calls++;
+      state.turnTools=0;
+      send({type:'request',runId:req.runId,calls:state.calls});
+      return original(model,context,{...options,maxRetries:0,maxTokens:10000,temperature:0.2,
+        onPayload:payload=>queryPayload(payload,state.calls,state.allowTools!==false),
+        fetch:async(input,init)=>{
+          if(++state.httpCalls>MAX_MODEL_REQUESTS){state.failure='request_budget_exhausted';throw Error(state.failure);}
+          const response=await fetch(input,init);if(!response.body)return response;
+          let buffer='';let observed=false;const decoder=new TextDecoder();
+          const stream=response.body.pipeThrough(new TransformStream({transform(chunk,controller){
+            controller.enqueue(chunk);if(observed)return;buffer+=decoder.decode(chunk,{stream:true});
+            let end;while((end=buffer.indexOf('\n'))>=0){const line=buffer.slice(0,end);buffer=buffer.slice(end+1);if(line.startsWith('data: ')){try{const event=JSON.parse(line.slice(6));if(typeof event.model==='string'){observed=true;send({type:'actual_model',runId:req.runId,model:event.model});break;}}catch{}}}
+            if(buffer.length>65536)buffer='';
+          }}));return new Response(stream,{status:response.status,statusText:response.statusText,headers:response.headers});
+        }});
+    };
+    session.subscribe(e=>{
+      if(e.type==='message_start'&&e.message.role==='assistant') {state.attempt++;send({type:'attempt',runId:req.runId,attemptId:state.attempt});}
+      if(e.type==='message_update'&&e.assistantMessageEvent.type==='text_delta') send({type:'text_delta',runId:req.runId,attemptId:state.attempt,text:e.assistantMessageEvent.delta});
+      if(e.type==='message_end'&&e.message.role==='assistant') {
+        const m=e.message;
+        send({type:'message_end',runId:req.runId,attemptId:state.attempt,text:m.content.filter(x=>x.type==='text').map(x=>x.text).join(''),stopReason:m.stopReason,model:m.model,usage:m.usage});
+      }
+    });
+    send({type:'ready',runId:req.runId,runtime:'pi@0.84.2',tools:session.getActiveToolNames(),extensions:loader.getExtensions().extensions.length,skills:loader.getSkills().skills.length,contextFiles:loader.getAgentsFiles().agentsFiles.length});
+    timer=setTimeout(()=>{state.cancelled=true;void session.abort();},180000);
+    if(state.cancelled) throw Error('cancelled');
+    await session.prompt(req.prompt);
+    // Go validates the stream before allowing the single targeted repair.
+    const verdict=await new Promise((resolve,reject)=>{replies.set('verdict',{resolve,reject});send({type:'validate',runId:req.runId});});
+    if(verdict.repair && !state.cancelled && state.calls<MAX_MODEL_REQUESTS) {
+      state.allowTools=verdict.allowTools;
+      send({type:'repair',runId:req.runId});
+      await session.prompt(verdict.repair);
+    }
+    const last=session.messages.filter(x=>x.role==='assistant').at(-1);
+    send({type:'settled',runId:req.runId,error:state.cancelled?'cancelled':state.failure||(last?.stopReason==='error'?'provider_error':last?.stopReason==='aborted'?'cancelled':''),calls:state.calls});
+  } catch { send({type:'settled',runId:req.runId,error:state.cancelled?'cancelled':state.failure||'runtime_error',calls:state.calls}); }
+  finally {clearTimeout(timer);state.session?.dispose();for(const p of replies.values())p.reject(Error('settled'));replies.clear();active=null;}
+}
+const rl=readline.createInterface({input:process.stdin,crlfDelay:Infinity});
+rl.on('line',line=>{
+  if(line.length>1048576) process.exit(2);
+  let req;try{req=JSON.parse(line);}catch{process.exit(2);}
+  if(req.type==='run')void run(req);
+  else if(req.runId===active?.runId && req.type==='abort') {active.cancelled=true;for(const p of replies.values())p.reject(Error('cancelled'));replies.clear();void active.session?.abort();}
+  else if(req.runId===active?.runId && req.type==='tool_result') {const p=replies.get(req.callId);replies.delete(req.callId);p?.resolve(req.result);}
+});
+rl.on('close',()=>{if(active){active.cancelled=true;void active.session?.abort();}setTimeout(()=>process.exit(0),200).unref();});
+
+// Module loading is complete; no provider request is made during warmup.
+send({type:'runtime_ready'});
diff --git a/server/workbench-pi/main.test.mjs b/server/workbench-pi/main.test.mjs
new file mode 100644
index 000000000..67bc2803d
--- /dev/null
+++ b/server/workbench-pi/main.test.mjs
@@ -0,0 +1,34 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import {spawn} from 'node:child_process';
+import readline from 'node:readline';
+import {mkdtemp,rm} from 'node:fs/promises';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+const script=fileURLToPath(new URL('./main.mjs',import.meta.url));
+async function fixture(handler,body){
+ const dir=await mkdtemp(path.join(path.dirname(script),'.test-'));
+ const server=http.createServer(handler);await new Promise(r=>server.listen(0,'127.0.0.1',r));
+ const child=spawn(process.execPath,[script],{cwd:dir,env:{PATH:process.env.PATH,HOME:dir,WB_API_KEY:'synthetic-test',WB_BASE_URL:`http://127.0.0.1:${server.address().port}/v1`},stdio:['pipe','pipe','pipe']});
+ const events=[];const listeners=[];child.stderr.on('data',data=>{if(process.env.PI_TEST_DIAGNOSTICS)process.stderr.write(data)});
+ readline.createInterface({input:child.stdout}).on('line',line=>{const e=JSON.parse(line);events.push(e);for(const f of listeners)f(e);if(e.type==='validate')write({type:'tool_result',runId:e.runId,callId:'verdict',result:{}});if(e.type==='tool_request')write({type:'tool_result',runId:e.runId,callId:e.callId,result:{rows:[]}});});
+ const write=v=>child.stdin.write(JSON.stringify(v)+'\n');
+ const wait=type=>new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('test timeout')),15000);const f=e=>{if(e.type===type){clearTimeout(timer);resolve(e);}};listeners.push(f);});
+ try{await body({write,wait,events});}finally{child.kill();server.closeAllConnections();await new Promise(r=>server.close(r));await rm(dir,{recursive:true,force:true});}
+}
+const run={type:'run',runId:'test',model:'mock',system:'Use query_business until done.',prompt:'Test'};
+for(const status of [429,500,503])test(`HTTP ${status}: exactly one attempt, no hidden retries`,async()=>{let count=0;await fixture((req,res)=>{count++;res.writeHead(status,{'Content-Type':'application/json'});res.end(JSON.stringify({error:{message:'synthetic provider error'}}));},async({write,wait,events})=>{const end=wait('settled');write(run);const e=await end;assert.ok(e.error);assert.equal(count,1);assert.equal(events.filter(e=>e.type==='request').length,1);assert.ok(!JSON.stringify(events).includes('synthetic-test'));});});
+test('no-response cancellation settles and process can accept next run',async()=>{await fixture(()=>{},async({write,wait,events})=>{const started=wait('request');const end=wait('settled');write(run);await started;write({type:'abort',runId:'test'});const e=await end;assert.equal(e.error,'cancelled');const ready=events.find(e=>e.type==='ready');assert.deepEqual(ready.tools,['query_business']);assert.equal(ready.skills+ready.contextFiles+ready.extensions,0);const nextRequest=wait('request');const nextEnd=wait('settled');write({...run,runId:'next'});await nextRequest;write({type:'abort',runId:'next'});assert.equal((await nextEnd).error,'cancelled');});});
+test('connection interruption fails without retry',async()=>{let count=0;await fixture((req)=>{count++;req.socket.destroy();},async({write,wait})=>{const end=wait('settled');write(run);assert.ok((await end).error);assert.equal(count,1);});});
+test('tool loop counts actual requests and stops at five',async()=>{let count=0;await fixture((req,res)=>{count++;req.resume();res.writeHead(200,{'Content-Type':'text/event-stream'});const chunk=(delta,finish_reason=null)=>res.write('data: '+JSON.stringify({id:'mock',object:'chat.completion.chunk',model:'mock',choices:[{index:0,delta,finish_reason}]})+'\n\n');chunk({role:'assistant',tool_calls:[{index:0,id:`call${count}`,type:'function',function:{name:'query_business',arguments:'{"source":"issue"}'}}]});chunk({},'tool_calls');res.end('data: [DONE]\n\n');},async({write,wait})=>{const end=wait('settled');write(run);assert.ok((await end).error);assert.equal(count,5);});});
+
+test('warmup announces process readiness without a provider request',async()=>{
+ let requests=0;
+ await fixture((req,res)=>{requests++;res.end();},async({wait,events})=>{
+  await wait('runtime_ready');
+  assert.equal(requests,0);
+  assert.equal(events.filter(e=>e.type==='request').length,0);
+  assert.equal(events.filter(e=>e.type==='ready').length,0);
+ });
+});
