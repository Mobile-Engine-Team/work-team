+
+type projectStartItem struct {
+	IssueID        string   `json:"issue_id"`
+	AssigneeID     string   `json:"assignee_id"`
+	AssigneeType   string   `json:"assignee_type"`
+	PredecessorIDs []string `json:"predecessor_ids"`
+	Title          string   `json:"title"`
+	InputHash      string   `json:"input_hash"`
+	Reason         string   `json:"reason"`
+	TaskID         string   `json:"task_id"`
+	Status         string   `json:"status"`
+}
+
+func (h *Handler) projectStartState(r *http.Request, tx pgx.Tx, p db.Project) (int, []projectStartItem, error) {
+	var number int
+	var raw []byte
+	err := tx.QueryRow(r.Context(), `SELECT number,graph FROM project_blueprint_version WHERE project_id=$1 AND workspace_id=$2 ORDER BY number DESC LIMIT 1`, p.ID, p.WorkspaceID).Scan(&number, &raw)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return 0, []projectStartItem{}, nil
+	}
+	if err != nil {
+		return 0, nil, err
+	}
+	var g projectplan.Graph
+	if err = json.Unmarshal(raw, &g); err != nil {
+		return 0, nil, err
+	}
+	q := h.Queries.WithTx(tx)
+	items := []projectStartItem{}
+	for _, n := range g.Nodes {
+		uid, err := parsePlanUUID(n.IssueID)
+		if err != nil {
+			return 0, nil, err
+		}
+		i, err := q.GetIssueInWorkspace(r.Context(), db.GetIssueInWorkspaceParams{ID: uid, WorkspaceID: p.WorkspaceID})
+		if err != nil {
+			return 0, nil, err
+		}
+		reason := ""
+		var active bool
+		if err = tx.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM agent_task_queue WHERE issue_id=$1 AND status NOT IN ('completed','failed','cancelled'))`, uid).Scan(&active); err != nil {
+			return 0, nil, err
+		}
+		prerequisites := []any{}
+		predecessorIDs := []string{}
+		for _, edge := range g.Edges {
+			if edge.To == n.ID {
+				for _, up := range g.Nodes {
+					if up.ID == edge.From {
+						upID, e := parsePlanUUID(up.IssueID)
+						if e != nil {
+							return 0, nil, e
+						}
+						previous, e := q.GetIssueInWorkspace(r.Context(), db.GetIssueInWorkspaceParams{ID: upID, WorkspaceID: p.WorkspaceID})
+						if e != nil {
+							return 0, nil, e
+						}
+						predecessorIDs = append(predecessorIDs, up.IssueID)
+						prerequisites = append(prerequisites, map[string]any{"id": up.IssueID, "status": previous.Status, "description": previous.Description.String, "handoff": edge.Handoff})
+						if previous.Status != "done" {
+							reason = "等待前置交付：" + previous.Title
+						}
+					}
+				}
+			}
+		}
+		if !i.AssigneeID.Valid {
+			reason = "请先指定负责人"
+		}
+		if i.AssigneeType.String == "member" && i.Status != "backlog" {
+			reason = "已安排给成员，请在任务页跟进"
+			if i.Status == "in_progress" {
+				reason = "任务进行中，请在任务页跟进"
+			}
+			if i.Status == "in_review" {
+				reason = "任务审核中，请在任务页核对交付"
+			}
+		}
+		var arranged bool
+		if err = tx.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM project_start_request WHERE project_id=$1 AND issue_id=$2 AND result->>'status' IN ('notified','queued') AND (COALESCE(result->>'assignee_id','')='' OR result->>'assignee_id'=$3))`, p.ID, uid, uuidToString(i.AssigneeID)).Scan(&arranged); err != nil {
+			return 0, nil, err
+		}
+		if arranged {
+			if i.AssigneeType.String == "member" {
+				switch i.Status {
+				case "in_progress":
+					reason = "任务进行中，请在任务页跟进"
+				case "in_review":
+					reason = "任务审核中，请在任务页核对交付"
+				default:
+					reason = "已通知负责人，请在任务页跟进"
+				}
+			} else {
+				reason = "已请求智能体执行，请在任务页跟进或重试运行"
+			}
+		}
+		if active {
+			reason = "任务已有活动运行"
+		}
+		if i.Status == "done" || i.Status == "cancelled" {
+			reason = "任务已完成，无需再次推进"
+			if i.Status == "cancelled" {
+				reason = "任务已取消，不能推进"
+			}
+		}
+		body, _ := json.Marshal([]any{number, i.Title, i.Description.String, i.AssigneeType.String, uuidToString(i.AssigneeID), i.Status, prerequisites})
+		hash := sha256.Sum256(body)
+		items = append(items, projectStartItem{AssigneeID: uuidToString(i.AssigneeID), AssigneeType: i.AssigneeType.String, PredecessorIDs: predecessorIDs, IssueID: n.IssueID, Title: i.Title, InputHash: hex.EncodeToString(hash[:]), Reason: reason, Status: "ready"})
+	}
+	return number, items, nil
+}
+func parsePlanUUID(id string) (pgtype.UUID, error) {
+	var v pgtype.UUID
+	err := v.Scan(id)
+	return v, err
+}
+func (h *Handler) StartProjectTasks(w http.ResponseWriter, r *http.Request) {
+	p, m, ok := h.projectAccess(w, r, r.Method != "GET", false)
+	if !ok {
+		return
+	}
+	svc := service.BlueprintService{Issues: h.IssueService}
+	if r.Method == "GET" {
+		tx, err := svc.Begin(r.Context(), p)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		defer tx.Rollback(r.Context())
+		v, items, err := h.projectStartState(r, tx, p)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		writeJSON(w, 200, map[string]any{"version": v, "items": items})
+		return
+	}
+	var req struct {
+		Version   int                `json:"version"`
+		RequestID string             `json:"request_id"`
+		Items     []projectStartItem `json:"items"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	if req.RequestID == "" || len(req.RequestID) > 100 || len(req.Items) > 100 {
+		writeError(w, 422, "开始请求无效")
+		return
+	}
+	results := []projectStartItem{}
+	for _, item := range req.Items {
+		result := item
+		result.Status = "failed"
+		result.Reason = ""
+		uid, valid := parsePlanUUID(item.IssueID)
+		if valid != nil {
+			result.Reason = "任务标识无效"
+			results = append(results, result)
+			continue
+		}
+		err := func() error {
+			tx, e := svc.Begin(r.Context(), p)
+			if e != nil {
+				return e
+			}
+			defer tx.Rollback(r.Context())
+			var previous []byte
+			e = tx.QueryRow(r.Context(), `SELECT result FROM project_start_request WHERE project_id=$1 AND issue_id=$2 AND request_id=$3`, p.ID, uid, req.RequestID).Scan(&previous)
+			if e == nil {
+				return json.Unmarshal(previous, &result)
+			}
+			if !errors.Is(e, pgx.ErrNoRows) {
+				return e
+			}
+			var locked pgtype.UUID
+			if e = tx.QueryRow(r.Context(), "SELECT id FROM issue WHERE id=$1 AND workspace_id=$2 AND project_id=$3 FOR UPDATE", uid, p.WorkspaceID, p.ID).Scan(&locked); e != nil {
+				return e
+			}
+			v, states, e := h.projectStartState(r, tx, p)
+			if e != nil {
+				return e
+			}
+			if v != req.Version {
+				return errors.New("计划版本已更新，请重新核对")
+			}
+			found := false
+			for _, state := range states {
+				if state.IssueID == item.IssueID {
+					found = true
+					result.Title = state.Title
+					result.AssigneeID = state.AssigneeID
+					result.AssigneeType = state.AssigneeType
+					result.PredecessorIDs = state.PredecessorIDs
+					if state.Reason != "" {
+						return errors.New(state.Reason)
+					}
+					if state.InputHash != item.InputHash {
+						return errors.New("任务或前置输入已变化，请重新核对")
+					}
+				}
+			}
+			if !found {
+				return errors.New("任务不在当前计划")
+			}
+			q := h.Queries.WithTx(tx)
+			i, e := q.GetIssueInWorkspace(r.Context(), db.GetIssueInWorkspaceParams{ID: uid, WorkspaceID: p.WorkspaceID})
+			if e != nil {
+				return e
+			}
+			if status, msg := h.validateAssigneePair(r.Context(), r, uuidToString(p.WorkspaceID), i.AssigneeType, i.AssigneeID); status != 0 {
+				return errors.New(msg)
+			}
+			if _, e = tx.Exec(r.Context(), "UPDATE issue SET status=CASE WHEN status='backlog' THEN 'todo' ELSE status END,updated_at=now() WHERE id=$1", uid); e != nil {
+				return e
+			}
+			if i.Status == "backlog" {
+				i.Status = "todo"
+			}
+			var task db.AgentTaskQueue
+			if i.AssigneeType.String == "member" {
+				_, e = q.CreateInboxItem(r.Context(), db.CreateInboxItemParams{WorkspaceID: p.WorkspaceID, RecipientType: "member", RecipientID: i.AssigneeID, Type: "issue_assigned", Severity: "info", IssueID: i.ID, Title: i.Title, Body: pgtype.Text{String: "项目已明确安排此任务，请查看生效计划与前置交付。", Valid: true}, ActorType: pgtype.Text{String: "member", Valid: true}, ActorID: m.UserID, Details: []byte(`{}`)})
+				result.Status = "notified"
+			} else {
+				task, e = h.TaskService.EnqueueProjectTaskInTransaction(r.Context(), tx, i, m.UserID)
+				result.TaskID = uuidToString(task.ID)
+				result.Status = "queued"
+			}
+			if e != nil {
+				return e
+			}
+			raw, _ := json.Marshal(result)
+			if _, e = tx.Exec(r.Context(), `INSERT INTO project_start_request(project_id,issue_id,request_id,result) VALUES($1,$2,$3,$4)`, p.ID, uid, req.RequestID, raw); e != nil {
+				return e
+			}
+			if e = tx.Commit(r.Context()); e != nil {
+				return e
+			}
+			if task.ID.Valid {
+				h.TaskService.ProjectTaskCommitted(r.Context(), task)
+			}
+			h.projectChanged(r, p)
+			return nil
+		}()
+		if err != nil {
+			result.Status = "failed"
+			result.Reason = err.Error()
+		}
+		results = append(results, result)
+	}
+	writeJSON(w, 200, map[string]any{"items": results})
+}
