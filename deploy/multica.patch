+package agent
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestTaskDraftProviderIsolation(t *testing.T) {
+	for _, provider := range []string{"codex", "claude", "opencode", "mc"} {
+		t.Run(provider, func(t *testing.T) {
+			root := t.TempDir()
+			executable := filepath.Join(root, "fake-cli")
+			t.Setenv("MULTICA_TOKEN", "must-not-leak")
+			t.Setenv("NODE_OPTIONS", "must-not-run")
+			t.Setenv("CODEX_HOME", filepath.Join(root, "auth"))
+			t.Setenv("CLAUDE_CONFIG_DIR", filepath.Join(root, "auth"))
+			t.Setenv("XDG_DATA_HOME", filepath.Join(root, "auth"))
+			t.Setenv("HOME", root)
+			if provider == "mc" {
+				dir := filepath.Join(root, "mobile-coder", "config", "mobile-coder")
+				os.MkdirAll(dir, 0700)
+				os.WriteFile(filepath.Join(dir, "mobile-coder.json"), []byte(`{"model":"test-model","plugin":["must-not-load"]}`), 0600)
+			}
+			event := `{"type":"item.completed","item":{"type":"agent_message","text":"draft"}}`
+			check := `case " $* " in *" --sandbox read-only "*) ;; *) exit 20;; esac`
+			if provider == "claude" {
+				event = `{"type":"result","result":"draft"}`
+				check = `case " $* " in *" --strict-mcp-config "*) ;; *) exit 21;; esac`
+			}
+			if provider == "opencode" {
+				event = `{"type":"text","part":{"text":"draft"}}`
+				check = `case "$OPENCODE_CONFIG_CONTENT" in *'"*":"deny"'*) ;; *) exit 22;; esac`
+			}
+			if provider == "mc" {
+				event = `{"type":"text","part":{"text":"draft"}}`
+				check = `case "$MOBILE_CODER_CONFIG_CONTENT" in *'"*":"deny"'*) ;; *) exit 25;; esac
+case "$MOBILE_CODER_CONFIG_CONTENT" in *'must-not-load'*) exit 26;; esac`
+			}
+			script := "#!/bin/sh\n[ -z \"$MULTICA_TOKEN\" ] || exit 23\n[ -z \"$NODE_OPTIONS\" ] || exit 24\n" + check + "\ncat >/dev/null\nprintf '%s\\n' '" + event + "'\n"
+			script = strings.ReplaceAll(script, `\"`, `"`)
+			os.WriteFile(executable, []byte(script), 0700)
+			out, err := RunTaskDraft(context.Background(), provider, executable, "test-model", "only selected input", root)
+			if err != nil || out != "draft" {
+				t.Fatalf("result=%q error=%v", out, err)
+			}
+			entries, _ := os.ReadDir(root)
+			for _, e := range entries {
+				if strings.HasPrefix(e.Name(), "task-draft-") {
+					t.Fatal("temporary credentials remain")
+				}
+			}
+		})
+	}
+}
+
+func TestTaskDraftStaticCredentialReferences(t *testing.T) {
+	dir := t.TempDir()
+	os.WriteFile(filepath.Join(dir, "credential"), []byte("fixture-key\n"), 0600)
+	value, err := resolveTaskDraftConfigReferences(map[string]any{"apiKey": "{file:credential}"}, dir)
+	if err != nil || value.(map[string]any)["apiKey"] != "fixture-key" {
+		t.Fatal("static file credential was not resolved")
+	}
+}
