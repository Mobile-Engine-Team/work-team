+package agent
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestReadOnlyPlanningIsolation(t *testing.T) {
+	root := t.TempDir()
+	credentials := filepath.Join(root, "source")
+	os.MkdirAll(credentials, 0700)
+	os.WriteFile(filepath.Join(credentials, "auth.json"), []byte(`{"test":{"type":"api_key","key":"test-only"}}`), 0600)
+	executable := filepath.Join(root, "fake-pi")
+	script := `#!/bin/sh
+case " $* " in *" --no-tools "*) ;; *) exit 21;; esac
+case " $* " in *" --no-context-files "*) ;; *) exit 22;; esac
+case " $* " in *" --no-extensions "*) ;; *) exit 23;; esac
+[ -z "$MULTICA_TOKEN" ] || exit 24
+[ -z "$NODE_OPTIONS" ] || exit 25
+[ -f "$PI_CODING_AGENT_DIR/auth.json" ] || exit 26
+cat >/dev/null
+printf '%s\n' '{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"{\"schema_version\":1,\"changes\":[],\"questions\":[]}"}]}}'
+`
+	os.WriteFile(executable, []byte(script), 0700)
+	t.Setenv("MULTICA_TOKEN", "must-not-leak")
+	t.Setenv("NODE_OPTIONS", "must-not-run")
+	output, err := RunReadOnlyPlanning(context.Background(), executable, "test-model", "explicit selected input", credentials, root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(output, "schema_version") {
+		t.Fatal(output)
+	}
+	entries, _ := os.ReadDir(root)
+	for _, entry := range entries {
+		if strings.HasPrefix(entry.Name(), "planning-") {
+			t.Fatal("ephemeral credentials left behind")
+		}
+	}
+}
+func TestReadOnlyPlanningRejectsExecutableCredentials(t *testing.T) {
+	root := t.TempDir()
+	os.WriteFile(filepath.Join(root, "auth.json"), []byte(`{"apiKey":"!secret-command"}`), 0600)
+	_, err := RunReadOnlyPlanning(context.Background(), filepath.Join(root, "must-not-exist"), "", "", root, root)
+	if err == nil || !strings.Contains(err.Error(), "命令") {
+		t.Fatal(err)
+	}
+}
diff --git a/server/pkg/agent/task_draft.go b/server/pkg/agent/task_draft.go
new file mode 100644
index 000000000..7523c0769
--- /dev/null
+++ b/server/pkg/agent/task_draft.go
@@ -0,0 +1,298 @@
+package agent
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+// Task drafting uses the installed CLI with a temporary configuration and no
+// collaboration credentials. Normal business runs keep their original setup.
+func RunTaskDraft(ctx context.Context, provider, executable, model, prompt, scratch string) (string, error) {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return "", err
+	}
+	if provider == "pi" {
+		config := os.Getenv("PI_CODING_AGENT_DIR")
+		if config == "" {
+			config = filepath.Join(home, ".pi", "agent")
+		}
+		if model == "" {
+			if raw, e := os.ReadFile(filepath.Join(config, "settings.json")); e == nil {
+				var settings struct {
+					Provider string `json:"defaultProvider"`
+					Model    string `json:"defaultModel"`
+				}
+				if json.Unmarshal(raw, &settings) == nil && settings.Model != "" {
+					model = settings.Model
+					if settings.Provider != "" {
+						model = settings.Provider + "/" + model
+					}
+				}
+			}
+		}
+		result, err := RunReadOnlyPlanning(ctx, executable, model, prompt, config, scratch)
+		if err != nil {
+			return "", fmt.Errorf("任务草稿执行失败，请检查所选工具的模型认证与版本")
+		}
+		return result, nil
+	}
+	dir, err := os.MkdirTemp(scratch, "task-draft-")
+	if err != nil {
+		return "", err
+	}
+	defer os.RemoveAll(dir)
+	env := []string{"HOME=" + dir, "PATH=" + os.Getenv("PATH"), "XDG_CONFIG_HOME=" + filepath.Join(dir, "config"), "XDG_DATA_HOME=" + filepath.Join(dir, "data"), "XDG_CACHE_HOME=" + filepath.Join(dir, "cache")}
+	for _, key := range []string{"HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY", "NO_PROXY", "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS", "OPENAI_API_KEY", "OPENAI_BASE_URL", "ANTHROPIC_API_KEY", "ANTHROPIC_BASE_URL"} {
+		if v, ok := os.LookupEnv(key); ok {
+			env = append(env, key+"="+v)
+		}
+	}
+	copyAuth := func(source, target string) error {
+		raw, e := os.ReadFile(source)
+		if os.IsNotExist(e) {
+			return nil
+		}
+		if e != nil {
+			return e
+		}
+		if e = os.MkdirAll(filepath.Dir(target), 0700); e != nil {
+			return e
+		}
+		return os.WriteFile(target, raw, 0600)
+	}
+	var args []string
+	switch provider {
+	case "codex":
+		source := os.Getenv("CODEX_HOME")
+		if source == "" {
+			source = filepath.Join(home, ".codex")
+		}
+		target := filepath.Join(dir, ".codex")
+		if err = copyAuth(filepath.Join(source, "auth.json"), filepath.Join(target, "auth.json")); err != nil {
+			return "", err
+		}
+		env = append(env, "CODEX_HOME="+target)
+		args = []string{"exec", "--ignore-user-config", "--ignore-rules", "--ephemeral", "--skip-git-repo-check", "--sandbox", "read-only", "--json", "-c", "approval_policy=\"never\"", "-c", "features.shell_tool=false", "-c", "features.unified_exec=false", "-c", "features.hooks=false", "-c", "features.multi_agent=false", "-c", "web_search=\"disabled\"", "-c", "project_doc_max_bytes=0"}
+		if model != "" {
+			args = append(args, "--model", model)
+		}
+		args = append(args, "-")
+	case "claude":
+		source := os.Getenv("CLAUDE_CONFIG_DIR")
+		if source == "" {
+			source = filepath.Join(home, ".claude")
+		}
+		// Import only static model credentials, never hooks, plugins or commands.
+		if raw, e := os.ReadFile(filepath.Join(source, "settings.json")); e == nil {
+			var settings struct {
+				Env   map[string]string `json:"env"`
+				Model string            `json:"model"`
+			}
+			if e = json.Unmarshal(raw, &settings); e != nil {
+				return "", fmt.Errorf("模型配置无效")
+			}
+			for _, key := range []string{"ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL"} {
+				if value := settings.Env[key]; value != "" {
+					env = append(env, key+"="+value)
+				}
+			}
+			if model == "" {
+				model = settings.Model
+			}
+		} else if !os.IsNotExist(e) {
+			return "", e
+		}
+		target := filepath.Join(dir, ".claude")
+		if err = copyAuth(filepath.Join(source, ".credentials.json"), filepath.Join(target, ".credentials.json")); err != nil {
+			return "", err
+		}
+		env = append(env, "CLAUDE_CONFIG_DIR="+target)
+		args = []string{"--print", "--output-format", "stream-json", "--verbose", "--safe-mode", "--restricted", "--tools", "", "--strict-mcp-config", "--mcp-config", "{\"mcpServers\":{}}", "--setting-sources", "", "--disable-slash-commands", "--no-session-persistence"}
+		if model != "" {
+			args = append(args, "--model", model)
+		}
+	case "mc":
+		source := filepath.Join(home, "mobile-coder", "config", "mobile-coder", "mobile-coder.json")
+		raw, e := os.ReadFile(source)
+		if e != nil {
+			return "", fmt.Errorf("Mobile Coder 模型配置不可用")
+		}
+		var native map[string]json.RawMessage
+		if json.Unmarshal(raw, &native) != nil {
+			return "", fmt.Errorf("Mobile Coder 模型配置无效")
+		}
+		safe := map[string]any{"permission": map[string]string{"*": "deny"}, "mcp": map[string]any{}, "plugin": []string{}, "instructions": []string{}}
+		for _, key := range []string{"provider", "model", "enabled_providers", "disabled_providers"} {
+			if value, ok := native[key]; ok {
+				var resolved any
+				if json.Unmarshal(value, &resolved) != nil {
+					return "", fmt.Errorf("Mobile Coder 模型配置无效")
+				}
+				resolved, e = resolveTaskDraftConfigReferences(resolved, filepath.Dir(source))
+				if e != nil {
+					return "", fmt.Errorf("Mobile Coder 模型凭据引用不可用")
+				}
+				safe[key] = resolved
+			}
+		}
+		raw, e = json.Marshal(safe)
+		if e != nil {
+			return "", e
+		}
+		target := filepath.Join(dir, "mobile-coder", "config", "mobile-coder", "mobile-coder.json")
+		if e = os.MkdirAll(filepath.Dir(target), 0700); e != nil {
+			return "", e
+		}
+		if e = os.WriteFile(target, raw, 0600); e != nil {
+			return "", e
+		}
+		env = append(env, "MOBILE_CODER_CONFIG_CONTENT="+string(raw))
+		args = []string{"run", "--format", "json"}
+		if model != "" {
+			args = append(args, "--model", model)
+		}
+	case "opencode":
+		source := os.Getenv("XDG_DATA_HOME")
+		if source == "" {
+			source = filepath.Join(home, ".local", "share")
+		}
+		if err = copyAuth(filepath.Join(source, "opencode", "auth.json"), filepath.Join(dir, "data", "opencode", "auth.json")); err != nil {
+			return "", err
+		}
+		env = append(env, "OPENCODE_DISABLE_PROJECT_CONFIG=1", "OPENCODE_CONFIG_CONTENT={\"permission\":{\"*\":\"deny\"},\"mcp\":{},\"plugin\":[],\"instructions\":[],\"share\":\"disabled\"}")
+		args = []string{"run", "--pure", "--format", "json"}
+		if model != "" {
+			args = append(args, "--model", model)
+		}
+	default:
+		return "", fmt.Errorf("此工具尚不支持任务草稿生成")
+	}
+	cmd := newRuntimeCmd(exec.CommandContext(ctx, executable, args...))
+	cmd.Dir = dir
+	cmd.Env = env
+	cmd.Stdin = strings.NewReader(prompt)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return "", err
+	}
+	if err = startOwnedProcessTree(cmd, slog.Default()); err != nil {
+		return "", err
+	}
+	scan := bufio.NewScanner(stdout)
+	scan.Buffer(make([]byte, 64*1024), 2<<20)
+	var output string
+	var failure error
+	for scan.Scan() {
+		var event struct {
+			Type    string `json:"type"`
+			Result  string `json:"result"`
+			IsError bool   `json:"is_error"`
+			Item    struct {
+				Type string `json:"type"`
+				Text string `json:"text"`
+			} `json:"item"`
+			Part struct {
+				Type string `json:"type"`
+				Text string `json:"text"`
+			} `json:"part"`
+			Message struct {
+				Content []struct {
+					Type string `json:"type"`
+				} `json:"content"`
+			} `json:"message"`
+		}
+		if json.Unmarshal(scan.Bytes(), &event) != nil {
+			continue
+		}
+		tool := event.Type == "tool_use" || event.Item.Type == "command_execution" || event.Item.Type == "mcp_tool_call" || event.Item.Type == "file_change"
+		for _, c := range event.Message.Content {
+			if c.Type == "tool_use" {
+				tool = true
+			}
+		}
+		if tool {
+			failure = fmt.Errorf("任务草稿生成违反受限工具协议")
+			cmd.Cancel()
+			break
+		}
+		if event.Type == "error" || event.Type == "turn.failed" || event.IsError {
+			failure = fmt.Errorf("任务草稿模型调用失败")
+		}
+		if provider == "codex" && event.Type == "item.completed" && event.Item.Type == "agent_message" {
+			output = event.Item.Text
+		}
+		if provider == "claude" && event.Type == "result" {
+			output = event.Result
+		}
+		if (provider == "opencode" || provider == "mc") && event.Type == "text" {
+			output += event.Part.Text
+		}
+	}
+	waitErr := cmd.Wait()
+	releaseProcessGroup(cmd)
+	if failure != nil {
+		return "", failure
+	}
+	if scan.Err() != nil {
+		return "", scan.Err()
+	}
+	if ctx.Err() != nil {
+		return "", ctx.Err()
+	}
+	if waitErr != nil {
+		return "", fmt.Errorf("任务草稿执行失败，请检查所选工具的模型认证与版本")
+	}
+	if strings.TrimSpace(output) == "" {
+		return "", fmt.Errorf("任务草稿未返回文本")
+	}
+	return output, nil
+}
+
+// Resolve only static references from the user's native model configuration.
+func resolveTaskDraftConfigReferences(value any, directory string) (any, error) {
+	switch v := value.(type) {
+	case string:
+		if strings.HasPrefix(v, "{file:") && strings.HasSuffix(v, "}") {
+			path := strings.TrimSuffix(strings.TrimPrefix(v, "{file:"), "}")
+			if !filepath.IsAbs(path) {
+				path = filepath.Join(directory, path)
+			}
+			raw, err := os.ReadFile(path)
+			if err != nil {
+				return nil, err
+			}
+			return strings.TrimSpace(string(raw)), nil
+		}
+		if strings.HasPrefix(v, "{env:") && strings.HasSuffix(v, "}") {
+			return os.Getenv(strings.TrimSuffix(strings.TrimPrefix(v, "{env:"), "}")), nil
+		}
+	case map[string]any:
+		for key, child := range v {
+			resolved, err := resolveTaskDraftConfigReferences(child, directory)
+			if err != nil {
+				return nil, err
+			}
+			v[key] = resolved
+		}
+	case []any:
+		for i, child := range v {
+			resolved, err := resolveTaskDraftConfigReferences(child, directory)
+			if err != nil {
+				return nil, err
+			}
+			v[i] = resolved
+		}
+	}
+	return value, nil
+}
