new file mode 100644
index 000000000..9bfc28988
--- /dev/null
+++ b/server/internal/handler/demo_password.go
@@ -0,0 +1,85 @@
+package handler
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"os"
+	"regexp"
+	"strings"
+
+	"github.com/jackc/pgx/v5/pgconn"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+	"golang.org/x/crypto/bcrypt"
+)
+
+const demoEmailSuffix = "@demo.mobilework.invalid"
+
+var demoUsername = regexp.MustCompile(`^[a-z0-9][a-z0-9_.-]{1,39}$`)
+
+func demoPasswordEnabled() bool {
+	return os.Getenv("MW_DEMO_PASSWORD_AUTH") == "1" && !isProductionEnv()
+}
+
+// Password accounts occupy a separate namespace and cannot claim an existing email identity.
+func (h *Handler) DemoPasswordAuth(w http.ResponseWriter, r *http.Request) {
+	if !demoPasswordEnabled() {
+		writeError(w, http.StatusNotFound, "not found")
+		return
+	}
+	var req struct {
+		Username string `json:"username"`
+		Password string `json:"password"`
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 4096)
+	if json.NewDecoder(r.Body).Decode(&req) != nil {
+		writeError(w, 400, "invalid_request")
+		return
+	}
+	req.Username = strings.ToLower(strings.TrimSpace(req.Username))
+	if !demoUsername.MatchString(req.Username) || len(req.Password) < 8 || len(req.Password) > 72 {
+		writeError(w, 400, "invalid_credentials_format")
+		return
+	}
+	var user db.User
+	var err error
+	if strings.HasSuffix(r.URL.Path, "/register") {
+		if !h.cfg.AllowSignup {
+			writeError(w, 403, "signup_disabled")
+			return
+		}
+		hash, hashErr := bcrypt.GenerateFromPassword([]byte(req.Password), bcrypt.DefaultCost)
+		if hashErr != nil {
+			writeError(w, 500, "password_hash_failed")
+			return
+		}
+		id, createErr := h.Queries.CreateDemoPasswordAccount(r.Context(), db.CreateDemoPasswordAccountParams{Username: req.Username, Email: req.Username + demoEmailSuffix, PasswordHash: string(hash)})
+		if createErr != nil {
+			var pgErr *pgconn.PgError
+			if errors.As(createErr, &pgErr) && pgErr.Code == "23505" {
+				writeError(w, 409, "username_taken")
+				return
+			}
+			writeError(w, 500, "registration_failed")
+			return
+		}
+		user, err = h.Queries.GetUser(r.Context(), id)
+	} else {
+		account, lookupErr := h.Queries.GetDemoPasswordAccount(r.Context(), req.Username)
+		if lookupErr != nil || bcrypt.CompareHashAndPassword([]byte(account.PasswordHash), []byte(req.Password)) != nil {
+			writeError(w, 401, "invalid_credentials")
+			return
+		}
+		user, err = h.Queries.GetUser(r.Context(), account.UserID)
+	}
+	if err != nil {
+		writeError(w, 500, "account_unavailable")
+		return
+	}
+	token, err := h.issueJWT(user)
+	if err != nil {
+		writeError(w, 403, "account_unavailable")
+		return
+	}
+	writeJSON(w, http.StatusOK, LoginResponse{Token: token, User: h.userToResponse(user)})
+}
