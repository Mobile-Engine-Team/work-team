+package agent
+
+import (
+	"context"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+// Positive unit fixture follows apps/cli/src/cli/cmd/run.handler.ts.
+// Real inference and its session ID are checked separately by the MVP smoke.
+func TestMCStreamAndToolCalls(t *testing.T) {
+	lines := `{"type":"step_start","sessionID":"s","part":{"type":"step-start"}}
+{"type":"permission_allowed","sessionID":"s","permission":"bash","reason":"yolo"}
+{"type":"tool_use","sessionID":"s","part":{"type":"tool","callID":"c","tool":"bash","state":{"status":"completed","input":{"command":"test"},"output":"pass"}}}
+{"type":"step_finish","sessionID":"s","part":{"type":"step-finish","reason":"tool-calls","tokens":{"input":5,"output":2,"cache":{"read":3,"write":0}}}}
+{"type":"step_start","sessionID":"s","part":{"type":"step-start"}}
+{"type":"text","sessionID":"s","part":{"type":"text","text":"complete"}}
+{"type":"step_finish","sessionID":"s","part":{"type":"step-finish","reason":"stop","tokens":{"input":7,"output":3,"cache":{"read":2,"write":1}}}}`
+	ch := make(chan Message, 16)
+	got := (&mcBackend{}).scan(strings.NewReader(lines), ch, "flash")
+	want := TokenUsage{InputTokens: 12, OutputTokens: 5, CacheReadTokens: 5, CacheWriteTokens: 1}
+	if got.Status != "completed" || got.Output != "complete" || got.SessionID != "s" || got.Usage["flash"] != want {
+		t.Fatalf("unexpected result: %+v", got)
+	}
+	close(ch)
+	var tool, paired, permission bool
+	for m := range ch {
+		switch m.Type {
+		case MessageToolUse:
+			tool = m.CallID == "c" && m.Tool == "bash" && m.Input["command"] == "test"
+		case MessageToolResult:
+			paired = m.CallID == "c" && m.Output == "pass"
+		case MessageLog:
+			permission = strings.Contains(m.Content, "permission_allowed")
+		}
+	}
+	if !tool || !paired || !permission {
+		t.Fatalf("tool %v, result %v, permission %v", tool, paired, permission)
+	}
+}
+
+func TestMCUnfinishedOrFailed(t *testing.T) {
+	for _, input := range []string{
+		"",
+		"non-JSON startup",
+		`{"type":"text","sessionID":"s","part":{"text":"not finished"}}`,
+		`{"type":"step_finish","sessionID":"s","part":{"reason":"tool-calls","tokens":{"input":2}}}`,
+		`{"type":"step_finish","sessionID":"s","part":{"reason":"stop"}}`,
+		`{"type":"error","sessionID":"s","error":{"name":"APIError","data":{"message":"permission denied"}}}`,
+	} {
+		ch := make(chan Message, 4)
+		res := (&mcBackend{}).scan(strings.NewReader(input), ch, "flash")
+		if res.Status != "failed" || res.Error == "" {
+			t.Errorf("%q: %+v", input, res)
+		}
+	}
+}
+
+func TestMCLaunchContract(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("single-Mac launch contract")
+	}
+	dir := t.TempDir()
+	executable := filepath.Join(dir, "mc")
+	// A unit-only CLI asserts launch parameters without invoking a model.
+	script := `#!/bin/sh
+set -eu
+test "$1" = run && test "$2" = --format && test "$3" = json || exit 2
+test "$4" = --yolo && test "$5" = --dir && test "$6" = "$PWD" || exit 3
+test "$7" = --model && test "$8" = deepseek/deepseek-v4-flash || exit 4
+test "$9" = --session && test "${10}" = resume && test "$#" = 10 || exit 5
+test "$(cat)" = 'task input' || exit 6
+printf '%s\n' '{"type":"text","sessionID":"resume","part":{"text":"OK"}}' '{"type":"step_finish","sessionID":"resume","part":{"reason":"stop","tokens":{"output":1}}}'
+`
+	if err := os.WriteFile(executable, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	b := &mcBackend{Config{ExecutablePath: executable, Logger: slog.Default()}}
+	s, err := b.Execute(context.Background(), "task input", ExecOptions{
+		Cwd: dir, Model: "deepseek/deepseek-v4-flash", ResumeSessionID: "resume",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for range s.Messages {
+	}
+	if result := <-s.Result; result.Status != "completed" || result.Output != "OK" {
+		t.Fatalf("bad launch: %+v", result)
+	}
+}
+
+// Reduced and anonymized from the pinned CLI's real DeepSeek Flash smoke on
+// 2026-11-05. Stable fields and event order are retained; IDs are replaced.
+func TestMCSmokeRecording(t *testing.T) {
+	transcript := `{"type":"step_start","sessionID":"s","part":{"id":"p1","sessionID":"s","messageID":"m","type":"step-start","snapshot":"tree"}}
+{"type":"text","sessionID":"s","part":{"id":"p2","sessionID":"s","messageID":"m","type":"text","text":"OK","time":{"start":1,"end":2}}}
+{"type":"step_finish","sessionID":"s","part":{"id":"p3","sessionID":"s","messageID":"m","type":"step-finish","reason":"stop","snapshot":"tree","tokens":{"input":1,"output":1}}}`
+	res := (&mcBackend{}).scan(strings.NewReader(transcript), make(chan Message, 8), "deepseek/deepseek-v4-flash")
+	if res.Status != "completed" || res.Output != "OK" || res.SessionID != "s" {
+		t.Fatalf("unexpected smoke record: %+v", res)
+	}
+}
