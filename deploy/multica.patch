+package workbench
+
+import "testing"
+
+func TestAcceptanceWordingDoesNotTurnMissingRecordIntoOutcome(t *testing.T) {
+	read := map[string]Evidence{"issue:a": {Text: "说明文档完成，不等于功能验收"}}
+	for _, text := range []string{"准确转述：审批功能尚未验收。", "审批已经验收。"} {
+		if checkAcceptanceWording(Claim{ID: "c", Text: text, EvidenceIDs: []string{"issue:a"}}, read) == nil {
+			t.Fatal(text)
+		}
+	}
+	for _, text := range []string{"未见验收记录，不能据此说尚未验收。", "文档完成不等于已通过验收。", "没有验收记录。"} {
+		if err := checkAcceptanceWording(Claim{Text: text}, read); err != nil {
+			t.Fatal(err)
+		}
+	}
+	read["comment:b"] = Evidence{Text: "负责人称尚未验收"}
+	if err := checkAcceptanceWording(Claim{Text: "成员说尚未验收", EvidenceIDs: []string{"comment:b"}}, read); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/server/internal/workbench/pi.go b/server/internal/workbench/pi.go
new file mode 100644
index 000000000..b2dc201cc
--- /dev/null
+++ b/server/internal/workbench/pi.go
@@ -0,0 +1,329 @@
+package workbench
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"time"
+)
+
+type ModelOption struct {
+	ID      string `json:"id"`
+	Label   string `json:"label"`
+	Default bool   `json:"default"`
+}
+type PiConfig struct {
+	Key, BaseURL, DefaultModel, Script string
+	EnablePro                          bool
+}
+type Pi struct {
+	config      PiConfig
+	gate        chan struct{}
+	mu          sync.Mutex
+	cmd         *exec.Cmd
+	in          io.WriteCloser
+	events      chan PiEvent
+	lastFailure time.Time
+	ready       bool
+	closed      bool
+	startedAt   time.Time
+}
+type PiEvent struct {
+	Type       string `json:"type"`
+	RunID      string `json:"runId"`
+	CallID     string `json:"callId"`
+	Text       string `json:"text"`
+	Error      string `json:"error"`
+	StopReason string `json:"stopReason"`
+	Model      string `json:"model"`
+	Calls      int    `json:"calls"`
+	AttemptID  int    `json:"attemptId"`
+	Query      Query  `json:"query"`
+	Usage      struct {
+		Input  int64 `json:"input"`
+		Output int64 `json:"output"`
+	} `json:"usage"`
+}
+
+func NewPi(c PiConfig) *Pi {
+	if c.DefaultModel == "" {
+		c.DefaultModel = "deepseek-flash"
+	}
+	return &Pi{config: c, gate: make(chan struct{}, 1)}
+}
+func (p *Pi) Enabled() bool { return p != nil && p.config.Key != "" && p.config.BaseURL != "" }
+
+// Warmup loads dependencies without creating a session or calling a provider.
+// It also restores the shared child after an exit; requests never own startup.
+func (p *Pi) Warmup(ctx context.Context) {
+	if !p.Enabled() {
+		return
+	}
+	ticker := time.NewTicker(5 * time.Second)
+	defer ticker.Stop()
+	defer p.Close()
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		if err := p.start(); err != nil {
+			p.mu.Lock()
+			p.lastFailure = time.Now()
+			p.mu.Unlock()
+			slog.Warn("workbench warmup start failed", "error", err)
+		}
+		p.mu.Lock()
+		if p.cmd != nil && !p.ready && time.Since(p.startedAt) > 180*time.Second {
+			_ = p.cmd.Process.Kill()
+		}
+		p.mu.Unlock()
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
+func (p *Pi) Status() string {
+	if !p.Enabled() {
+		return "disabled"
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || (p.cmd == nil && !p.lastFailure.IsZero()) {
+		return "unavailable"
+	}
+	if p.ready {
+		return "ready"
+	}
+	return "warming"
+}
+func (p *Pi) RequireReady() error {
+	switch p.Status() {
+	case "ready":
+		return nil
+	case "disabled":
+		return fmt.Errorf("工作台模型尚未配置")
+	case "warming":
+		return fmt.Errorf("查询服务正在准备，请稍后发送；草稿已保留")
+	default:
+		return fmt.Errorf("查询服务正在恢复，请稍后重试")
+	}
+}
+func (p *Pi) Models() []ModelOption {
+	a := []ModelOption{}
+	if !p.Enabled() {
+		return a
+	}
+	a = append(a, ModelOption{p.config.DefaultModel, p.config.DefaultModel, true})
+	if p.config.EnablePro && p.config.DefaultModel != "deepseek-v4-pro" {
+		a = append(a, ModelOption{"deepseek-v4-pro", "deepseek-v4-pro", false})
+	}
+	return a
+}
+func (p *Pi) Select(id string) (string, error) {
+	for _, m := range p.Models() {
+		if id == m.ID || id == "" && m.Default {
+			return m.ID, nil
+		}
+	}
+	return "", fmt.Errorf("所选模型不可用，请重新选择模型")
+}
+func (p *Pi) start() error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return fmt.Errorf("查询服务已关闭")
+	}
+	if p.cmd != nil {
+		return nil
+	}
+	if time.Since(p.lastFailure) < time.Second {
+		return fmt.Errorf("查询服务正在恢复，请稍后重试")
+	}
+	script := p.config.Script
+	if script == "" {
+		script = "workbench-pi/main.mjs"
+	}
+	script, err := filepath.Abs(script)
+	if err != nil {
+		return err
+	}
+	empty := filepath.Join(filepath.Dir(script), ".runtime")
+	if err = os.MkdirAll(empty, 0700); err != nil {
+		return err
+	}
+	cmd := exec.Command("node", script)
+	cmd.Dir = empty
+	cmd.Env = []string{"PATH=" + os.Getenv("PATH"), "HOME=" + empty, "WB_API_KEY=" + p.config.Key, "WB_BASE_URL=" + p.config.BaseURL, "NODE_ENV=production"}
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		return err
+	}
+	out, err := cmd.StdoutPipe()
+	if err != nil {
+		return err
+	}
+	cmd.Stderr = io.Discard
+	if err = cmd.Start(); err != nil {
+		return fmt.Errorf("查询运行时不可用，请检查服务安装")
+	}
+	events := make(chan PiEvent, 64)
+	p.cmd = cmd
+	p.ready = false
+	p.startedAt = time.Now()
+	slog.Info("workbench warmup started")
+	p.in = in
+	p.events = events
+	go func() {
+		s := bufio.NewScanner(out)
+		s.Buffer(make([]byte, 4096), 1024*1024)
+		for s.Scan() {
+			var e PiEvent
+			if json.Unmarshal(s.Bytes(), &e) != nil {
+				break
+			}
+			if e.Type == "runtime_ready" {
+				p.mu.Lock()
+				if p.cmd == cmd {
+					p.ready = true
+					slog.Info("workbench warmup ready", "duration", time.Since(p.startedAt))
+				}
+				p.mu.Unlock()
+				continue
+			}
+			events <- e
+		}
+		_ = cmd.Wait()
+		p.mu.Lock()
+		if p.cmd == cmd {
+			p.cmd = nil
+			p.ready = false
+			p.lastFailure = time.Now()
+		}
+		p.mu.Unlock()
+		close(events)
+	}()
+	return nil
+}
+func (p *Pi) write(v any) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.cmd == nil {
+		return io.EOF
+	}
+	b, e := json.Marshal(v)
+	if e != nil {
+		return e
+	}
+	_, e = p.in.Write(append(b, '\n'))
+	return e
+}
+
+// A single persistent child, bounded admission, and no automatic rerun after EOF.
+func (p *Pi) Run(ctx context.Context, id, model, system, prompt string, receive func(PiEvent) (any, error)) error {
+	queue := time.NewTimer(15 * time.Second)
+	defer queue.Stop()
+	select {
+	case p.gate <- struct{}{}:
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-queue.C:
+		return fmt.Errorf("查询服务繁忙，请稍后重试")
+	}
+	defer func() { <-p.gate }()
+	if err := p.RequireReady(); err != nil {
+		return err
+	}
+	p.mu.Lock()
+	events := p.events
+	p.mu.Unlock()
+	if err := p.write(map[string]any{"type": "run", "runId": id, "model": model, "system": system, "prompt": prompt}); err != nil {
+		return err
+	}
+	abort := func() {
+		_ = p.write(map[string]any{"type": "abort", "runId": id})
+		timer := time.NewTimer(2 * time.Second)
+		defer timer.Stop()
+		for {
+			select {
+			case e, ok := <-events:
+				if !ok || e.Type == "settled" {
+					return
+				}
+			case <-timer.C:
+				p.mu.Lock()
+				if p.cmd != nil {
+					_ = p.cmd.Process.Kill()
+					_ = p.in.Close()
+					// Detach before releasing admission. A queued explicit request
+					// must never write into the child we just killed for cancellation.
+					p.cmd = nil
+					p.ready = false
+					p.in = nil
+					p.lastFailure = time.Time{}
+				}
+				p.mu.Unlock()
+				go func() {
+					for range events {
+					}
+				}()
+				return
+			}
+		}
+	}
+	for {
+		select {
+		case <-ctx.Done():
+			abort()
+			return ctx.Err()
+		case e, ok := <-events:
+			if !ok {
+				return fmt.Errorf("查询服务已中断，请明确重试")
+			}
+			if e.RunID != id {
+				continue
+			}
+			response, err := receive(e)
+			if err != nil {
+				abort()
+				return err
+			}
+			if e.Type == "tool_request" || e.Type == "validate" {
+				call := e.CallID
+				if e.Type == "validate" {
+					call = "verdict"
+				}
+				if err = p.write(map[string]any{"type": "tool_result", "runId": id, "callId": call, "result": response}); err != nil {
+					return err
+				}
+			}
+			if e.Type == "settled" {
+				if e.Error != "" {
+					return fmt.Errorf("模型请求未完成（%s），请明确重试", e.Error)
+				}
+				return nil
+			}
+		}
+	}
+}
+
+func (p *Pi) Close() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.closed = true
+	p.ready = false
+	if p.in != nil {
+		_ = p.in.Close()
+	}
+	if p.cmd != nil {
+		_ = p.cmd.Process.Kill()
+	}
+}
diff --git a/server/internal/workbench/pi_test.go b/server/internal/workbench/pi_test.go
new file mode 100644
index 000000000..8d2208a07
--- /dev/null
+++ b/server/internal/workbench/pi_test.go
@@ -0,0 +1,95 @@
+package workbench
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestPiForcedCancellationDoesNotReuseDyingChild(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node required")
+	}
+	script := filepath.Join(t.TempDir(), "fixture.mjs")
+	os.WriteFile(script, []byte(`import readline from 'node:readline';process.stdout.write(JSON.stringify({type:'runtime_ready'})+'\n');readline.createInterface({input:process.stdin}).on('line',line=>{const r=JSON.parse(line);if(r.type==='run'&&r.prompt==='next')process.stdout.write(JSON.stringify({type:'settled',runId:r.runId})+'\n')});`), 0600)
+	pi := NewPi(PiConfig{Key: "fake", BaseURL: "http://127.0.0.1:1", Script: script})
+	defer pi.Close()
+	waitPiReady(t, pi)
+	first, stop := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer stop()
+	if err := pi.Run(first, "first", "mock", "", "ignore", func(PiEvent) (any, error) { return nil, nil }); err == nil {
+		t.Fatal("expected cancellation")
+	}
+	waitPiReady(t, pi)
+	next, done := context.WithTimeout(context.Background(), 5*time.Second)
+	defer done()
+	if err := pi.Run(next, "next", "mock", "", "next", func(PiEvent) (any, error) { return nil, nil }); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func waitPiReady(t *testing.T, pi *Pi) {
+	t.Helper()
+	if err := pi.start(); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if pi.Status() == "ready" {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("Pi did not become ready", pi.Status())
+}
+
+func TestPiWarmupWithoutRequestAndSharedAcrossUsers(t *testing.T) {
+	if _, err := exec.LookPath("node"); err != nil {
+		t.Skip("node required")
+	}
+	script := filepath.Join(t.TempDir(), "fixture.mjs")
+	os.WriteFile(script, []byte(`import readline from 'node:readline';setTimeout(()=>process.stdout.write('{"type":"runtime_ready"}\n'),150);let count=0;readline.createInterface({input:process.stdin}).on('line',line=>{const r=JSON.parse(line);if(r.type==='run'){count++;process.stdout.write(JSON.stringify({type:'settled',runId:r.runId,calls:count})+'\n')}});`), 0600)
+	pi := NewPi(PiConfig{Key: "fake", BaseURL: "http://127.0.0.1:1", Script: script})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go pi.Warmup(ctx)
+	if pi.Status() != "warming" || pi.RequireReady() == nil {
+		t.Fatal("cold process accepted request")
+	}
+	waitPiReady(t, pi)
+	for i, user := range []string{"user-a", "user-b"} {
+		calls := 0
+		err := pi.Run(ctx, user, "mock", "", "question", func(e PiEvent) (any, error) { calls = e.Calls; return nil, nil })
+		if err != nil || calls != i+1 {
+			t.Fatalf("child not reused: calls=%d error=%v", calls, err)
+		}
+	}
+	pi.mu.Lock()
+	_ = pi.cmd.Process.Kill()
+	pi.mu.Unlock()
+	deadline := time.Now().Add(time.Second)
+	for pi.Status() == "ready" && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if pi.RequireReady() == nil {
+		t.Fatal("dead process still ready")
+	}
+	deadline = time.Now().Add(7 * time.Second)
+	for pi.Status() != "ready" && time.Now().Before(deadline) {
+		time.Sleep(20 * time.Millisecond)
+	}
+	if pi.Status() != "ready" {
+		t.Fatal("background warmup did not recover")
+	}
+	cancel()
+	deadline = time.Now().Add(time.Second)
+	for pi.Status() != "unavailable" && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if pi.Status() != "unavailable" {
+		t.Fatal("shutdown did not close runtime")
+	}
+}
diff --git a/server/internal/workbench/retrieval.go b/server/internal/workbench/retrieval.go
new file mode 100644
index 000000000..4dac2eefe
--- /dev/null
+++ b/server/internal/workbench/retrieval.go
@@ -0,0 +1,210 @@
+package workbench
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"github.com/jackc/pgx/v5"
+	"sort"
+	"strings"
+	"time"
+)
+
+type Reader interface {
+	Query(context.Context, string, ...any) (pgx.Rows, error)
+}
+
+// Only collaborative business records enter this corpus. Runtime configs,
+// credentials, private agent sessions and another user's inbox never do.
+const corpusSQL = `
+SELECT 'issue', i.id::text, COALESCE(i.project_id::text,''), i.id::text, i.title,
+ jsonb_build_object('description',i.description,'assigneeType',i.assignee_type,'assigneeId',i.assignee_id,'assigneeName',COALESCE(au.name,aa.name),'startDate',i.start_date,'dueDate',i.due_date,'acceptanceCriteria',i.acceptance_criteria,'metadata',i.metadata)::text,
+ i.status, i.updated_at::text, i.updated_at::text, ARRAY[COALESCE(i.project_id::text,''),COALESCE(i.parent_issue_id::text,'')]
+ FROM issue i
+ LEFT JOIN member am ON i.assignee_type='member' AND am.user_id=i.assignee_id AND am.workspace_id=i.workspace_id
+ LEFT JOIN "user" au ON au.id=am.user_id
+ LEFT JOIN agent aa ON i.assignee_type='agent' AND aa.id=i.assignee_id AND aa.workspace_id=i.workspace_id
+ WHERE i.workspace_id=$1 AND NOT (i.metadata ? 'project_topic_id')
+UNION ALL
+SELECT 'project',p.id::text,p.id::text,'',p.title,
+ jsonb_build_object('description',p.description,'leadType',p.lead_type,'leadId',p.lead_id,'leadName',COALESCE(lu.name,la.name),'startDate',p.start_date,'dueDate',p.due_date)::text,
+ p.status,p.updated_at::text,p.updated_at::text,ARRAY[]::text[]
+ FROM project p
+ LEFT JOIN member lm ON p.lead_type='member' AND lm.user_id=p.lead_id AND lm.workspace_id=p.workspace_id
+ LEFT JOIN "user" lu ON lu.id=lm.user_id
+ LEFT JOIN agent la ON p.lead_type='agent' AND la.id=p.lead_id AND la.workspace_id=p.workspace_id
+ WHERE p.workspace_id=$1
+UNION ALL
+SELECT 'comment',c.id::text,COALESCE(i.project_id::text,t.project_id::text,''),c.issue_id::text, i.title,
+ jsonb_build_object('content',c.content,'type',c.type,'authorType',c.author_type,'authorId',c.author_id,'authorName',COALESCE(cu.name,ca.name))::text,
+ c.type,c.updated_at::text,c.updated_at::text,ARRAY[c.issue_id::text,COALESCE(t.id::text,'')]
+ FROM comment c JOIN issue i ON i.id=c.issue_id AND i.workspace_id=$1 LEFT JOIN project_topic t ON t.discussion_issue_id=i.id AND t.workspace_id=$1
+ LEFT JOIN member cm ON c.author_type='member' AND cm.user_id=c.author_id AND cm.workspace_id=c.workspace_id
+ LEFT JOIN "user" cu ON cu.id=cm.user_id
+ LEFT JOIN agent ca ON c.author_type='agent' AND ca.id=c.author_id AND ca.workspace_id=c.workspace_id
+ WHERE c.workspace_id=$1 AND c.deleted_at IS NULL
+UNION ALL
+SELECT 'topic',id::text,project_id::text,COALESCE(discussion_issue_id::text,''),title,
+ jsonb_build_object('conclusion',conclusion,'conclusionRevision',conclusion_revision,'draft',conclusion_draft,'draftRevision',draft_revision)::text,
+ status,updated_at::text,updated_at::text,issue_ids::text[] || ARRAY[COALESCE(discussion_issue_id::text,'')]
+ FROM project_topic WHERE workspace_id=$1
+UNION ALL
+SELECT 'conclusion',t.id::text||':'||c.revision,t.project_id::text,COALESCE(t.discussion_issue_id::text,''),t.title,c.content,
+ CASE WHEN c.revision=t.conclusion_revision THEN 'current' ELSE 'superseded' END,c.revision::text,c.confirmed_at::text,ARRAY[t.id::text] || t.issue_ids::text[]
+ FROM project_topic_conclusion c JOIN project_topic t ON t.id=c.topic_id WHERE t.workspace_id=$1
+UNION ALL
+SELECT 'blueprint',d.project_id::text,d.project_id::text,'',p.title,d.graph::text,d.status,d.revision::text,d.updated_at::text,ARRAY[d.project_id::text]
+ FROM project_blueprint_draft d JOIN project p ON p.id=d.project_id AND p.workspace_id=$1 WHERE d.workspace_id=$1
+UNION ALL
+SELECT 'resource',r.id::text,r.project_id::text,'',COALESCE(r.label,''),r.resource_ref::text,r.resource_type,r.created_at::text,r.created_at::text,ARRAY[r.project_id::text]
+ FROM project_resource r JOIN project p ON p.id=r.project_id AND p.workspace_id=$1 WHERE r.workspace_id=$1
+UNION ALL
+SELECT 'dependency',d.id::text,COALESCE(i.project_id::text,''),i.id::text,i.title,
+ jsonb_build_object('relation',d.type,'issueTitle',i.title,'issueStatus',i.status,'dependsOnTitle',j.title,'dependsOnStatus',j.status,'issueId',i.id,'dependsOnIssueId',j.id)::text,
+ d.type,'1',GREATEST(i.updated_at,j.updated_at)::text,ARRAY[d.issue_id::text,d.depends_on_issue_id::text]
+ FROM issue_dependency d JOIN issue i ON i.id=d.issue_id JOIN issue j ON j.id=d.depends_on_issue_id WHERE i.workspace_id=$1 AND j.workspace_id=$1
+ORDER BY 1,2 LIMIT 10001`
+
+type Corpus struct {
+	Records     []Evidence
+	Fingerprint string
+	At          string
+}
+
+func Load(ctx context.Context, db Reader, workspace string, now time.Time) (Corpus, error) {
+	c := Corpus{Records: []Evidence{}, At: now.UTC().Format(time.RFC3339)}
+	rows, err := db.Query(ctx, corpusSQL, workspace)
+	if err != nil {
+		return c, err
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var e Evidence
+		if err = rows.Scan(&e.Kind, &e.ObjectID, &e.ProjectID, &e.IssueID, &e.Title, &e.Text, &e.Status, &e.Version, &e.UpdatedAt, &e.RelatedIDs); err != nil {
+			return c, err
+		}
+		e.ID = e.Kind + ":" + e.ObjectID
+		c.Records = append(c.Records, e)
+	}
+	if err = rows.Err(); err != nil {
+		return c, err
+	}
+	if len(c.Records) > 10000 {
+		return c, fmt.Errorf("工作区资料超过首版检索容量，未生成不完整答案")
+	}
+	carriers := map[string]string{}
+	for _, e := range c.Records {
+		if e.Kind == "topic" {
+			carriers[e.IssueID] = e.ObjectID
+		}
+	}
+	for i := range c.Records {
+		e := &c.Records[i]
+		if topic, ok := carriers[e.IssueID]; ok && e.IssueID != "" {
+			e.TopicID = topic
+			filtered := []string{}
+			for _, id := range e.RelatedIDs {
+				if id != e.IssueID {
+					filtered = append(filtered, id)
+				}
+			}
+			e.RelatedIDs = filtered
+			e.IssueID = ""
+		}
+	}
+	raw, _ := json.Marshal(c.Records)
+	sum := sha256.Sum256(raw)
+	c.Fingerprint = hex.EncodeToString(sum[:])
+	return c, nil
+}
+
+type Page struct {
+	Records    []Evidence `json:"records"`
+	Total      int        `json:"total"`
+	Offset     int        `json:"offset"`
+	NextOffset *int       `json:"nextOffset"`
+	Complete   bool       `json:"complete"`
+	AsOf       string     `json:"asOf"`
+	Note       string     `json:"note"`
+}
+
+func (c Corpus) Search(q Query) (Page, error) {
+	valid := map[string]bool{"issue": true, "project": true, "comment": true, "topic": true, "conclusion": true, "blueprint": true, "resource": true, "dependency": true}
+	p := Page{Records: []Evidence{}, Offset: q.Offset, AsOf: c.At, Note: "关键词匹配不是语义全集；评论不等于正式状态，自测不等于验收。resource只包含已存文本/指针，未下载外部正文。"}
+	if !valid[q.Source] || q.Offset < 0 || q.Limit < 0 || q.Limit > 80 {
+		return p, fmt.Errorf("invalid query")
+	}
+	limit := q.Limit
+	if limit == 0 {
+		limit = 40
+	}
+	matches := []Evidence{}
+	for _, e := range c.Records {
+		if e.Kind != q.Source || q.ProjectID != "" && e.ProjectID != q.ProjectID {
+			continue
+		}
+		if q.Status == "unfinished" {
+			if e.Status == "done" || e.Status == "cancelled" || e.Status == "completed" {
+				continue
+			}
+		} else if q.Status != "" && e.Status != q.Status {
+			continue
+		}
+		if q.RelatedID != "" && e.ObjectID != q.RelatedID && e.ProjectID != q.RelatedID && e.IssueID != q.RelatedID && !contains(e.RelatedIDs, q.RelatedID) {
+			continue
+		}
+		if q.Text != "" && !strings.Contains(strings.ToLower(e.Title+"\n"+e.Text), strings.ToLower(q.Text)) {
+			continue
+		}
+		matches = append(matches, e)
+	}
+	p.Total = len(matches)
+	end := min(q.Offset+limit, len(matches))
+	if q.Offset < len(matches) {
+		p.Records = matches[q.Offset:end]
+	}
+	p.Complete = end == len(matches)
+	if !p.Complete {
+		p.NextOffset = &end
+	}
+	return p, nil
+}
+func contains(a []string, s string) bool {
+	for _, v := range a {
+		if v == s {
+			return true
+		}
+	}
+	return false
+}
+func (c Corpus) Catalog() any {
+	counts := map[string]int{}
+	projects := []map[string]string{}
+	for _, e := range c.Records {
+		counts[e.Kind]++
+		if e.Kind == "project" {
+			projects = append(projects, map[string]string{"id": e.ObjectID, "title": e.Title, "status": e.Status})
+		}
+	}
+	return map[string]any{"counts": counts, "projects": projects, "asOf": c.At, "coverage": "topicId是话题，讨论载体不算业务任务；关联项目不等于已确认承接关系。当前工作区共享业务记录；不含私聊、其他用户收件箱、未存储外部材料"}
+}
+func SortedEvidence(m map[string]Evidence) []Evidence {
+	a := make([]Evidence, 0, len(m))
+	for _, e := range m {
+		a = append(a, e)
+	}
+	sort.Slice(a, func(i, j int) bool { return a[i].ID < a[j].ID })
+	return a
+}
+
+// Ordinary views invalidate only on business changes. Relative-time views also
+// invalidate every five minutes while open, without rewriting history.
+func (c Corpus) ViewFingerprint(v View) string {
+	if !v.TimeSensitive {
+		return c.Fingerprint
+	}
+	at, _ := time.Parse(time.RFC3339, c.At)
+	return c.Fingerprint + ":" + at.UTC().Truncate(5*time.Minute).Format(time.RFC3339)
+}
