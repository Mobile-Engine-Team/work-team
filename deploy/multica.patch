+// Hydrate only display names for actors already in an authorised timeline.
+// This does not expose agent configuration or grant directory/invocation access.
+func (h *Handler) hydrateTimelineAgentActors(ctx context.Context, workspace pgtype.UUID, entries []TimelineEntry) {
+	ids := []pgtype.UUID{}
+	for _, entry := range entries {
+		if entry.ActorType == "agent" {
+			if id, err := util.ParseUUID(entry.ActorID); err == nil {
+				ids = append(ids, id)
+			}
+		}
+	}
+	if len(ids) == 0 {
+		return
+	}
+	rows, err := h.DB.Query(ctx, `SELECT id::text,name FROM agent WHERE workspace_id=$1 AND id=ANY($2::uuid[])`, workspace, ids)
+	if err != nil {
+		return
+	}
+	defer rows.Close()
+	names := map[string]string{}
+	for rows.Next() {
+		var id, name string
+		if rows.Scan(&id, &name) != nil {
+			return
+		}
+		names[id] = name
+	}
+	if rows.Err() != nil {
+		return
+	}
+	for i := range entries {
+		if entries[i].ActorType == "agent" {
+			entries[i].ActorName = names[entries[i].ActorID]
+		}
+	}
+}
