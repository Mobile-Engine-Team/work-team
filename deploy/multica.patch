+func ProjectPlanInput(raw []byte) json.RawMessage {
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(raw, &fields) != nil {
+		return nil
+	}
+	return fields["project_plan"]
+}
+
+// EnqueueProjectTaskInTransaction reuses ordinary agent/squad routing while
+// keeping broadcasts and runtime wakeups outside the caller-owned transaction.
+func (s *TaskService) EnqueueProjectTaskInTransaction(ctx context.Context, tx pgx.Tx, issue db.Issue, actor pgtype.UUID) (db.AgentTaskQueue, error) {
+	scoped := &TaskService{Queries: s.Queries.WithTx(tx), TxStarter: s.TxStarter, Entitlements: s.Entitlements, Composio: s.Composio, FeatureFlags: s.FeatureFlags, deferProjectEffects: true}
+	if issue.AssigneeType.String == "squad" {
+		sq, err := scoped.Queries.GetSquadInWorkspace(ctx, db.GetSquadInWorkspaceParams{ID: issue.AssigneeID, WorkspaceID: issue.WorkspaceID})
+		if err != nil {
+			return db.AgentTaskQueue{}, err
+		}
+		return scoped.EnqueueTaskForSquadLeaderByActor(ctx, issue, sq.LeaderID, sq.ID, actor)
+	}
+	return scoped.EnqueueTaskForIssueByActor(ctx, issue, actor)
+}
+func (s *TaskService) ProjectTaskCommitted(ctx context.Context, task db.AgentTaskQueue) {
+	s.broadcastTaskEvent(ctx, protocol.EventTaskQueued, task)
+	s.NotifyTaskEnqueued(ctx, task)
+}
