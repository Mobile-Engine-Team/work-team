+func TestBlueprintPlanningCancellationAndInvalidResults(t *testing.T) {
+	for _, mode := range []string{"cancelled", "expired", "invalid", "auth-failure"} {
+		t.Run(mode, func(t *testing.T) {
+			p, d := blueprintFixture(t)
+			agent := dbfx.Agent(t, "规划边界替身", testRuntimeID)
+			token := "mpp_test_cancel"
+			hash := sha256.Sum256([]byte(token))
+			input, _ := json.Marshal(planningInput{Graph: d.Graph})
+			id := dbfx.Insert(t, "project_planning_request", testutil.Cols{"id": p, "project_id": p, "workspace_id": testWorkspaceID, "agent_id": agent, "runtime_id": testRuntimeID, "request_id": mode, "base_revision": d.Revision, "input": input, "input_hash": "test", "created_by": testUserID, "status": "running", "run_id": testRuntimeID, "result_token_hash": hex.EncodeToString(hash[:])})
+			testPool.Exec(context.Background(), "UPDATE project_planning_request SET lease_expires_at=now()+interval '5 minutes' WHERE id=$1", id)
+			want := 200
+			switch mode {
+			case "cancelled":
+				req := withURLParams(newRequest("POST", "/", nil), "id", p, "requestId", id)
+				testutil.Call(t, testHandler.CancelProjectPlanning, req).Want(200)
+				want = 409
+			case "expired":
+				testPool.Exec(context.Background(), "UPDATE project_planning_request SET lease_expires_at=now()-interval '1 second' WHERE id=$1", id)
+				want = 409
+			}
+			body := map[string]string{"run_id": testRuntimeID, "output": "not valid JSON"}
+			if mode == "auth-failure" {
+				body["error"] = "Authentication failed (test substitute)"
+			}
+			req := withURLParam(newRequest("POST", "/", body), "requestId", id)
+			req.Header.Set("Authorization", "Bearer "+token)
+			testutil.Call(t, testHandler.ProjectPlanningResult, req).Want(want)
+			var status string
+			var result []byte
+			testPool.QueryRow(context.Background(), "SELECT status,result FROM project_planning_request WHERE id=$1", id).Scan(&status, &result)
+			if mode == "cancelled" && status != "cancelled" {
+				t.Fatal("late result overwrote cancellation")
+			}
+			if want == 200 && status != "failed" {
+				t.Fatal("failure became success")
+			}
+			if len(result) > 0 {
+				t.Fatal("failed result retained a usable suggestion")
+			}
+			planRequest(t, testHandler.ApplyProjectSuggestion, p, "POST", map[string]any{"request_id": id, "selected": []string{"c1"}, "expected_revision": d.Revision}, 409, nil)
+		})
+	}
