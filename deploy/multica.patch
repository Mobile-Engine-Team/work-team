@@ -0,0 +1,16 @@
+export const MAX_MODEL_REQUESTS = 5;
+export const MAX_RETRIEVAL_REQUESTS = 3;
+
+// Reserve one generation turn and one targeted repair within the same total
+// budget. The model can batch independent queries in each retrieval turn.
+export function queryPayload(payload, callNumber, allowTools = true) {
+  const toolsAllowed = allowTools && callNumber <= MAX_RETRIEVAL_REQUESTS;
+  const { tools, ...withoutTools } = payload;
+  return {
+    ...(toolsAllowed ? payload : withoutTools),
+    thinking: { type: 'disabled' },
+    ...(!toolsAllowed
+      ? { tool_choice: 'none' }
+      : { tool_choice: 'auto' }),
+  };
+}
diff --git a/server/workbench-pi/request-policy.test.mjs b/server/workbench-pi/request-policy.test.mjs
new file mode 100644
index 000000000..533133ccf
--- /dev/null
+++ b/server/workbench-pi/request-policy.test.mjs
@@ -0,0 +1,23 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { queryPayload } from './request-policy.mjs';
+test('tool selection is autonomous, even when a provider payload forces a tool', () => {
+  const payload = { tools: [{type:'function',function:{name:'query_business'}}], tool_choice:'required' };
+  assert.equal(queryPayload(payload, 1).tool_choice, 'auto');
+  assert.equal(queryPayload(payload, 2).tool_choice, 'auto');
+  assert.equal(payload.tool_choice, 'required');
+});
+test('repair after a published plan cannot issue additional tool queries', () => {
+  assert.equal(queryPayload({tools:[]}, 3, false).tool_choice, 'none');
+});
+test('retrieval cannot consume generation and repair slots', () => {
+  assert.equal(queryPayload({tools:[]}, 3).tool_choice, 'auto');
+  assert.equal(queryPayload({tools:[]}, 4).tool_choice, 'none');
+  assert.equal(queryPayload({tools:[]}, 5).tool_choice, 'none');
+});
+test('generation omits tools without mutating the source request', () => {
+  const payload = { tools:[{type:'function'}], messages:[{role:'user',content:'question'}] };
+  assert.equal(queryPayload(payload, 4).tools, undefined);
+  assert.deepEqual(queryPayload(payload, 4).messages, payload.messages);
+  assert.equal(payload.tools.length, 1);
+});
