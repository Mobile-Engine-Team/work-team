+++ b/server/internal/handler/workbench.go
@@ -0,0 +1,738 @@
+package handler
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"github.com/multica-ai/multica/server/internal/workbench"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+)
+
+type benchMessage struct {
+	ID             string            `json:"id"`
+	ConversationID string            `json:"conversationId"`
+	Prompt         string            `json:"prompt"`
+	Status         string            `json:"status"`
+	Progress       string            `json:"progress"`
+	Error          string            `json:"error"`
+	Result         *workbench.Result `json:"result"`
+	CreatedAt      time.Time         `json:"createdAt"`
+}
+type benchPin struct {
+	RefreshKey string            `json:"refreshKey"`
+	ID         string            `json:"id"`
+	Name       string            `json:"name"`
+	Intent     string            `json:"intent"`
+	Revision   int               `json:"revision"`
+	Status     string            `json:"status"`
+	Error      string            `json:"error"`
+	UpdatedAt  time.Time         `json:"updatedAt"`
+	Result     *workbench.Result `json:"result"`
+}
+
+func (h *Handler) benchAccess(w http.ResponseWriter, r *http.Request) (db.Member, bool) {
+	ws := h.resolveWorkspaceID(r)
+	m, ok := h.requireWorkspaceMember(w, r, ws, "workspace not found")
+	if !ok {
+		return m, false
+	}
+	actor, _ := h.resolveActor(r, requestUserID(r), ws)
+	if actor != "member" || m.Role == "guest" {
+		writeError(w, 403, "工作台仅对工作区成员开放")
+		return m, false
+	}
+	return m, true
+}
+func benchJSON(v any) []byte { raw, _ := json.Marshal(v); return raw }
+func benchDecodeResult(raw []byte) *workbench.Result {
+	if len(raw) == 0 {
+		return nil
+	}
+	var r workbench.Result
+	if json.Unmarshal(raw, &r) != nil {
+		return nil
+	}
+	return &r
+}
+func benchVisible(result *workbench.Result, c workbench.Corpus) bool {
+	if result == nil {
+		return true
+	}
+	ids := map[string]bool{}
+	for _, e := range c.Records {
+		ids[e.ID] = true
+	}
+	for _, e := range result.Evidence {
+		if !ids[e.ID] {
+			return false
+		}
+	}
+	return true
+}
+func (h *Handler) benchMessage(ctx context.Context, m db.Member, id string) (benchMessage, error) {
+	var msg benchMessage
+	var raw []byte
+	err := h.DB.QueryRow(ctx, `SELECT id,conversation_id,prompt,status,progress,error,result,created_at FROM workbench_message WHERE id=$1 AND workspace_id=$2 AND owner_id=$3`, id, m.WorkspaceID, m.UserID).Scan(&msg.ID, &msg.ConversationID, &msg.Prompt, &msg.Status, &msg.Progress, &msg.Error, &raw, &msg.CreatedAt)
+	msg.Result = benchDecodeResult(raw)
+	return msg, err
+}
+func (h *Handler) WorkbenchState(w http.ResponseWriter, r *http.Request) {
+	m, ok := h.benchAccess(w, r)
+	if !ok {
+		return
+	}
+	corpus, err := workbench.Load(r.Context(), h.DB, uuidToString(m.WorkspaceID), time.Now())
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	rows, err := h.DB.Query(r.Context(), `SELECT id,title,created_at FROM workbench_conversation WHERE workspace_id=$1 AND owner_id=$2 ORDER BY created_at DESC`, m.WorkspaceID, m.UserID)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	conversations := []any{}
+	for rows.Next() {
+		var id, title string
+		var at time.Time
+		if err = rows.Scan(&id, &title, &at); err != nil {
+			break
+		}
+		conversations = append(conversations, map[string]any{"id": id, "title": title, "createdAt": at})
+	}
+	if err == nil {
+		err = rows.Err()
+	}
+	rows.Close()
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	rows, err = h.DB.Query(r.Context(), `SELECT id,name,intent,revision,status,error,updated_at,result FROM saved_view WHERE workspace_id=$1 AND owner_id=$2 ORDER BY updated_at DESC`, m.WorkspaceID, m.UserID)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	pins := []benchPin{}
+	for rows.Next() {
+		var p benchPin
+		var raw []byte
+		if err = rows.Scan(&p.ID, &p.Name, &p.Intent, &p.Revision, &p.Status, &p.Error, &p.UpdatedAt, &raw); err != nil {
+			break
+		}
+		p.Result = benchDecodeResult(raw)
+		if p.Result != nil {
+			p.RefreshKey = corpus.ViewFingerprint(p.Result.View)
+		} else {
+			p.RefreshKey = corpus.Fingerprint
+		}
+		if !benchVisible(p.Result, corpus) {
+			p.Result = nil
+			p.Status = "unavailable"
+			p.Error = "部分依据已不可访问，请重新生成"
+		}
+		pins = append(pins, p)
+	}
+	if err == nil {
+		err = rows.Err()
+	}
+	rows.Close()
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	messages := []benchMessage{}
+	conv := r.URL.Query().Get("conversation")
+	if conv != "" {
+		if _, ok := parseUUIDOrBadRequest(w, conv, "conversation"); !ok {
+			return
+		}
+		rows, err = h.DB.Query(r.Context(), `SELECT id FROM workbench_message WHERE conversation_id=$1 AND workspace_id=$2 AND owner_id=$3 ORDER BY created_at,id`, conv, m.WorkspaceID, m.UserID)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		ids := []string{}
+		for rows.Next() {
+			var id string
+			if err = rows.Scan(&id); err != nil {
+				break
+			}
+			ids = append(ids, id)
+		}
+		if err == nil {
+			err = rows.Err()
+		}
+		rows.Close()
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		for _, id := range ids {
+			msg, e := h.benchMessage(r.Context(), m, id)
+			if e != nil {
+				planWriteError(w, e)
+				return
+			}
+			if !benchVisible(msg.Result, corpus) {
+				msg.Result = nil
+				msg.Status = "unavailable"
+				msg.Error = "部分依据已不可访问"
+			}
+			messages = append(messages, msg)
+		}
+	}
+	runtimeStatus := h.WorkbenchPi.Status()
+	writeJSON(w, 200, map[string]any{"conversations": conversations, "messages": messages, "pins": pins, "catalog": corpus.Catalog(), "modelReady": runtimeStatus == "ready", "runtimeStatus": runtimeStatus, "models": benchModels(h.WorkbenchPi), "fingerprint": corpus.Fingerprint})
+}
+func (h *Handler) WorkbenchConversation(w http.ResponseWriter, r *http.Request) {
+	m, ok := h.benchAccess(w, r)
+	if !ok {
+		return
+	}
+	var req struct {
+		Title string `json:"title"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	title := strings.TrimSpace(req.Title)
+	if title == "" {
+		title = "新对话"
+	}
+	if len([]rune(title)) > 120 {
+		title = string([]rune(title)[:120])
+	}
+	var id string
+	err := h.DB.QueryRow(r.Context(), `INSERT INTO workbench_conversation(workspace_id,owner_id,title) VALUES($1,$2,$3) RETURNING id`, m.WorkspaceID, m.UserID, title).Scan(&id)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	writeJSON(w, 201, map[string]string{"id": id})
+}
+func (h *Handler) WorkbenchSend(w http.ResponseWriter, r *http.Request) {
+	m, ok := h.benchAccess(w, r)
+	if !ok {
+		return
+	}
+	var req struct {
+		RequestID      string                    `json:"requestId"`
+		ConversationID string                    `json:"conversationId"`
+		Prompt         string                    `json:"prompt"`
+		ModelID        string                    `json:"modelId"`
+		SourcePinID    string                    `json:"sourcePinId"`
+		LayoutState    map[string]map[string]any `json:"layoutState,omitempty"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	id, ok := parseUUIDOrBadRequest(w, req.RequestID, "requestId")
+	if !ok {
+		return
+	}
+	conv, ok := parseUUIDOrBadRequest(w, req.ConversationID, "conversationId")
+	if !ok {
+		return
+	}
+	req.Prompt = strings.TrimSpace(req.Prompt)
+	if req.Prompt == "" || len([]rune(req.Prompt)) > 8000 {
+		writeError(w, 400, "问题为空或过长")
+		return
+	}
+	if old, err := h.benchMessage(r.Context(), m, req.RequestID); err == nil {
+		if old.ConversationID != req.ConversationID || old.Prompt != req.Prompt || (req.ModelID != "" && old.Result != nil && old.Result.RequestedModel != "" && old.Result.RequestedModel != req.ModelID) {
+			writeError(w, 409, "同一请求不能更改内容")
+			return
+		}
+		writeJSON(w, 200, old)
+		return
+	}
+	if !h.WorkbenchPi.Enabled() {
+		writeError(w, 503, "工作台模型尚未配置")
+		return
+	}
+	model, err := h.WorkbenchPi.Select(req.ModelID)
+	if err != nil {
+		writeError(w, 400, err.Error())
+		return
+	}
+	if err := h.WorkbenchPi.RequireReady(); err != nil {
+		w.Header().Set("Retry-After", "5")
+		writeError(w, 503, err.Error())
+		return
+	}
+	var base *workbench.Result
+	if req.SourcePinID != "" {
+		if _, valid := parseUUIDOrBadRequest(w, req.SourcePinID, "sourcePinId"); !valid {
+			return
+		}
+		var raw []byte
+		e := h.DB.QueryRow(r.Context(), `SELECT result FROM saved_view WHERE id=$1 AND workspace_id=$2 AND owner_id=$3`, req.SourcePinID, m.WorkspaceID, m.UserID).Scan(&raw)
+		corpus, loadErr := workbench.Load(r.Context(), h.DB, uuidToString(m.WorkspaceID), time.Now())
+		base = benchDecodeResult(raw)
+		if e != nil || loadErr != nil || base == nil || !benchVisible(base, corpus) {
+			writeError(w, 403, "原视图不可访问")
+			return
+		}
+	}
+	if len(req.LayoutState) > 0 {
+		if base == nil {
+			var raw []byte
+			e := h.DB.QueryRow(r.Context(), `SELECT result FROM workbench_message WHERE conversation_id=$1 AND workspace_id=$2 AND owner_id=$3 AND status='completed' ORDER BY created_at DESC LIMIT 1`, conv, m.WorkspaceID, m.UserID).Scan(&raw)
+			base = benchDecodeResult(raw)
+			corpus, loadErr := workbench.Load(r.Context(), h.DB, uuidToString(m.WorkspaceID), time.Now())
+			if e != nil || loadErr != nil || base == nil || !benchVisible(base, corpus) {
+				writeError(w, 403, "原回答不可访问")
+				return
+			}
+		}
+		if e := workbench.ApplyLayoutState(base, req.LayoutState); e != nil {
+			writeError(w, 400, "视图显示状态已失效，请重新打开回答")
+			return
+		}
+	}
+	initial := workbench.Result{RequestedModel: model, Model: model, View: workbench.View{SchemaVersion: 2, Blocks: []workbench.Block{}, Queries: []workbench.Query{}, Limitations: []string{}}, Evidence: []workbench.Evidence{}, GeneratedAt: time.Now().UTC().Format(time.RFC3339), Dynamic: workbench.NewDynamic()}
+	tag, err := h.DB.Exec(r.Context(), `INSERT INTO workbench_message(id,conversation_id,workspace_id,owner_id,prompt,result) SELECT $1,id,workspace_id,owner_id,$5,$6 FROM workbench_conversation WHERE id=$2 AND workspace_id=$3 AND owner_id=$4 ON CONFLICT(id) DO NOTHING`, id, conv, m.WorkspaceID, m.UserID, req.Prompt, benchJSON(initial))
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if tag.RowsAffected() == 0 {
+		writeError(w, 409, "对话不可访问或请求已接收，请读取原请求")
+		return
+	}
+	go h.runWorkbench(m, req.RequestID, req.Prompt, req.ConversationID, "", model, base)
+	msg, _ := h.benchMessage(r.Context(), m, req.RequestID)
+	writeJSON(w, 202, msg)
+}
+func (h *Handler) runWorkbench(m db.Member, id, prompt, conversation, pinID, model string, bases ...*workbench.Result) {
+	ctx, cancel := context.WithTimeout(context.Background(), 180*time.Second)
+	defer cancel()
+	h.benchRuns.Store(id, cancel)
+	defer h.benchRuns.Delete(id)
+	// Revocation must stop even a provider that is currently silent.
+	go func() {
+		ticker := time.NewTicker(time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				member, e := h.getWorkspaceMember(ctx, uuidToString(m.UserID), uuidToString(m.WorkspaceID))
+				if e != nil || member.Role == "guest" {
+					cancel()
+					return
+				}
+				if pinID == "" {
+					msg, e := h.benchMessage(ctx, m, id)
+					if e != nil || msg.Status != "running" {
+						cancel()
+						return
+					}
+					latest, e := workbench.Load(ctx, h.DB, uuidToString(m.WorkspaceID), time.Now())
+					if e == nil && !benchVisible(msg.Result, latest) {
+						cancel()
+						return
+					}
+				}
+			}
+		}
+	}()
+	progress := func(s string) {
+		if pinID == "" {
+			_, _ = h.DB.Exec(ctx, `UPDATE workbench_message SET progress=$2,updated_at=now() WHERE id=$1 AND status='running'`, id, s)
+		}
+	}
+	check := func() error {
+		current, err := h.getWorkspaceMember(ctx, uuidToString(m.UserID), uuidToString(m.WorkspaceID))
+		if err != nil || current.Role == "guest" {
+			return fmt.Errorf("工作区访问权限已失效")
+		}
+		if pinID == "" {
+			var status string
+			if e := h.DB.QueryRow(ctx, `SELECT status FROM workbench_message WHERE id=$1`, id).Scan(&status); e != nil {
+				return e
+			}
+			if status != "running" {
+				return context.Canceled
+			}
+		}
+		return nil
+	}
+	corpus, err := workbench.Load(ctx, h.DB, uuidToString(m.WorkspaceID), time.Now())
+	history := ""
+	var base *workbench.Result
+	if len(bases) > 0 && bases[0] != nil && benchVisible(bases[0], corpus) {
+		base = bases[0]
+		history = base.View.Intent
+	}
+	if conversation != "" {
+		rows, err := h.DB.Query(ctx, `SELECT prompt,result FROM workbench_message WHERE conversation_id=$1 AND workspace_id=$2 AND owner_id=$3 AND status='completed' ORDER BY created_at DESC LIMIT 4`, conversation, m.WorkspaceID, m.UserID)
+		if err == nil {
+			for rows.Next() {
+				var q string
+				var raw []byte
+				if rows.Scan(&q, &raw) == nil {
+					previous := benchDecodeResult(raw)
+					if previous == nil || !benchVisible(previous, corpus) {
+						continue
+					}
+					if base == nil {
+						base = previous
+					}
+					summary := map[string]any{"intent": previous.View.Intent}
+					if previous.Dynamic != nil {
+						summary["plan"] = previous.Dynamic.Plan
+						summary["claims"] = previous.Dynamic.Claims
+						layout := []map[string]any{}
+						for _, section := range previous.Dynamic.Sections {
+							layout = append(layout, map[string]any{"id": section.ID, "surface": section.Surface, "sdk": section.SDK})
+						}
+						summary["sections"] = layout
+					}
+					history = q + "\n" + string(benchJSON(summary)) + "\n" + history
+				}
+			}
+			rows.Close()
+		}
+	}
+	var result workbench.Result
+	if err == nil {
+		result, err = workbench.GenerateDynamic(ctx, h.WorkbenchPi, corpus, id, model, uuidToString(m.UserID), prompt, history, progress, check, func(partial workbench.Result) error {
+			latest, e := workbench.Load(ctx, h.DB, uuidToString(m.WorkspaceID), time.Now())
+			if e != nil {
+				return e
+			}
+			if !benchVisible(&partial, latest) {
+				return fmt.Errorf("部分依据已不可访问")
+			}
+			if pinID != "" {
+				return nil
+			}
+			_, e = h.DB.Exec(ctx, `UPDATE workbench_message SET result=$2,updated_at=now() WHERE id=$1 AND status='running'`, id, benchJSON(partial))
+			return e
+		}, base)
+	}
+	if err == nil {
+		err = check()
+	}
+	if err == nil {
+		var latest workbench.Corpus
+		latest, err = workbench.Load(ctx, h.DB, uuidToString(m.WorkspaceID), time.Now())
+		if err == nil && latest.Fingerprint != corpus.Fingerprint {
+			result.Stale = true
+		}
+	}
+	status, failure := "completed", ""
+	var raw []byte
+	if err != nil {
+		status = "failed"
+		failure = err.Error()
+		if errors.Is(err, context.Canceled) {
+			status = "cancelled"
+		}
+		if result.Dynamic != nil {
+			raw = benchJSON(result)
+		}
+	} else {
+		raw = benchJSON(result)
+	}
+	saveCtx, done := context.WithTimeout(context.Background(), 5*time.Second)
+	defer done()
+	if pinID == "" {
+		_, _ = h.DB.Exec(saveCtx, `UPDATE workbench_message SET status=$2,result=COALESCE($3,result),error=$4,progress='',updated_at=now() WHERE id=$1 AND status='running'`, id, status, raw, failure)
+	} else {
+		if err == nil {
+			_, _ = h.DB.Exec(saveCtx, `UPDATE saved_view SET result=$2,fingerprint=$3,status='ready',error='',refresh_id=NULL,updated_at=now() WHERE id=$1 AND refresh_id=$4`, pinID, raw, result.Fingerprint, id)
+		} else {
+			_, _ = h.DB.Exec(saveCtx, `UPDATE saved_view SET status='failed',error=$2,refresh_id=NULL WHERE id=$1 AND refresh_id=$3`, pinID, failure, id)
+		}
+	}
+}
+func (h *Handler) WorkbenchMessage(w http.ResponseWriter, r *http.Request) {
+	m, ok := h.benchAccess(w, r)
+	if !ok {
+		return
+	}
+	id := chi.URLParam(r, "id")
+	if _, ok := parseUUIDOrBadRequest(w, id, "id"); !ok {
+		return
+	}
+	msg, err := h.benchMessage(r.Context(), m, id)
+	if err != nil {
+		writeError(w, 404, "回答不存在")
+		return
+	}
+	corpus, err := workbench.Load(r.Context(), h.DB, uuidToString(m.WorkspaceID), time.Now())
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if !benchVisible(msg.Result, corpus) {
+		writeError(w, 403, "部分依据已不可访问")
+		return
+	}
+	writeJSON(w, 200, msg)
+}
+func (h *Handler) WorkbenchEvents(w http.ResponseWriter, r *http.Request) {
+	m, ok := h.benchAccess(w, r)
+	if !ok {
+		return
+	}
+	id := chi.URLParam(r, "id")
+	if _, ok := parseUUIDOrBadRequest(w, id, "id"); !ok {
+		return
+	}
+	if _, err := h.benchMessage(r.Context(), m, id); err != nil {
+		writeError(w, 404, "回答不存在")
+		return
+	}
+	w.Header().Set("Content-Type", "text/event-stream")
+	w.Header().Set("Cache-Control", "no-store")
+	flusher, ok := w.(http.Flusher)
+	if !ok {
+		return
+	}
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		if current, err := h.getWorkspaceMember(r.Context(), uuidToString(m.UserID), uuidToString(m.WorkspaceID)); err != nil || current.Role == "guest" {
+			fmt.Fprint(w, "event: revoked\ndata: {}\n\n")
+			flusher.Flush()
+			return
+		}
+		msg, err := h.benchMessage(r.Context(), m, id)
+		if err != nil {
+			return
+		}
+		corpus, err := workbench.Load(r.Context(), h.DB, uuidToString(m.WorkspaceID), time.Now())
+		if err != nil || !benchVisible(msg.Result, corpus) {
+			fmt.Fprint(w, "event: revoked\ndata: {}\n\n")
+			flusher.Flush()
+			return
+		}
+		// Each event is an authorized cumulative snapshot; reconnect cannot miss a region.
+		seq := 0
+		if msg.Result != nil && msg.Result.Dynamic != nil {
+			seq = msg.Result.Dynamic.Seq
+		}
+		fmt.Fprintf(w, "id: %d\nevent: snapshot\ndata: %s\n\n", seq, benchJSON(msg))
+		flusher.Flush()
+		if msg.Status != "running" {
+			return
+		}
+		select {
+		case <-r.Context().Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
+func (h *Handler) WorkbenchPin(w http.ResponseWriter, r *http.Request) {
+	m, ok := h.benchAccess(w, r)
+	if !ok {
+		return
+	}
+	id := chi.URLParam(r, "id")
+	if r.Method == "DELETE" {
+		if _, ok := parseUUIDOrBadRequest(w, id, "id"); !ok {
+			return
+		}
+		tag, err := h.DB.Exec(r.Context(), `DELETE FROM saved_view WHERE id=$1 AND workspace_id=$2 AND owner_id=$3`, id, m.WorkspaceID, m.UserID)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		if tag.RowsAffected() == 0 {
+			writeError(w, 404, "视图不存在")
+			return
+		}
+		writeJSON(w, 200, map[string]bool{"ok": true})
+		return
+	}
+	var req struct {
+		MessageID string `json:"messageId"`
+		Name      string `json:"name"`
+		Revision  int    `json:"revision"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	if _, ok := parseUUIDOrBadRequest(w, req.MessageID, "messageId"); !ok {
+		return
+	}
+	msg, err := h.benchMessage(r.Context(), m, req.MessageID)
+	if err != nil || msg.Status != "completed" || msg.Result == nil || (msg.Result.Dynamic != nil && !msg.Result.Dynamic.Complete) {
+		writeError(w, 404, "可固定的回答不存在")
+		return
+	}
+	c, err := workbench.Load(r.Context(), h.DB, uuidToString(m.WorkspaceID), time.Now())
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if !benchVisible(msg.Result, c) {
+		writeError(w, 403, "部分依据已不可访问")
+		return
+	}
+	name := strings.TrimSpace(req.Name)
+	if name == "" {
+		name = msg.Result.View.Title
+	}
+	if len([]rune(name)) > 300 {
+		writeError(w, 400, "名称过长")
+		return
+	}
+	if r.Method == "PUT" {
+		if _, ok := parseUUIDOrBadRequest(w, id, "id"); !ok {
+			return
+		}
+		tag, err := h.DB.Exec(r.Context(), `UPDATE saved_view SET name=$4,intent=$5,definition=$6,result=$7,fingerprint=$8,revision=revision+1,status='ready',error='',refresh_id=NULL,updated_at=now() WHERE id=$1 AND workspace_id=$2 AND owner_id=$3 AND revision=$9`, id, m.WorkspaceID, m.UserID, name, msg.Result.View.Intent, benchJSON(msg.Result.View), benchJSON(msg.Result), msg.Result.Fingerprint, req.Revision)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		if tag.RowsAffected() == 0 {
+			writeError(w, 409, "视图已变化或不可访问，请重新读取")
+			return
+		}
+		writeJSON(w, 200, map[string]string{"id": id})
+		return
+	}
+	err = h.DB.QueryRow(r.Context(), `INSERT INTO saved_view(workspace_id,owner_id,name,intent,definition,result,fingerprint) VALUES($1,$2,$3,$4,$5,$6,$7) RETURNING id`, m.WorkspaceID, m.UserID, name, msg.Result.View.Intent, benchJSON(msg.Result.View), benchJSON(msg.Result), msg.Result.Fingerprint).Scan(&id)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	writeJSON(w, 201, map[string]string{"id": id})
+}
+func (h *Handler) WorkbenchRefresh(w http.ResponseWriter, r *http.Request) {
+	m, ok := h.benchAccess(w, r)
+	if !ok {
+		return
+	}
+	id := chi.URLParam(r, "id")
+	if _, ok := parseUUIDOrBadRequest(w, id, "id"); !ok {
+		return
+	}
+	var intent, fingerprint, status string
+	var def, previousRaw []byte
+	err := h.DB.QueryRow(r.Context(), `SELECT intent,fingerprint,status,definition,result FROM saved_view WHERE id=$1 AND workspace_id=$2 AND owner_id=$3`, id, m.WorkspaceID, m.UserID).Scan(&intent, &fingerprint, &status, &def, &previousRaw)
+	if errors.Is(err, pgx.ErrNoRows) {
+		writeError(w, 404, "视图不存在")
+		return
+	}
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	c, err := workbench.Load(r.Context(), h.DB, uuidToString(m.WorkspaceID), time.Now())
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	var view workbench.View
+	if err := json.Unmarshal(def, &view); err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if fingerprint == c.ViewFingerprint(view) || status == "refreshing" {
+		writeJSON(w, 200, map[string]string{"status": status})
+		return
+	}
+	if !h.WorkbenchPi.Enabled() {
+		writeError(w, 503, "工作台模型尚未配置")
+		return
+	}
+	previous := benchDecodeResult(previousRaw)
+	if !benchVisible(previous, c) {
+		writeError(w, 403, "部分依据已不可访问")
+		return
+	}
+	modelID := ""
+	if previous != nil {
+		modelID = previous.RequestedModel
+	}
+	model, err := h.WorkbenchPi.Select(modelID)
+	if err != nil {
+		writeError(w, 400, err.Error())
+		return
+	}
+	if err := h.WorkbenchPi.RequireReady(); err != nil {
+		w.Header().Set("Retry-After", "5")
+		writeError(w, 503, err.Error())
+		return
+	}
+	run := uuid.NewString()
+	tag, err := h.DB.Exec(r.Context(), `UPDATE saved_view SET status='refreshing',error='',refresh_id=$4 WHERE id=$1 AND workspace_id=$2 AND owner_id=$3 AND status<>'refreshing'`, id, m.WorkspaceID, m.UserID, run)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if tag.RowsAffected() > 0 {
+		layout := []map[string]any{}
+		for _, b := range view.Blocks {
+			layout = append(layout, map[string]any{"type": b.Type, "title": b.Title, "columns": b.Columns})
+		}
+		plan := map[string]any{"queries": view.Queries, "layout": layout}
+		if previous != nil && previous.Dynamic != nil {
+			plan["plan"] = previous.Dynamic.Plan
+			examples := []map[string]any{}
+			for _, section := range previous.Dynamic.Sections {
+				examples = append(examples, map[string]any{"id": section.ID, "surface": section.Surface, "sdk": section.SDK})
+			}
+			plan["layoutExamples"] = examples
+		}
+		go h.runWorkbench(m, run, intent+"\n重新检索当前候选并更新全部分析。保留布局意图，不沿用旧成员资格或旧结论。以下layoutExamples只是排版参考，不是可直接回传的协议事件；每个section使用当前dataRefs/facts和内嵌分析组件重新生成，不可复用旧绑定路径或内部claim ID："+string(benchJSON(plan)), "", id, model)
+	}
+	writeJSON(w, 202, map[string]string{"status": "refreshing"})
+}
+
+// Called once at API startup; a previous process cannot still own these runs.
+func (h *Handler) RecoverWorkbench(ctx context.Context) error {
+	_, err := h.DB.Exec(ctx, `UPDATE workbench_message SET status='interrupted',error='服务已重启，请明确重试',progress='' WHERE status='running'; UPDATE saved_view SET status='failed',error='刷新已中断，请重新刷新',refresh_id=NULL WHERE status='refreshing'`)
+	return err
+}
+
+func benchModels(p *workbench.Pi) []workbench.ModelOption {
+	if p == nil {
+		return []workbench.ModelOption{}
+	}
+	return p.Models()
+}
+func (h *Handler) WorkbenchCancel(w http.ResponseWriter, r *http.Request) {
+	m, ok := h.benchAccess(w, r)
+	if !ok {
+		return
+	}
+	id := chi.URLParam(r, "id")
+	if _, ok := parseUUIDOrBadRequest(w, id, "id"); !ok {
+		return
+	}
+	msg, err := h.benchMessage(r.Context(), m, id)
+	if err != nil {
+		writeError(w, 404, "回答不存在")
+		return
+	}
+	if msg.Status == "running" {
+		_, err = h.DB.Exec(r.Context(), `UPDATE workbench_message SET status='cancelled',error='已停止，保留已核对的部分内容',progress='' WHERE id=$1 AND status='running'`, id)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		if stop, ok := h.benchRuns.Load(id); ok {
+			stop.(context.CancelFunc)()
+		}
+	}
+	writeJSON(w, 200, map[string]string{"status": "cancelled"})
+}
