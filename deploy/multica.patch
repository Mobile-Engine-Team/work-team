new file mode 100644
index 000000000..fd426e399
--- /dev/null
+++ b/server/pkg/agent/mc.go
@@ -0,0 +1,171 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os/exec"
+	"strings"
+	"time"
+)
+
+// Mobile Coder's run transport uses the same part objects as OpenCode, but
+// has its own CLI, permission flags, configuration, and terminal-step contract.
+type mcBackend struct{ cfg Config }
+
+func (b *mcBackend) Execute(ctx context.Context, prompt string, opts ExecOptions) (*Session, error) {
+	binary := b.cfg.ExecutablePath
+	if binary == "" {
+		binary = "mc"
+	}
+	path, err := exec.LookPath(binary)
+	if err != nil {
+		return nil, fmt.Errorf("resolve Mobile Coder: %w", err)
+	}
+	if len(opts.CustomArgs) != 0 {
+		return nil, fmt.Errorf("Mobile Coder runtime does not support custom arguments")
+	}
+	inline, err := buildOpenCodeMCPConfigContent(opts.McpConfig)
+	if err != nil {
+		return nil, err
+	}
+	args := []string{"run", "--format", "json", "--yolo"}
+	if opts.Cwd != "" {
+		args = append(args, "--dir", opts.Cwd)
+	}
+	if opts.Model != "" {
+		args = append(args, "--model", opts.Model)
+	}
+	if opts.ResumeSessionID != "" {
+		args = append(args, "--session", opts.ResumeSessionID)
+	}
+	if opts.ThinkingLevel != "" {
+		args = append(args, "--variant", opts.ThinkingLevel)
+	}
+
+	runCtx, cancel := runContext(ctx, opts.Timeout)
+	cmd := b.cfg.commandAt(path).exec(runCtx, args...)
+	hideAgentWindow(cmd)
+	cmd.Dir = opts.Cwd
+	cmd.Env = buildEnv(b.cfg.Env)
+	if opts.Cwd != "" {
+		cmd.Env = append(cmd.Env, "PWD="+opts.Cwd)
+	}
+	if inline != "" {
+		cmd.Env = append(cmd.Env, "MOBILE_CODER_CONFIG_CONTENT="+inline)
+	}
+	cmd.Stdin = strings.NewReader(prompt)
+	cmd.Stderr = newLogWriter(b.cfg.Logger, "[mc:stderr] ")
+	// Wait owns the os/exec pipes. Its bounded copy into out lets a cancelled
+	// process group or stalled descendant close the reader without a leak.
+	stdout, out := io.Pipe()
+	cmd.Stdout = out
+	cmd.WaitDelay = 5 * time.Second
+	b.cfg.logAgentCommandWithPrompt(cmd, newAgentCommandLogArgs(args, trustAgentCommandPositional(0, "run")), len(prompt))
+	start := time.Now()
+	if err := startOwnedProcessTree(cmd, b.cfg.Logger); err != nil {
+		cancel()
+		out.Close()
+		stdout.Close()
+		return nil, fmt.Errorf("start Mobile Coder: %w", err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		err := cmd.Wait()
+		releaseProcessGroup(cmd)
+		out.Close()
+		done <- err
+	}()
+	messages := make(chan Message, 256)
+	results := make(chan Result, 1)
+	go func() {
+		defer cancel()
+		result := b.scan(stdout, messages, opts.Model)
+		stdout.Close()
+		exitErr := <-done
+		switch {
+		case runCtx.Err() == context.DeadlineExceeded:
+			result.Status, result.Error = "timeout", "Mobile Coder exceeded task timeout"
+		case runCtx.Err() == context.Canceled:
+			result.Status, result.Error = "aborted", "Mobile Coder cancelled"
+		case exitErr != nil && result.Error == "":
+			result.Status, result.Error = "failed", fmt.Sprintf("Mobile Coder exited: %v", exitErr)
+		}
+		result.DurationMs = time.Since(start).Milliseconds()
+		close(messages)
+		results <- result
+		close(results)
+	}()
+	return &Session{Messages: messages, Result: results}, nil
+}
+
+func (b *mcBackend) scan(r io.Reader, ch chan<- Message, model string) Result {
+	result := Result{Status: "failed"}
+	var output strings.Builder
+	var usage TokenUsage
+	var finished, stepProducedText bool
+	parts := &opencodeBackend{cfg: b.cfg}
+	scan := newAgentStreamScanner(r)
+	for scan.Scan() {
+		var event opencodeEvent
+		if json.Unmarshal(scan.Bytes(), &event) != nil {
+			continue // source-mode startup may print diagnostics before JSON
+		}
+		if event.SessionID != "" && result.SessionID == "" {
+			result.SessionID = event.SessionID
+			trySend(ch, Message{Type: MessageStatus, Status: "running", SessionID: result.SessionID})
+		}
+		switch event.Type {
+		case "step_start":
+			finished, stepProducedText = false, false
+			trySend(ch, Message{Type: MessageStatus, Status: "running"})
+		case "text":
+			stepProducedText = stepProducedText || event.Part.Text != ""
+			parts.handleTextEvent(event, ch, &output)
+		case "reasoning":
+			trySend(ch, Message{Type: MessageThinking, Content: event.Part.Text})
+		case "tool_use":
+			finished = false
+			parts.handleToolUseEvent(event, ch)
+		case "permission_allowed", "permission_denied", "question_rejected":
+			trySend(ch, Message{Type: MessageLog, Level: "info", Content: "Mobile Coder: " + event.Type})
+		case "error":
+			result.Error = "Mobile Coder reported a session error"
+			if event.Error != nil && event.Error.Message() != "" {
+				result.Error = event.Error.Message()
+			}
+			trySend(ch, Message{Type: MessageError, Content: result.Error})
+		case "step_finish":
+			// A tools-only step needs another model turn. Length/unknown also
+			// fail closed; only a productive normal stop completes a run.
+			finished = event.Part.Reason == "stop" && (stepProducedText || stepReportedUsage(&event.Part))
+			if t := event.Part.Tokens; t != nil {
+				usage.InputTokens += t.Input
+				usage.OutputTokens += t.Output
+				if t.Cache != nil {
+					usage.CacheReadTokens += t.Cache.Read
+					usage.CacheWriteTokens += t.Cache.Write
+				}
+			}
+		}
+	}
+	if err := scan.Err(); err != nil {
+		result.Error = fmt.Sprintf("read Mobile Coder stream: %v", err)
+	}
+	if result.Error == "" {
+		if finished && result.SessionID != "" {
+			result.Status = "completed"
+		} else {
+			result.Error = "Mobile Coder stream ended without a completed session step"
+		}
+	}
+	result.Output = output.String()
+	if usage != (TokenUsage{}) {
+		if model == "" {
+			model = "unknown"
+		}
+		result.Usage = map[string]TokenUsage{model: usage}
+	}
+	return result
+}
