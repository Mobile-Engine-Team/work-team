+	"testing"
+
+	"github.com/multica-ai/multica/server/internal/testutil"
+	"github.com/multica-ai/multica/server/pkg/dbid"
+)
+
+func TestModelProbeIsolatedLifecycle(t *testing.T) {
+	rt := dbfx.Runtime(t, "probe runtime", testutil.Cols{"provider": "pi", "status": "online", "last_seen_at": "now()", "metadata": `{"capabilities":["model-probe-v1"]}`})
+	a := dbfx.Agent(t, "probe agent", rt, testutil.Cols{"model": "saved-model"})
+	id := uuidToString(dbid.NewV7())
+	t.Cleanup(func() {
+		testPool.Exec(context.Background(), `DELETE FROM project_planning_request WHERE runtime_id=$1`, rt)
+	})
+	body := map[string]any{"request_id": id, "agent_id": a, "prompt": "must not reach the model", "model": "untrusted-override"}
+	for n := 0; n < 2; n++ {
+		testutil.Call(t, testHandler.ModelProbe, newRequest("POST", "/api/model-probes", body)).Want(202)
+	}
+	var raw []byte
+	if err := testPool.QueryRow(context.Background(), `SELECT input FROM project_planning_request WHERE id=$1`, id).Scan(&raw); err != nil {
+		t.Fatal(err)
+	}
+	var input planningInput
+	json.Unmarshal(raw, &input)
+	if input.Model != "saved-model" || input.Purpose != "model_probe" || input.Instructions != "" || input.Conclusion != "" {
+		t.Fatalf("unexpected input %s", raw)
+	}
+	testutil.Call(t, testHandler.ModelProbe, newRequest("POST", "/api/model-probes", map[string]any{"request_id": uuidToString(dbid.NewV7()), "agent_id": a})).Want(409)
+	var claim struct {
+		Request struct {
+			ID, Prompt, Token string
+			RunID             string `json:"run_id"`
+		}
+	}
+	testutil.Call(t, testHandler.ClaimProjectPlanning, withURLParam(newRequest("POST", "/claim", nil), "runtimeId", rt)).Want(200).JSON(&claim)
+	if !strings.Contains(claim.Request.Prompt, "MW_CONNECTION_OK") || strings.Contains(claim.Request.Prompt, "must not reach") {
+		t.Fatalf("wrong prompt %s", claim.Request.Prompt)
+	}
+	request := withURLParam(newRequest("POST", "/result", map[string]any{"run_id": claim.Request.RunID, "output": "MW_CONNECTION_OK"}), "requestId", id)
+	request.Header.Set("Authorization", "Bearer "+claim.Request.Token)
+	testutil.Call(t, testHandler.ProjectPlanningResult, request).Want(200)
+	var result struct {
+		Status string
+		Passed bool
+	}
+	testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("GET", "/probe", nil), "requestId", id)).Want(200).JSON(&result)
+	testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("DELETE", "/probe", nil), "requestId", id)).Want(200)
+	testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("GET", "/probe", nil), "requestId", id)).Want(200).JSON(&result)
+	if !result.Passed || result.Status != "succeeded" {
+		t.Fatalf("result %+v", result)
+	}
+	var count int
+	testPool.QueryRow(context.Background(), `SELECT count(*) FROM agent_task_queue WHERE agent_id=$1`, a).Scan(&count)
+	if count != 0 {
+		t.Fatal("probe created a business run")
+	}
+}
+
+func TestModelProbeAccessCapabilityAndCancellation(t *testing.T) {
+	rt := dbfx.Runtime(t, "probe gates", testutil.Cols{"provider": "pi", "status": "online", "last_seen_at": "now()", "metadata": `{"capabilities":["model-probe-v1"]}`})
+	a := dbfx.Agent(t, "probe gates", rt)
+	id := uuidToString(dbid.NewV7())
+	t.Cleanup(func() {
+		testPool.Exec(context.Background(), `DELETE FROM project_planning_request WHERE runtime_id=$1`, rt)
+	})
+	body := map[string]any{"request_id": id, "agent_id": a}
+	if _, err := testPool.Exec(context.Background(), `UPDATE agent SET owner_id=$2 WHERE id=$1`, a, dbfx.User(t, "Other probe owner", "other-probe@example.test")); err != nil {
+		t.Fatal(err)
+	}
+	testutil.Call(t, testHandler.ModelProbe, newRequest("POST", "/probe", body)).Want(403)
+	testPool.Exec(context.Background(), `UPDATE agent SET owner_id=$2 WHERE id=$1`, a, testUserID)
+	testPool.Exec(context.Background(), `UPDATE agent_runtime SET metadata='{}' WHERE id=$1`, rt)
+	testutil.Call(t, testHandler.ModelProbe, newRequest("POST", "/probe", body)).Want(422)
+	testPool.Exec(context.Background(), `UPDATE agent_runtime SET metadata='{"capabilities":["model-probe-v1"]}',status='offline' WHERE id=$1`, rt)
+	testutil.Call(t, testHandler.ModelProbe, newRequest("POST", "/probe", body)).Want(503)
+	testPool.Exec(context.Background(), `UPDATE agent_runtime SET status='online' WHERE id=$1`, rt)
+	testutil.Call(t, testHandler.ModelProbe, newRequest("POST", "/probe", body)).Want(202)
+	testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("DELETE", "/probe", nil), "requestId", id)).Want(200)
+	testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("DELETE", "/probe", nil), "requestId", id)).Want(200)
+	var result struct {
+		Status string
+		Passed bool
+	}
+	testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("GET", "/probe", nil), "requestId", id)).Want(200).JSON(&result)
+	if result.Status != "cancelled" || result.Passed {
+		t.Fatalf("result %+v", result)
+	}
+}
+
+func TestModelProbeExpiryAndLateResult(t *testing.T) {
+	rt := dbfx.Runtime(t, "probe expiry", testutil.Cols{"provider": "pi", "status": "online", "last_seen_at": "now()", "metadata": `{"capabilities":["model-probe-v1"]}`})
+	a := dbfx.Agent(t, "probe expiry", rt)
+	t.Cleanup(func() {
+		testPool.Exec(context.Background(), `DELETE FROM project_planning_request WHERE runtime_id=$1`, rt)
+	})
+	for _, end := range []string{"cancelled", "timeout", "invalid_response"} {
+		t.Run(end, func(t *testing.T) {
+			id := uuidToString(dbid.NewV7())
+			testutil.Call(t, testHandler.ModelProbe, newRequest("POST", "/probe", map[string]any{"agent_id": a, "request_id": id})).Want(202)
+			var claim struct {
+				Request struct {
+					RunID string `json:"run_id"`
+					Token string
+				}
+			}
+			testutil.Call(t, testHandler.ClaimProjectPlanning, withURLParam(newRequest("POST", "/claim", nil), "runtimeId", rt)).Want(200).JSON(&claim)
+			if end == "cancelled" {
+				testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("DELETE", "/probe", nil), "requestId", id)).Want(200)
+			}
+			if end == "timeout" {
+				if _, err := testPool.Exec(context.Background(), `UPDATE project_planning_request SET created_at=now()-interval '3 minutes' WHERE id=$1`, id); err != nil {
+					t.Fatal(err)
+				}
+				testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("GET", "/probe", nil), "requestId", id)).Want(200)
+			}
+			output := "MW_CONNECTION_OK"
+			if end == "invalid_response" {
+				output = "not the connection marker"
+			}
+			report := withURLParam(newRequest("POST", "/result", map[string]any{"run_id": claim.Request.RunID, "output": output}), "requestId", id)
+			report.Header.Set("Authorization", "Bearer "+claim.Request.Token)
+			want := 409
+			if end == "invalid_response" {
+				want = 200
+			}
+			testutil.Call(t, testHandler.ProjectPlanningResult, report).Want(want)
+			var state struct {
+				Status, Reason string
+				Passed         bool
+			}
+			testutil.Call(t, testHandler.ModelProbe, withURLParam(newRequest("GET", "/probe", nil), "requestId", id)).Want(200).JSON(&state)
+			expected := "failed"
+			if end == "cancelled" {
+				expected = end
+			}
+			if state.Status != expected || state.Passed || (end == "timeout" && state.Reason != "timeout") {
+				t.Fatalf("%+v", state)
+			}
+		})
+	}
+}
