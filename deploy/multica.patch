+	content = fmt.Sprintf("[@A](mention://squad/%s) request", squadA)
+	testutil.Call(t, testHandler.CreateComment, withURLParam(newRequest(http.MethodPost, "/comments", map[string]any{"content": content}), "id", issueID)).Want(http.StatusCreated).JSON(&first)
+	testutil.Call(t, testHandler.CreateComment, withURLParam(newRequest(http.MethodPost, "/comments", map[string]any{"content": content, "parent_id": first.ID}), "id", issueID)).Want(http.StatusCreated)
+	tasks, err := testHandler.Queries.ListTasksByIssue(context.Background(), parseUUID(issueID))
