+// Topic messages notify humans only; never pass through comment agent triggers.
+func (h *Handler) projectTopicMentions(ctx context.Context, tx pgx.Tx, p db.Project, topic, actor pgtype.UUID, content string) error {
+	q := h.Queries.WithTx(tx)
+	for _, mention := range util.ParseMentions(content) {
+		if mention.Type != "member" {
+			continue
+		}
+		id, err := util.ParseUUID(mention.ID)
+		if err != nil || id == actor {
+			continue
+		}
+		var exists bool
+		if err = tx.QueryRow(ctx, "SELECT EXISTS(SELECT 1 FROM member WHERE workspace_id=$1 AND user_id=$2)", p.WorkspaceID, id).Scan(&exists); err != nil {
+			return err
+		}
+		if !exists {
+			continue
+		}
+		details, _ := json.Marshal(map[string]string{"project_id": uuidToString(p.ID), "topic_id": uuidToString(topic)})
+		_, err = q.CreateInboxItem(ctx, db.CreateInboxItemParams{WorkspaceID: p.WorkspaceID, RecipientType: "member", RecipientID: id, Type: "mentioned", Severity: "info", Title: p.Title, Body: pgtype.Text{String: content, Valid: true}, ActorType: pgtype.Text{String: "member", Valid: true}, ActorID: actor, Details: details})
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
+func (h *Handler) IssueProjectTopics(w http.ResponseWriter, r *http.Request) {
+	ws := h.resolveWorkspaceID(r)
+	if _, ok := h.requireWorkspaceMember(w, r, ws, "task not found"); !ok {
+		return
+	}
+	id, ok := parseUUIDOrBadRequest(w, chi.URLParam(r, "issueId"), "issue_id")
+	if !ok {
+		return
+	}
+	rows, err := h.DB.Query(r.Context(), `SELECT t.id::text,t.project_id::text,t.title,COALESCE((SELECT string_agg('V'||f.conclusion_revision::text||E'\n'||c.content,E'\n\n' ORDER BY f.created_at) FROM project_topic_followup f JOIN project_topic_conclusion c ON c.topic_id=f.topic_id AND c.revision=f.conclusion_revision WHERE f.topic_id=t.id AND f.issue_id=$1),''),COALESCE((SELECT jsonb_agg(jsonb_build_object('revision',c.revision,'content',c.content,'confirmed_at',c.confirmed_at) ORDER BY c.revision) FROM project_topic_conclusion c WHERE c.topic_id=t.id AND EXISTS(SELECT 1 FROM project_topic_followup f WHERE f.topic_id=t.id AND f.issue_id=$1 AND f.conclusion_revision=c.revision)),'[]'::jsonb) FROM project_topic t JOIN issue i ON i.id=$1 AND i.workspace_id=t.workspace_id WHERE t.workspace_id=$2 AND $1=ANY(t.issue_ids) ORDER BY t.updated_at DESC`, id, ws)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	defer rows.Close()
+	result := []map[string]any{}
+	for rows.Next() {
+		var id, project, title, sources string
+		var adopted json.RawMessage
+		if err = rows.Scan(&id, &project, &title, &sources, &adopted); err != nil {
+			planWriteError(w, err)
+			return
+		}
+		result = append(result, map[string]any{"id": id, "project_id": project, "title": title, "adopted_conclusions": sources, "adopted_versions": adopted})
+	}
+	if err = rows.Err(); err != nil {
+		planWriteError(w, err)
+		return
+	}
+	writeJSON(w, 200, map[string]any{"topics": result})
+}
diff --git a/server/internal/handler/task_draft.go b/server/internal/handler/task_draft.go
new file mode 100644
index 000000000..a35f750e6
--- /dev/null
+++ b/server/internal/handler/task_draft.go
@@ -0,0 +1,150 @@
+package handler
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"github.com/go-chi/chi/v5"
+	"github.com/jackc/pgx/v5/pgtype"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+	"net/http"
+	"strings"
+	"time"
+	_ "time/tzdata"
+)
+
+func (h *Handler) TaskDraft(w http.ResponseWriter, r *http.Request) {
+	ws := h.resolveWorkspaceID(r)
+	m, ok := h.requireWorkspaceMember(w, r, ws, "workspace not found")
+	if !ok {
+		return
+	}
+	actor, _ := h.resolveActor(r, requestUserID(r), ws)
+	if actor != "member" || m.Role == "guest" {
+		writeError(w, 403, "仅成员可以生成任务草稿")
+		return
+	}
+	if r.Method == "GET" {
+		id, ok := parseUUIDOrBadRequest(w, chi.URLParam(r, "requestId"), "request_id")
+		if !ok {
+			return
+		}
+		_, err := h.DB.Exec(r.Context(), `UPDATE project_planning_request SET status='failed',error='生成超时，请明确重试',updated_at=now() WHERE id=$1 AND workspace_id=$2 AND created_by=$3 AND status IN ('queued','running') AND COALESCE(lease_expires_at,created_at+interval '5 minutes')<now()`, id, m.WorkspaceID, m.UserID)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		var status string
+		var result []byte
+		var failure *string
+		err = h.DB.QueryRow(r.Context(), `SELECT status,result,error FROM project_planning_request WHERE id=$1 AND workspace_id=$2 AND created_by=$3 AND input->>'purpose'='task_draft'`, id, m.WorkspaceID, m.UserID).Scan(&status, &result, &failure)
+		if err != nil {
+			writeError(w, 404, "任务草稿不存在")
+			return
+		}
+		var draft *taskDraftResult
+		if len(result) > 0 {
+			if err = json.Unmarshal(result, &draft); err != nil {
+				planWriteError(w, err)
+				return
+			}
+		}
+		writeJSON(w, 200, map[string]any{"id": uuidToString(id), "status": status, "draft": draft, "error": failure})
+		return
+	}
+	var req struct {
+		RequestID string `json:"request_id"`
+		AgentID   string `json:"agent_id"`
+		Prompt    string `json:"prompt"`
+		ProjectID string `json:"project_id"`
+		TopicID   string `json:"topic_id"`
+		Revision  int    `json:"revision"`
+		Timezone  string `json:"timezone"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	id, ok := parseUUIDOrBadRequest(w, req.RequestID, "request_id")
+	if !ok {
+		return
+	}
+	aid, ok := parseUUIDOrBadRequest(w, req.AgentID, "agent_id")
+	if !ok {
+		return
+	}
+	if len(req.Prompt) > 50000 || strings.TrimSpace(req.Prompt) == "" {
+		writeError(w, 422, "请填写需要整理的任务要求")
+		return
+	}
+	if status, msg := h.validateAssigneePair(r.Context(), r, ws, pgtype.Text{String: "agent", Valid: true}, aid); status != 0 {
+		writeError(w, status, msg)
+		return
+	}
+	a, err := h.Queries.GetAgentInWorkspace(r.Context(), db.GetAgentInWorkspaceParams{ID: aid, WorkspaceID: m.WorkspaceID})
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	rt, err := h.Queries.GetAgentRuntime(r.Context(), a.RuntimeID)
+	if err != nil || (rt.Provider != "mc" && rt.Provider != "pi" && rt.Provider != "codex" && rt.Provider != "claude" && rt.Provider != "opencode") || rt.ProfileID.Valid || !runtimeHasCapability(rt.Metadata, "task-draft-v1") {
+		writeError(w, 422, "请升级并重启执行端后生成任务草稿")
+		return
+	}
+	if rt.Status == "offline" || !rt.LastSeenAt.Valid || time.Since(rt.LastSeenAt.Time) > 90*time.Second {
+		writeError(w, 503, "智能体执行端离线，请启用后重试")
+		return
+	}
+	location := time.UTC
+	if req.Timezone != "" {
+		var zoneErr error
+		location, zoneErr = time.LoadLocation(req.Timezone)
+		if zoneErr != nil {
+			writeError(w, 422, "时区无效，请刷新后重试")
+			return
+		}
+	}
+	input := planningInput{Purpose: "task_draft", Instructions: req.Prompt, Model: a.Model.String, ReferenceDate: time.Now().In(location).Format("2006-01-02"), Timezone: location.String()}
+	var project pgtype.UUID
+	if req.ProjectID != "" {
+		project, ok = parseUUIDOrBadRequest(w, req.ProjectID, "project_id")
+		if !ok {
+			return
+		}
+		var title string
+		err = h.DB.QueryRow(r.Context(), `SELECT title FROM project WHERE id=$1 AND workspace_id=$2`, project, m.WorkspaceID).Scan(&title)
+		if err != nil {
+			writeError(w, 404, "项目不存在")
+			return
+		}
+		input.Goal = title
+	}
+	if req.TopicID != "" {
+		topic, valid := parseUUIDOrBadRequest(w, req.TopicID, "topic_id")
+		if !valid {
+			return
+		}
+		err = h.DB.QueryRow(r.Context(), `SELECT t.title,c.content FROM project_topic t JOIN project_topic_conclusion c ON c.topic_id=t.id AND c.revision=$4 WHERE t.id=$1 AND t.project_id=$2 AND t.workspace_id=$3`, topic, project, m.WorkspaceID, req.Revision).Scan(&input.TopicTitle, &input.Conclusion)
+		if err != nil {
+			writeError(w, 409, "采用的结论版本不存在，请返回话题核对")
+			return
+		}
+		input.TopicID = req.TopicID
+		input.ConclusionRevision = req.Revision
+	}
+	raw, _ := json.Marshal(input)
+	sum := sha256.Sum256(raw)
+	tag, err := h.DB.Exec(r.Context(), `INSERT INTO project_planning_request(id,project_id,workspace_id,agent_id,runtime_id,request_id,base_revision,input,input_hash,created_by) VALUES($1,$2,$3,$4,$5,$6,0,$7,$8,$9) ON CONFLICT(id) DO NOTHING`, id, project, m.WorkspaceID, aid, rt.ID, req.RequestID, raw, hex.EncodeToString(sum[:]), m.UserID)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if tag.RowsAffected() == 0 {
+		var own bool
+		err = h.DB.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM project_planning_request WHERE id=$1 AND workspace_id=$2 AND created_by=$3 AND input=$4 AND agent_id=$5)`, id, m.WorkspaceID, m.UserID, raw, aid).Scan(&own)
+		if err != nil || !own {
+			writeError(w, 409, "请求已存在，请重新生成请求")
+			return
+		}
+	}
+	writeJSON(w, 202, map[string]string{"id": req.RequestID})
+}
diff --git a/server/internal/handler/task_draft_contract.go b/server/internal/handler/task_draft_contract.go
new file mode 100644
index 000000000..1fd06e85c
--- /dev/null
+++ b/server/internal/handler/task_draft_contract.go
@@ -0,0 +1,47 @@
+package handler
+
+import (
+	"encoding/json"
+	"strings"
+	"time"
+)
+
+type taskDraftResult struct {
+	Title       string   `json:"title"`
+	Description string   `json:"description"`
+	DueDate     string   `json:"due_date"`
+	Questions   []string `json:"questions"`
+}
+
+type taskDraftContext struct {
+	Instructions       string
+	Goal               string
+	TopicTitle         string
+	Conclusion         string
+	ConclusionRevision int
+	ReferenceDate      string
+	Timezone           string
+}
+
+func taskDraftPrompt(input taskDraftContext) string {
+	raw, _ := json.Marshal(map[string]any{"requirements": input.Instructions, "project": input.Goal, "topic": input.TopicTitle, "adopted_conclusion": input.Conclusion, "adopted_revision": input.ConclusionRevision, "reference_date": input.ReferenceDate, "timezone": input.Timezone})
+	return `Return only JSON {"title":"...","description":"...","due_date":"YYYY-MM-DD or empty string","questions":[]}. Draft one task in the input language. Preserve confirmed facts. Extract an explicitly requested deadline; resolve unambiguous relative dates using reference_date in timezone. Never invent a deadline or owner. When no deadline is given leave due_date empty. For ambiguous dates leave due_date empty and ask a short clarification in questions. Keep questions to at most 10 short strings, only for actual ambiguities, not every optional field. Do not execute work, create issues, or change shared state. Input:
+` + string(raw)
+}
+
+func validTaskDraft(d taskDraftResult) bool {
+	if strings.TrimSpace(d.Title) == "" || len(d.Title) > 500 || strings.TrimSpace(d.Description) == "" || len(d.Description) > 12000 || len(d.Questions) > 10 {
+		return false
+	}
+	if d.DueDate != "" {
+		if _, err := time.Parse("2006-01-02", d.DueDate); err != nil {
+			return false
+		}
+	}
+	for _, q := range d.Questions {
+		if strings.TrimSpace(q) == "" || len(q) > 1000 {
+			return false
+		}
+	}
+	return true
+}
diff --git a/server/internal/handler/task_draft_fields_test.go b/server/internal/handler/task_draft_fields_test.go
new file mode 100644
index 000000000..6d4e78666
--- /dev/null
+++ b/server/internal/handler/task_draft_fields_test.go
@@ -0,0 +1,46 @@
+package handler
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestTaskDraftFields(t *testing.T) {
+	for _, tc := range []struct {
+		name, date string
+		valid      bool
+	}{
+		{"no deadline", "", true}, {"explicit deadline", "2026-11-20", true},
+		{"leap day", "2028-02-29", true}, {"invalid date", "2026-02-29", false},
+		{"relative date not resolved", "next Friday", false}, {"timestamp", "2026-11-20T00:00:00Z", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			d := taskDraftResult{Title: "Demo", Description: "Prepare the plan", DueDate: tc.date}
+			if validTaskDraft(d) != tc.valid {
+				t.Fatalf("date=%q valid=%v", tc.date, validTaskDraft(d))
+			}
+		})
+	}
+	var old taskDraftResult
+	if err := json.Unmarshal([]byte(`{"title":"Existing draft","description":"Keep this"}`), &old); err != nil || !validTaskDraft(old) {
+		t.Fatal("existing drafts must remain readable")
+	}
+	d := taskDraftResult{Title: "Demo", Description: "Plan", Questions: []string{"Which Friday?"}}
+	if !validTaskDraft(d) {
+		t.Fatal("clarification should be retained")
+	}
+	d.Questions = []string{""}
+	if validTaskDraft(d) {
+		t.Fatal("empty clarification should fail")
+	}
+}
+
+func TestTaskDraftPromptIncludesDateContext(t *testing.T) {
+	prompt := taskDraftPrompt(taskDraftContext{Instructions: "下周五前整理方案", ReferenceDate: "2026-11-12", Timezone: "Asia/Shanghai"})
+	for _, want := range []string{"2026-11-12", "Asia/Shanghai", "due_date", "questions", "Never invent a deadline", "下周五前整理方案"} {
+		if !strings.Contains(prompt, want) {
+			t.Fatalf("missing %s", want)
+		}
+	}
+}
diff --git a/server/internal/handler/workbench.go b/server/internal/handler/workbench.go
new file mode 100644
index 000000000..2c5dde2b5
