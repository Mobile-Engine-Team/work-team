diff --git a/server/internal/handler/model_probe.go b/server/internal/handler/model_probe.go
new file mode 100644
index 000000000..117773440
--- /dev/null
+++ b/server/internal/handler/model_probe.go
@@ -0,0 +1,149 @@
+package handler
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+)
+
+// Diagnostics use the existing durable request/lease transport, never an issue
+// or an agent conversation. The server alone supplies model and fixed input.
+func (h *Handler) ModelProbe(w http.ResponseWriter, r *http.Request) {
+	ws := h.resolveWorkspaceID(r)
+	m, ok := h.requireWorkspaceMember(w, r, ws, "workspace not found")
+	if !ok {
+		return
+	}
+	actor, _ := h.resolveActor(r, requestUserID(r), ws)
+	if actor != "member" || m.Role == "guest" {
+		writeError(w, 403, "member required")
+		return
+	}
+	if r.Method != http.MethodPost {
+		id, valid := parseUUIDOrBadRequest(w, chi.URLParam(r, "requestId"), "request_id")
+		if !valid {
+			return
+		}
+		if r.Method == http.MethodDelete {
+			tag, err := h.DB.Exec(r.Context(), `UPDATE project_planning_request SET status='cancelled',updated_at=now() WHERE id=$1 AND workspace_id=$2 AND created_by=$3 AND input->>'purpose'='model_probe' AND status IN ('queued','running')`, id, m.WorkspaceID, m.UserID)
+			if err != nil {
+				planWriteError(w, err)
+				return
+			}
+			if tag.RowsAffected() == 0 {
+				var exists bool
+				err = h.DB.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM project_planning_request WHERE id=$1 AND workspace_id=$2 AND created_by=$3 AND input->>'purpose'='model_probe')`, id, m.WorkspaceID, m.UserID).Scan(&exists)
+				if err != nil {
+					planWriteError(w, err)
+					return
+				}
+				if !exists {
+					writeError(w, 404, "probe not found")
+					return
+				}
+			}
+			writeJSON(w, 200, map[string]bool{"ok": true})
+			return
+		}
+		_, err := h.DB.Exec(r.Context(), `UPDATE project_planning_request SET status='failed',error='timeout',updated_at=now() WHERE id=$1 AND workspace_id=$2 AND created_by=$3 AND input->>'purpose'='model_probe' AND status IN ('queued','running') AND created_at<now()-interval '2 minutes'`, id, m.WorkspaceID, m.UserID)
+		if err != nil {
+			planWriteError(w, err)
+			return
+		}
+		var status, model string
+		var failure *string
+		var updated time.Time
+		err = h.DB.QueryRow(r.Context(), `SELECT status,error,updated_at,COALESCE(input->>'model','') FROM project_planning_request WHERE id=$1 AND workspace_id=$2 AND created_by=$3 AND input->>'purpose'='model_probe'`, id, m.WorkspaceID, m.UserID).Scan(&status, &failure, &updated, &model)
+		if err != nil {
+			writeError(w, 404, "probe not found")
+			return
+		}
+		passed := status == "succeeded"
+		reason := ""
+		if status == "failed" {
+			reason = "other"
+			if failure != nil && *failure == "timeout" {
+				reason = "timeout"
+			}
+		}
+		writeJSON(w, 200, map[string]any{"id": uuidToString(id), "status": status, "passed": passed, "reason": reason, "model": model, "checkedAt": updated})
+		return
+	}
+	var req struct {
+		RequestID string `json:"request_id"`
+		AgentID   string `json:"agent_id"`
+	}
+	if !decodePlan(w, r, &req) {
+		return
+	}
+	id, ok := parseUUIDOrBadRequest(w, req.RequestID, "request_id")
+	if !ok {
+		return
+	}
+	aid, ok := parseUUIDOrBadRequest(w, req.AgentID, "agent_id")
+	if !ok {
+		return
+	}
+	a, err := h.Queries.GetAgentInWorkspace(r.Context(), db.GetAgentInWorkspaceParams{ID: aid, WorkspaceID: m.WorkspaceID})
+	if err != nil || a.OwnerID != m.UserID {
+		writeError(w, 403, "only the owner can test this agent")
+		return
+	}
+	rt, err := h.Queries.GetAgentRuntime(r.Context(), a.RuntimeID)
+	if err != nil || (rt.Provider != "mc" && rt.Provider != "pi" && rt.Provider != "codex" && rt.Provider != "claude" && rt.Provider != "opencode") || rt.ProfileID.Valid || !runtimeHasCapability(rt.Metadata, "model-probe-v1") {
+		writeError(w, 422, "TEAM_PROBE_UPGRADE")
+		return
+	}
+	if rt.Status != "online" || !rt.LastSeenAt.Valid || time.Since(rt.LastSeenAt.Time) > 90*time.Second {
+		writeError(w, 503, "TEAM_ENDPOINT_OFFLINE")
+		return
+	}
+	raw, _ := json.Marshal(planningInput{Purpose: "model_probe", Model: a.Model.String})
+	sum := sha256.Sum256(raw)
+	tx, err := h.TxStarter.Begin(r.Context())
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	defer tx.Rollback(r.Context())
+	// Serialize diagnostic submissions for this runtime, including different agents.
+	if _, err = tx.Exec(r.Context(), `SELECT id FROM agent_runtime WHERE id=$1 FOR UPDATE`, rt.ID); err != nil {
+		planWriteError(w, err)
+		return
+	}
+	var exists bool
+	err = tx.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM project_planning_request WHERE id=$1 AND workspace_id=$2 AND created_by=$3 AND agent_id=$4 AND input->>'purpose'='model_probe')`, id, m.WorkspaceID, m.UserID, aid).Scan(&exists)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if exists {
+		writeJSON(w, 202, map[string]string{"id": req.RequestID})
+		return
+	}
+	var busy bool
+	err = tx.QueryRow(r.Context(), `SELECT EXISTS(SELECT 1 FROM agent_task_queue WHERE runtime_id=$1 AND status NOT IN ('completed','failed','cancelled')) OR EXISTS(SELECT 1 FROM project_planning_request WHERE runtime_id=$1 AND status IN ('queued','running') AND COALESCE(lease_expires_at,created_at+interval '5 minutes')>now())`, rt.ID).Scan(&busy)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if busy {
+		writeError(w, 409, "TEAM_AGENT_BUSY")
+		return
+	}
+	_, err = tx.Exec(r.Context(), `INSERT INTO project_planning_request(id,workspace_id,agent_id,runtime_id,request_id,base_revision,input,input_hash,created_by,lease_expires_at) VALUES($1,$2,$3,$4,$5,0,$6,$7,$8,now()+interval '2 minutes')`, id, m.WorkspaceID, aid, rt.ID, req.RequestID, raw, hex.EncodeToString(sum[:]), m.UserID)
+	if err != nil {
+		planWriteError(w, err)
+		return
+	}
+	if err = tx.Commit(r.Context()); err != nil {
+		planWriteError(w, err)
+		return
+	}
+	writeJSON(w, 202, map[string]string{"id": req.RequestID})
+}
