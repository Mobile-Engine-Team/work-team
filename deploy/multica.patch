+func TestMWMixedScopesAreExplicitlyBlockedAndSameScopeStillCoalesces(t *testing.T) {
+	useMWCommentPolicy(t)
+	runtimeID := dbfx.Runtime(t, "MW mixed scope runtime")
+	leader := dbfx.Agent(t, "MW mixed scope leader", runtimeID)
+	squadA := dbfx.Squad(t, "MW mixed A", leader)
+	squadB := dbfx.Squad(t, "MW mixed B", leader)
+	issueID := dbfx.Issue(t, "MW mixed scope issue")
+	var mixed CommentResponse
+	content := fmt.Sprintf("[@A](mention://squad/%s) [@B](mention://squad/%s)", squadA, squadB)
+	testutil.Call(t, testHandler.CreateComment, withURLParam(newRequest(http.MethodPost, "/comments", map[string]any{"content": content}), "id", issueID)).Want(http.StatusCreated).JSON(&mixed)
+	if len(mixed.TriggerOutcomes) != 2 {
+		t.Fatalf("mixed outcomes: %+v", mixed.TriggerOutcomes)
+	}
+	for _, outcome := range mixed.TriggerOutcomes {
+		if outcome.ReasonCode != ReasonInvocationScopeConflict {
