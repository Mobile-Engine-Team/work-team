+func TestWorkbenchRefreshImmediatelyAfterChangeAndFailure(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "refresh.mjs")
+	script := `import readline from 'node:readline';console.log(JSON.stringify({type:'runtime_ready'}));readline.createInterface({input:process.stdin}).on('line',l=>{const r=JSON.parse(l);if(r.type==='run')setTimeout(()=>console.log(JSON.stringify({type:'settled',runId:r.runId,error:'fixture failed'})),200)});`
+	if err := os.WriteFile(path, []byte(script), 0600); err != nil {
+		t.Fatal(err)
+	}
+	pi := workbench.NewPi(workbench.PiConfig{Key: "fake", BaseURL: "http://127.0.0.1:1", Script: path})
+	previous := testHandler.WorkbenchPi
+	testHandler.WorkbenchPi = pi
+	defer func() { pi.Close(); testHandler.WorkbenchPi = previous }()
+	warmCtx, stopWarm := context.WithCancel(context.Background())
+	defer stopWarm()
+	go pi.Warmup(warmCtx)
+	deadline := time.Now().Add(5 * time.Second)
+	for pi.RequireReady() != nil && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if err := pi.RequireReady(); err != nil {
+		t.Fatal(err)
+	}
+	f := testutil.New(testPool, testWorkspaceID, testUserID)
+	old := benchJSON(workbench.Result{View: workbench.View{Title: "Previous verified result"}, Evidence: []workbench.Evidence{}})
+	pin := f.Insert(t, "saved_view", testutil.Cols{"workspace_id": testWorkspaceID, "owner_id": testUserID, "name": "refresh test", "intent": "q", "definition": `{}`, "result": old, "fingerprint": "changed", "status": "ready"})
+	// A newly saved view must refresh immediately when its source has changed.
+	testutil.Call(t, testHandler.WorkbenchRefresh, withURLParam(newRequest("POST", "/", nil), "id", pin)).Want(202)
+	var state map[string]string
+	testutil.Call(t, testHandler.WorkbenchRefresh, withURLParam(newRequest("POST", "/", nil), "id", pin)).Want(200).JSON(&state)
+	if state["status"] != "refreshing" {
+		t.Fatalf("duplicate refresh: %v", state)
+	}
+	for attempt := 0; attempt < 2; attempt++ {
+		deadline = time.Now().Add(5 * time.Second)
+		var status, title string
+		var cleared bool
+		for time.Now().Before(deadline) {
+			err := testPool.QueryRow(context.Background(), `SELECT status,result->'view'->>'title',refresh_id IS NULL FROM saved_view WHERE id=$1`, pin).Scan(&status, &title, &cleared)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if status == "failed" {
+				break
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		if status != "failed" || !cleared || title != "Previous verified result" {
+			t.Fatalf("failed refresh lost recovery: %s %s %v", status, title, cleared)
+		}
+		if attempt == 0 {
+			testutil.Call(t, testHandler.WorkbenchRefresh, withURLParam(newRequest("POST", "/", nil), "id", pin)).Want(202)
+		}
+	}
+}
