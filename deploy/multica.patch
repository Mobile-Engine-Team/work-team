+	testHandler.cfg.NativeCommentRouting = false
+	t.Cleanup(func() { testHandler.cfg.NativeCommentRouting = previous })
+}
+
+func TestMWMemberCommentsRequireExplicitAgentTarget(t *testing.T) {
+	useMWCommentPolicy(t)
+	ctx := context.Background()
+	runtimeID := dbfx.Runtime(t, "MW explicit runtime")
+	leader := dbfx.Agent(t, "MW explicit leader", runtimeID)
+	squad := dbfx.Squad(t, "MW explicit squad", leader)
+	for _, owner := range []string{"agent", "squad", "member"} {
+		t.Run(owner, func(t *testing.T) {
+			ownerID := leader
+			if owner == "squad" {
+				ownerID = squad
+			}
+			if owner == "member" {
+				ownerID = testUserID
+			}
+			issueID := dbfx.Issue(t, "MW explicit discussion", testutil.Cols{"assignee_type": owner, "assignee_id": ownerID})
+			root := dbfx.Comment(t, issueID, fmt.Sprintf("[@leader](mention://agent/%s) original request", leader))
+			leaderReply := dbfx.Comment(t, issueID, "leader response", testutil.Cols{"author_type": "agent", "author_id": leader, "parent_id": root})
+			dbfx.Task(t, leader, testutil.Cols{"runtime_id": runtimeID, "issue_id": issueID, "trigger_comment_id": root, "status": "completed"})
+			for _, parent := range []string{"", root, leaderReply} {
+				for _, content := range []string{"普通留言", fmt.Sprintf("[@member](mention://member/%s) 请查阅", testUserID)} {
+					body := map[string]any{"content": content}
+					if parent != "" {
+						body["parent_id"] = parent
+					}
+					var preview CommentTriggerPreviewResponse
+					req := withURLParam(newRequest(http.MethodPost, "/api/issues/"+issueID+"/comment-trigger-preview", body), "id", issueID)
+					testutil.Call(t, testHandler.PreviewCommentTriggers, req).Want(http.StatusOK).JSON(&preview)
+					if len(preview.Agents) != 0 {
+						t.Fatalf("ordinary discussion preview started %d agents", len(preview.Agents))
+					}
+					req = withURLParam(newRequest(http.MethodPost, "/api/issues/"+issueID+"/comments", body), "id", issueID)
+					testutil.Call(t, testHandler.CreateComment, req).Want(http.StatusCreated)
+					tasks, err := testHandler.Queries.ListTasksByIssue(ctx, parseUUID(issueID))
+					if err != nil {
+						t.Fatal(err)
+					}
+					if len(tasks) != 1 {
+						t.Fatalf("ordinary discussion enqueued task: %d", len(tasks))
+					}
+				}
+			}
+		})
