+func TestWorkbenchRecoveryPreservesCompletedSnapshots(t *testing.T) {
+	f := testutil.New(testPool, testWorkspaceID, testUserID)
+	conv := f.Insert(t, "workbench_conversation", testutil.Cols{"workspace_id": testWorkspaceID, "owner_id": testUserID, "title": "recovery"})
+	result := benchJSON(workbench.Result{View: workbench.View{Title: "last complete answer"}, Evidence: []workbench.Evidence{}})
+	running := f.Insert(t, "workbench_message", testutil.Cols{"id": uuid.NewString(), "conversation_id": conv, "workspace_id": testWorkspaceID, "owner_id": testUserID, "prompt": "in flight", "progress": "reading"})
+	complete := f.Insert(t, "workbench_message", testutil.Cols{"id": uuid.NewString(), "conversation_id": conv, "workspace_id": testWorkspaceID, "owner_id": testUserID, "prompt": "done", "status": "completed", "result": result})
+	pin := f.Insert(t, "saved_view", testutil.Cols{"workspace_id": testWorkspaceID, "owner_id": testUserID, "name": "saved", "intent": "saved", "definition": `{}`, "result": result, "fingerprint": "last", "status": "refreshing", "refresh_id": uuid.NewString()})
+
+	// Recovery owns every unfinished row at startup. Shadow those tables so this
+	// test never interrupts a different test or a local demo sharing the database.
+	tx, err := testPool.Begin(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback(context.Background())
+	if _, err = tx.Exec(context.Background(), `CREATE TEMP TABLE workbench_message (LIKE public.workbench_message INCLUDING ALL) ON COMMIT DROP; CREATE TEMP TABLE saved_view (LIKE public.saved_view INCLUDING ALL) ON COMMIT DROP`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = tx.Exec(context.Background(), `INSERT INTO workbench_message SELECT * FROM public.workbench_message WHERE id=$1 OR id=$2`, running, complete); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = tx.Exec(context.Background(), `INSERT INTO saved_view SELECT * FROM public.saved_view WHERE id=$1`, pin); err != nil {
+		t.Fatal(err)
+	}
+	recovery := &Handler{DB: tx}
+	for i := 0; i < 2; i++ {
+		if err := recovery.RecoverWorkbench(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var status, progress, failure string
+	if err := tx.QueryRow(context.Background(), `SELECT status,progress,error FROM workbench_message WHERE id=$1`, running).Scan(&status, &progress, &failure); err != nil {
+		t.Fatal(err)
+	}
+	if status != "interrupted" || progress != "" || failure == "" {
+		t.Fatalf("unfinished request not recoverable: %s %s %s", status, progress, failure)
+	}
+	var raw []byte
+	if err := tx.QueryRow(context.Background(), `SELECT status,result FROM workbench_message WHERE id=$1`, complete).Scan(&status, &raw); err != nil {
+		t.Fatal(err)
+	}
+	if status != "completed" || benchDecodeResult(raw).View.Title != "last complete answer" {
+		t.Fatal("completed history changed")
+	}
+	var cleared bool
+	if err := tx.QueryRow(context.Background(), `SELECT status,result,refresh_id IS NULL FROM saved_view WHERE id=$1`, pin).Scan(&status, &raw, &cleared); err != nil {
+		t.Fatal(err)
+	}
+	if status != "failed" || !cleared || benchDecodeResult(raw).View.Title != "last complete answer" {
+		t.Fatal("pin lost its last successful snapshot")
+	}
+}
