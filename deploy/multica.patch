@@ -0,0 +1,24 @@
+package cli
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestDesktopConfigHomeDoesNotRedirectProviderHome(t *testing.T) {
+	native, collaboration := t.TempDir(), t.TempDir()
+	t.Setenv("HOME", native)
+	t.Setenv("MULTICA_CONFIG_HOME", collaboration)
+	t.Setenv(TaskConfigRootEnv, "")
+	got, err := ProfileDir("client-a")
+	if err != nil || got != filepath.Join(collaboration, ".multica", "profiles", "client-a") {
+		t.Fatalf("%q %v", got, err)
+	}
+	// Managed child credentials still take precedence over desktop state.
+	task := t.TempDir()
+	t.Setenv(TaskConfigRootEnv, task)
+	got, err = ProfileDir("client-a")
+	if err != nil || got != filepath.Join(task, "profiles", "client-a") {
+		t.Fatalf("%q %v", got, err)
+	}
+}
