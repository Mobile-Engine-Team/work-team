+func TestMWIndividualAndSquadMentionsCarryExactScope(t *testing.T) {
+	useMWCommentPolicy(t)
+	runtimeID := dbfx.Runtime(t, "MW scope runtime")
+	leader := dbfx.Agent(t, "MW shared leader", runtimeID)
+	squadA := dbfx.Squad(t, "MW squad A", leader)
+	squadB := dbfx.Squad(t, "MW squad B", leader)
+	for _, target := range []struct{ kind, id string }{{"agent", leader}, {"squad", squadA}, {"squad", squadB}} {
+		t.Run(target.kind+target.id, func(t *testing.T) {
+			issueID := dbfx.Issue(t, "MW scope", testutil.Cols{"assignee_type": "squad", "assignee_id": squadA})
+			body := map[string]any{"content": fmt.Sprintf("[@target](mention://%s/%s) 请处理", target.kind, target.id)}
+			req := withURLParam(newRequest(http.MethodPost, "/api/issues/"+issueID+"/comments", body), "id", issueID)
+			testutil.Call(t, testHandler.CreateComment, req).Want(http.StatusCreated)
+			tasks, err := testHandler.Queries.ListTasksByIssue(context.Background(), parseUUID(issueID))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(tasks) != 1 {
+				t.Fatalf("got %d tasks", len(tasks))
+			}
+			task := tasks[0]
+			if uuidToString(task.AgentID) != leader {
+				t.Fatal("wrong executing agent")
+			}
+			if target.kind == "agent" {
+				if task.IsLeaderTask || task.SquadID.Valid {
+					t.Fatal("individual request became squad invocation")
+				}
+				dbfx.Exec(t, "UPDATE agent_task_queue SET status='running' WHERE id=$1", uuidToString(task.ID))
+				reply := withURLParam(newRequest(http.MethodPost, "/api/issues/"+issueID+"/comments", map[string]any{"content": "individual done", "parent_id": uuidToString(task.TriggerCommentID)}), "id", issueID)
+				reply.Header.Set("X-Agent-ID", leader)
+				reply.Header.Set("X-Task-ID", uuidToString(task.ID))
+				testutil.Call(t, testHandler.CreateComment, reply).Want(http.StatusCreated)
+				if n := dbfx.Count(t, "SELECT count(*) FROM agent_task_queue WHERE issue_id=$1", issueID); n != 1 {
+					t.Fatalf("individual result started squad: %d tasks", n)
+				}
+			} else if !task.IsLeaderTask || uuidToString(task.SquadID) != target.id {
+				t.Fatal("wrong squad context for shared leader")
+			}
+			issue, err := testHandler.Queries.GetIssue(context.Background(), parseUUID(issueID))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if uuidToString(issue.AssigneeID) != squadA || issue.AssigneeType.String != "squad" {
+				t.Fatal("mention changed issue owner")
+			}
+		})
+	}
