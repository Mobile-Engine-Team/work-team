+// ResolveIssueLabelNames finds or creates issue labels within the caller's transaction.
+func ResolveIssueLabelNames(ctx context.Context, tx pgx.Tx, workspace pgtype.UUID, names []string) ([]pgtype.UUID, error) {
+	ids := make([]pgtype.UUID, 0, len(names))
