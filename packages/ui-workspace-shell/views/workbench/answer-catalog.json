  "$defs": {
    "DynamicString": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 6000
        },
        {
          "type": "object",
          "properties": {
            "@path": {
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "@path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DynamicStringList": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 30
        },
        {
          "type": "object",
          "properties": {
            "@path": {
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "@path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DynamicValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "array",
            "null"
          ]
        },
        {
          "type": "object",
          "properties": {
            "@path": {
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "@path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ChildList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "maxItems": 80
    }
  }
}
