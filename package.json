{
  "name": "dsh-team-workbench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check:types": "tsc --noEmit --strict --module esnext --moduleResolution bundler --target ES2022 tests/contracts.types.ts && node scripts/check-renderer-types.mjs",
    "test:v3:service": "node tests/v3/service.mjs",
    "test:v3:desktop": "node tests/v3/browser.mjs"
  },
  "devDependencies": {
    "@team-workbench/ui-workspace-shell": "workspace:*",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "typescript": "5.9.3"
  }
}
